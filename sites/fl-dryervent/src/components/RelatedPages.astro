---
/**
 * "Related pages" block closing the city, service, region and article pages.
 *
 * The site is new (Search Console from 21 October 2026), so the lists follow
 * where Google already shows it: the Palm Beach and Broward city pages
 * carrying the most impressions (Deerfield Beach, Boca Raton, Lake Worth
 * Beach, Delray Beach, Fort Lauderdale) and the Spanish cities with the
 * densest Hispanic population, which is where Spanish converted on the
 * sister air duct site. Internal links decide which of 37 city pages Google
 * treats as the strong ones; this points them at the pages most likely to
 * produce a call.
 *
 * Hand picked. Revisit when the converting pages show up in GA4.
 */
import { getCity } from '../data/cities';
import { services } from '../data/services';
import { serviceEsContent } from '../data/services.es';

interface Props {
  lang?: 'en' | 'es';
  current?: string;
}
const { lang = 'en', current = Astro.url.pathname } = Astro.props;
const es = lang === 'es';

const AREAS_EN = ['deerfield-beach', 'boca-raton', 'lake-worth-beach', 'delray-beach', 'fort-lauderdale', 'miami', 'west-palm-beach', 'tampa', 'wellington', 'sunrise', 'naples', 'orlando'];
const AREAS_ES = ['hialeah', 'miami', 'kendall', 'doral', 'cape-coral', 'tampa', 'orlando', 'miami-gardens', 'homestead', 'pembroke-pines'];
const SERVICES = ['dryer-vent-cleaning', 'dryer-vent-repair', 'dryer-vent-installation', 'roof-dryer-vent-cleaning', 'condo-and-apartment-dryer-vents', 'dryer-vent-inspection'];
const GUIDES_EN = [
  { slug: 'dryer-vent-cleaning-cost-florida', title: 'What dryer vent cleaning costs in Florida' },
  { slug: 'signs-of-a-clogged-dryer-vent', title: 'Signs of a clogged dryer vent' },
  { slug: 'dryer-vent-fire-risk', title: 'Dryer vent fire risk' },
  { slug: 'how-often-clean-dryer-vent', title: 'How often to clean a dryer vent' },
];
const GUIDES_ES = [
  { slug: 'costo-limpieza-ventila-secadora-florida', title: 'Cuánto cuesta limpiar la ventila de la secadora en Florida' },
  { slug: 'senales-ventila-secadora-tapada', title: 'Señales de una ventila de secadora tapada' },
  { slug: 'incendios-por-secadora', title: 'Incendios por secadora' },
  { slug: 'cada-cuanto-limpiar-ventila-secadora', title: 'Cada cuánto limpiar la ventila de la secadora' },
];

const norm = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const here = norm(current);

const areas = (es ? AREAS_ES : AREAS_EN)
  .map((slug) => getCity(slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .map((c) => ({
    href: es ? `/es/areas-de-servicio/${c.slug}/` : `/service-areas/${c.slug}/`,
    label: es ? `Limpieza de ventila de secadora en ${c.name}` : `Dryer vent cleaning in ${c.name}`,
  }))
  .filter((l) => l.href !== here);

const serviceLinks = SERVICES
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s))
  .map((s) => ({
    href: es ? `/es/servicios/${s.slug}/` : `/services/${s.slug}/`,
    label: es ? serviceEsContent[s.slug]?.name ?? s.name : s.name,
  }))
  .filter((l) => l.href !== here);

const guides = (es ? GUIDES_ES : GUIDES_EN)
  .map((g) => ({ href: es ? `/es/blog/${g.slug}/` : `/blog/${g.slug}/`, label: g.title }))
  .filter((l) => l.href !== here);

const t = es
  ? { heading: 'Páginas relacionadas', areas: 'Áreas de servicio', services: 'Servicios', guides: 'Precios y guías' }
  : { heading: 'Related pages', areas: 'Service areas', services: 'Services', guides: 'Prices and guides' };
---
<section class="related-pages" aria-labelledby="related-pages-h">
  <div class="container">
    <h2 id="related-pages-h">{t.heading}</h2>
    <div class="rp-grid">
      <div>
        <h3>{t.services}</h3>
        <ul>{serviceLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h3>{t.areas}</h3>
        <ul>{areas.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h3>{t.guides}</h3>
        <ul>{guides.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .related-pages { padding: 2.5rem 0; border-top: 1px solid var(--c-border, #e5e7eb); }
  .related-pages h2 { margin-bottom: 1.2rem; }
  .rp-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .rp-grid h3 { font-size: 1rem; margin-bottom: 0.6rem; }
  .rp-grid ul { list-style: none; padding: 0; margin: 0; }
  .rp-grid li { padding: 0.4rem 0; border-bottom: 1px solid var(--c-border, #e5e7eb); font-size: 0.95rem; line-height: 1.4; }
  .rp-grid li:last-child { border-bottom: 0; }
</style>
