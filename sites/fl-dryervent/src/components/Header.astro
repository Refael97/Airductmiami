---
import { business } from '../data/business';
import { services } from '../data/services';
import { ui, serviceHref, type Locale } from '../data/ui';

interface Props {
  lang?: Locale;
  /** URL of the same page in the other language (for the switcher). */
  switchHref?: string;
  /**
   * Campaign landing pages: brand and phone number only. Every nav link is
   * a door somebody leaves through without calling, and paid traffic is the
   * traffic that can least afford them.
   */
  minimal?: boolean;
}
const { lang = 'en', switchHref, minimal = false } = Astro.props;
const t = ui[lang];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === t.home ? path === t.home : path.startsWith(href);

const topServices = services.slice(0, 6);
const defaultSwitch = lang === 'es' ? '/' : '/es/';
---
<header class="site-header">
  <div class="container header-inner">
    <a href={t.home} class="brand" aria-label={business.name}>
      <img class="brand-mark" src="/logo.svg" alt="" width="44" height="44" />
      <span class="brand-word">
        <span class="bw-top">dryer <em>vent</em></span>
        <span class="bw-sub">Florida</span>
      </span>
    </a>

    {!minimal && (
    <>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        <li class="has-dropdown">
          <a href={t.services} class={isActive(t.services) ? 'active' : ''}>{t.nav[0].label} <svg class="chev" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></a>
          <ul class="dropdown">
            {topServices.map((s) => (
              <li><a href={serviceHref(lang, s.slug)}>{s.shortName}</a></li>
            ))}
            <li><a href={t.services} class="dropdown-all">{t.allServices} →</a></li>
          </ul>
        </li>
        <li><a href={t.serviceAreas} class={isActive(t.serviceAreas) ? 'active' : ''}>{t.nav[1].label}</a></li>
        <li><a href={t.blog} class={isActive(t.blog) ? 'active' : ''}>{t.nav[2].label}</a></li>
        <li><a href={t.about} class={isActive(t.about) ? 'active' : ''}>{t.nav[3].label}</a></li>
        <li><a href={t.faq} class={isActive(t.faq) ? 'active' : ''}>{t.nav[4].label}</a></li>
        <li><a href={t.contact} class={isActive(t.contact) ? 'active' : ''}>{t.nav[5].label}</a></li>
        <li class="lang-switch"><a href={switchHref ?? defaultSwitch} hreflang={lang === 'es' ? 'en' : 'es'} rel="alternate">{t.langSwitch}</a></li>
      </ul>
    </nav>
    </>
    )}

    <div class="header-actions">
      <a href={`tel:${business.phoneHref}`} class="hdr-phone" aria-label={business.phone}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
        <span class="hdr-phone-num">{business.phone}</span>
      </a>
      {!minimal && (
        <a href={t.contact} class="hdr-quote btn btn-accent" data-open-booking><span class="q-long">{t.quoteLabel}</span><span class="q-short">{lang === 'es' ? 'Cotizar' : 'Free quote'}</span>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      )}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.2rem;
    min-height: 76px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
    color: var(--c-ink);
    text-decoration: none;
  }
  .brand:hover { text-decoration: none; }
  .brand-mark { width: 44px; height: 44px; display: block; }
  .brand-word { display: flex; flex-direction: column; line-height: 0.95; }
  .bw-top {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.62rem;
    letter-spacing: -0.035em;
    color: var(--c-navy);
  }
  .bw-top em { font-style: normal; color: var(--c-orange); }
  .bw-sub {
    font-family: var(--font-head);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.62em;
    text-transform: uppercase;
    color: var(--c-navy);
    margin-top: 0.22rem;
    padding-left: 0.2rem;
  }
  .site-nav { margin-left: auto; }
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav li { margin: 0; }
  .site-nav a {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.65rem;
    color: var(--c-ink);
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 8px;
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a.active { color: var(--c-orange); }
  .chev { opacity: 0.7; }
  .lang-switch a { color: var(--c-muted); font-weight: 700; }

  .has-dropdown { position: relative; }
  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    display: block;
    min-width: 250px;
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 0.4rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown li { width: 100%; }
  .dropdown a { font-size: 0.9rem; }
  .dropdown a:hover { background: var(--c-bg-alt); }
  .dropdown-all { color: var(--c-orange) !important; font-weight: 700; }

  .header-actions { display: flex; align-items: center; gap: 0.6rem; }
  .hdr-phone {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.62rem 1.05rem;
    border: 1.5px solid #d6dce4; border-radius: 999px;
    color: var(--c-ink); font-family: var(--font-head); font-weight: 700; font-size: 0.92rem;
    white-space: nowrap; text-decoration: none;
  }
  .hdr-phone svg { color: var(--c-orange); }
  .hdr-phone:hover { border-color: var(--c-ink); text-decoration: none; }
  .hdr-quote { white-space: nowrap; font-size: 0.92rem; padding: 0.72rem 1.25rem; }
  .q-short { display: none; }

  .nav-toggle, .nav-toggle-label { display: none; }

  @media (max-width: 1180px) {
    .lang-switch { display: none; }
  }
  @media (max-width: 1080px) {
    .header-inner { min-height: 62px; gap: 0.4rem 0.6rem; }
    .brand { margin-right: auto; }
    .brand-mark { width: 36px; height: 36px; }
    .bw-top { font-size: 1.32rem; }
    .bw-sub { font-size: 0.5rem; }
    .hdr-quote { padding: 0.55rem 0.85rem; font-size: 0.82rem; box-shadow: none; }
    .hdr-quote svg { display: none; }
    .q-long { display: none; }
    .q-short { display: inline; }
    .hdr-phone { padding: 0; width: 42px; height: 42px; justify-content: center; }
    .hdr-phone-num { display: none; }
    .lang-switch { display: block; }
    .nav-toggle-label {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 44px; height: 44px;
      cursor: pointer;
      order: 3;
    }
    .nav-toggle-label span {
      display: block; height: 2.5px; width: 24px;
      background: var(--c-ink); border-radius: 2px;
    }
    .header-actions { order: 2; }
    .site-nav {
      order: 4;
      flex-basis: 100%;
      margin-left: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }
    .nav-toggle:checked ~ .site-nav { max-height: 720px; }
    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: 0.8rem;
    }
    .site-nav a {
      padding: 0.75rem 0.4rem;
      font-size: 1rem;
      border-bottom: 1px solid var(--c-line);
      border-radius: 0;
    }
    .chev { display: none; }
    .dropdown {
      position: static; opacity: 1; visibility: visible; transform: none;
      box-shadow: none; border: none; padding: 0 0 0 1rem; min-width: 0;
    }
    .dropdown a { font-size: 0.92rem; color: var(--c-muted); }
    .lang-switch a { border-bottom: none; }
  }
  @media (max-width: 420px) {
    .header-inner { gap: 0.4rem 0.35rem; }
    .brand { gap: 0.4rem; }
    .brand-mark { width: 32px; height: 32px; }
    .bw-top { font-size: 1.15rem; }
    .bw-sub { font-size: 0.44rem; letter-spacing: 0.55em; }
    .hdr-phone { width: 38px; height: 38px; }
    .hdr-quote { padding: 0.5rem 0.75rem; font-size: 0.8rem; }
    .header-actions { gap: 0.35rem; }
    .nav-toggle-label { width: 36px; }
  }
</style>
