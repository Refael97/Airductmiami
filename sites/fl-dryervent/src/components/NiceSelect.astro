---
/**
 * Replaces the browser's own dropdown with one that opens under the field,
 * in the site's style. The operating system menu (a floating panel in the
 * middle of the screen on a Mac) reads as broken next to the rest of the
 * form.
 *
 * The real <select> stays in the form, hidden, and is what gets submitted
 * and validated. This only draws a button and a list on top of it and keeps
 * the two in sync, so Netlify Forms, the booking steps and every script
 * that reads `select.value` keep working unchanged. Without JavaScript the
 * native select is simply shown.
 *
 * Mark a select with `data-native` to leave it alone.
 */
---
<script is:inline>
  (function () {
    var uid = 0;
    var openOne = null;

    function enhance(sel) {
      if (sel.dataset.nice || sel.hasAttribute('data-native') || sel.multiple) return;
      sel.dataset.nice = '1';
      var id = 'ns' + (++uid);

      var wrap = document.createElement('div');
      wrap.className = 'ns';
      sel.parentNode.insertBefore(wrap, sel);
      wrap.appendChild(sel);
      sel.classList.add('ns-native');
      sel.tabIndex = -1;
      sel.setAttribute('aria-hidden', 'true');

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ns-btn';
      btn.setAttribute('aria-haspopup', 'listbox');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-controls', id + '-list');
      var label = sel.id ? document.querySelector('label[for="' + sel.id + '"]') : sel.closest('label');
      if (label) {
        if (!label.id) label.id = id + '-lbl';
        btn.setAttribute('aria-labelledby', label.id + ' ' + id + '-val');
      }
      var val = document.createElement('span');
      val.className = 'ns-val';
      val.id = id + '-val';
      btn.appendChild(val);
      btn.insertAdjacentHTML('beforeend',
        '<svg class="ns-chev" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>');
      wrap.appendChild(btn);

      var list = document.createElement('ul');
      list.className = 'ns-list';
      list.id = id + '-list';
      list.setAttribute('role', 'listbox');
      list.hidden = true;
      wrap.appendChild(list);

      var active = -1;

      function items() { return [].slice.call(list.children); }

      function build() {
        list.textContent = '';
        [].slice.call(sel.options).forEach(function (o, i) {
          var li = document.createElement('li');
          li.setAttribute('role', 'option');
          li.id = id + '-o' + i;
          li.dataset.index = String(i);
          li.textContent = o.textContent;
          if (o.disabled) li.setAttribute('aria-disabled', 'true');
          list.appendChild(li);
        });
      }

      function sync() {
        var o = sel.options[sel.selectedIndex];
        val.textContent = o ? o.textContent : '';
        btn.classList.toggle('is-placeholder', !o || o.value === '');
        items().forEach(function (li, i) {
          li.setAttribute('aria-selected', i === sel.selectedIndex ? 'true' : 'false');
        });
      }

      function setActive(i) {
        var all = items();
        if (!all.length) return;
        active = Math.max(0, Math.min(all.length - 1, i));
        all.forEach(function (li, j) { li.classList.toggle('is-active', j === active); });
        btn.setAttribute('aria-activedescendant', all[active].id);
        var li = all[active];
        if (li.offsetTop < list.scrollTop) list.scrollTop = li.offsetTop;
        else if (li.offsetTop + li.offsetHeight > list.scrollTop + list.clientHeight) {
          list.scrollTop = li.offsetTop + li.offsetHeight - list.clientHeight;
        }
      }

      function open() {
        if (openOne && openOne !== close) openOne();
        build();
        sync();
        list.hidden = false;
        wrap.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        /* Open upwards when there is no room below, as a person would
           expect from a menu at the bottom of the screen. */
        var r = btn.getBoundingClientRect();
        var below = window.innerHeight - r.bottom;
        wrap.classList.toggle('is-up', below < Math.min(list.scrollHeight, 280) + 16 && r.top > below);
        setActive(sel.selectedIndex < 0 ? 0 : sel.selectedIndex);
        openOne = close;
      }

      function close() {
        list.hidden = true;
        wrap.classList.remove('is-open', 'is-up');
        btn.setAttribute('aria-expanded', 'false');
        btn.removeAttribute('aria-activedescendant');
        if (openOne === close) openOne = null;
      }

      function choose(i) {
        var o = sel.options[i];
        if (!o || o.disabled) return;
        sel.selectedIndex = i;
        sel.dispatchEvent(new Event('input', { bubbles: true }));
        sel.dispatchEvent(new Event('change', { bubbles: true }));
        sync();
        close();
        btn.focus();
      }

      btn.addEventListener('click', function () {
        if (list.hidden) open(); else close();
      });

      list.addEventListener('mousedown', function (e) { e.preventDefault(); });
      list.addEventListener('click', function (e) {
        var li = e.target.closest('[role="option"]');
        if (li) choose(+li.dataset.index);
      });
      list.addEventListener('mousemove', function (e) {
        var li = e.target.closest('[role="option"]');
        if (li && +li.dataset.index !== active) setActive(+li.dataset.index);
      });

      var typed = '', typedAt = 0;
      btn.addEventListener('keydown', function (e) {
        var k = e.key;
        if (list.hidden) {
          if (k === 'ArrowDown' || k === 'ArrowUp' || k === 'Enter' || k === ' ') { e.preventDefault(); open(); }
          return;
        }
        if (k === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
        else if (k === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
        else if (k === 'Home') { e.preventDefault(); setActive(0); }
        else if (k === 'End') { e.preventDefault(); setActive(items().length - 1); }
        else if (k === 'Enter' || k === ' ') { e.preventDefault(); choose(active); }
        else if (k === 'Escape') { e.preventDefault(); e.stopPropagation(); close(); }
        else if (k === 'Tab') { close(); }
        else if (k.length === 1) {
          var now = Date.now();
          typed = now - typedAt > 700 ? k.toLowerCase() : typed + k.toLowerCase();
          typedAt = now;
          var hit = items().findIndex(function (li) { return li.textContent.toLowerCase().indexOf(typed) === 0; });
          if (hit >= 0) setActive(hit);
        }
      });

      /* A click on the field's label, or validation focusing the hidden
         select, lands on the visible button instead. */
      sel.addEventListener('focus', function () { btn.focus(); });
      sel.addEventListener('change', sync);
      sel.form && sel.form.addEventListener('reset', function () { setTimeout(sync, 0); });

      build();
      sync();
    }

    document.addEventListener('click', function (e) {
      if (openOne && !e.target.closest('.ns.is-open')) openOne();
    });

    function run() {
      [].slice.call(document.querySelectorAll('form select')).forEach(enhance);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script>

<style is:global>
  .ns { position: relative; }
  .ns-native {
    position: absolute !important; width: 1px !important; height: 1px !important;
    padding: 0 !important; margin: -1px !important; overflow: hidden !important;
    clip: rect(0 0 0 0) !important; border: 0 !important; opacity: 0;
  }
  .ns-btn {
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
    width: 100%; text-align: left; cursor: pointer;
    font: inherit; font-size: 0.95rem; color: var(--c-ink);
    padding: 0.7rem 0.85rem; background: #fff;
    border: 1.5px solid var(--c-line); border-radius: 10px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .ns-btn:hover { border-color: #c8cfd8; }
  .ns-btn:focus-visible, .ns.is-open .ns-btn { outline: none; border-color: var(--c-orange); box-shadow: var(--ring); }
  .ns-btn.is-placeholder .ns-val { color: var(--c-muted); }
  .ns-val { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ns-chev { flex: 0 0 auto; color: var(--c-muted); transition: transform 0.18s ease; }
  .ns.is-open .ns-chev { transform: rotate(180deg); color: var(--c-orange); }

  .ns-list {
    position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 60;
    list-style: none; margin: 0; padding: 0.35rem;
    max-height: 280px; overflow-y: auto;
    background: #fff; border: 1px solid var(--c-line); border-radius: 12px;
    box-shadow: 0 18px 40px rgba(15, 35, 64, 0.16);
    animation: ns-in 0.14s ease-out;
  }
  .ns.is-up .ns-list { top: auto; bottom: calc(100% + 6px); }
  @keyframes ns-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .ns-list[hidden] { display: none; }
  .ns-list li {
    position: relative; margin: 0; cursor: pointer;
    padding: 0.6rem 2.2rem 0.6rem 0.75rem; border-radius: 8px;
    font-size: 0.93rem; font-weight: 500; color: var(--c-ink); line-height: 1.35;
  }
  .ns-list li.is-active { background: #fff1e8; }
  .ns-list li[aria-selected='true'] { font-weight: 700; color: var(--c-navy); }
  .ns-list li[aria-selected='true']::after {
    content: ''; position: absolute; right: 0.8rem; top: 50%; width: 0.38rem; height: 0.7rem;
    border: solid var(--c-orange); border-width: 0 2.4px 2.4px 0;
    transform: translateY(-62%) rotate(45deg);
  }
  .ns-list li[aria-disabled='true'] { opacity: 0.45; cursor: default; }
</style>
