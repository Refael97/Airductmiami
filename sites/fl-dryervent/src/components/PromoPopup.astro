---
/**
 * Site-wide popup, once per browser session. Opens on engagement, 45% scroll
 * or 25 seconds, never on load. Submits to a Netlify form over fetch and
 * shows an inline confirmation. One panel for the one trade, offering the
 * price for the visitor's own vent rather than a discount.
 */
import { business } from '../data/business';
import LeadMeta from './LeadMeta.astro';
import type { Locale } from '../data/ui';

interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';

const path = Astro.url.pathname;

/* One trade, one panel. No discount: the network does not discount dryer
   vents, and a "limited time" price on a $100 job reads like the bait ads
   the articles warn about. The panel offers the thing people actually want,
   the price for their own vent. */
const offerKey = 'dryer' as const;

const ALL_OFFERS = {
  dryer: {
    en: {
      headline1: 'Get the price for',
      headline2: 'your dryer vent',
      headline3: '',
      badgeTop: 'Dryer vent cleaning',
      price: '$100 to $200',
      badgeBottom: 'Price given before we book',
      sub: 'Leave your number and ZIP. We call back with the price for your run.',
      body: 'A slow dryer is usually a restricted vent, a crushed hose or a blocked hood. We clean the whole run, measure airflow at the hood before and after, and tell you plainly if it needs repair instead.',
      cta: 'Call me with a price',
      fine: 'No obligation. Repair or a new run is $200 to $600, also quoted before booking.',
      successBody: `Thank you. We will call you shortly with the price for your dryer vent. In a hurry? Call ${business.phone}.`,
    },
    es: {
      headline1: 'Reciba el precio de',
      headline2: 'su ventila',
      headline3: '',
      badgeTop: 'Limpieza de ventila',
      price: '$100 a $200',
      badgeBottom: 'Precio antes de agendar',
      sub: 'Déjenos su teléfono y código postal. Le llamamos con el precio de su ventila.',
      body: 'Una secadora lenta casi siempre es una ventila tapada, una manguera aplastada o una salida bloqueada. Limpiamos todo el tramo, medimos el flujo en la salida antes y después, y le decimos claramente si necesita reparación.',
      cta: 'Llámenme con el precio',
      fine: 'Sin compromiso. Reparación o tramo nuevo $200 a $600, también cotizado antes de agendar.',
      successBody: `Gracias. Le llamaremos en breve con el precio de su ventila. ¿Tiene prisa? Llame al ${business.phone}.`,
    },
  },
};

const OFFERS = ALL_OFFERS[offerKey][lang];

/* The panel's promise in words, for the lead email. */
const offerLabel = (key: keyof typeof ALL_OFFERS) => {
  const o = ALL_OFFERS[key][lang];
  return `${o.price} ${o.badgeBottom.toLowerCase()}`;
};
const offerLabels = Object.fromEntries(
  (Object.keys(ALL_OFFERS) as (keyof typeof ALL_OFFERS)[]).map((k) => [k, offerLabel(k)]),
);

const SHARED = {
  en: {
    trust: ['Price before booking', 'Same week service', 'Insured', 'Airflow measured'],
    name: 'Your name',
    phone: 'Phone number',
    zip: 'ZIP code',
    close: 'Close',
    successTitle: 'You got it!',
  },
  es: {
    trust: ['Precio antes de agendar', 'Servicio la misma semana', 'Asegurados', 'Flujo medido'],
    name: 'Su nombre',
    phone: 'Teléfono',
    zip: 'Código postal',
    close: 'Cerrar',
    successTitle: '¡Listo!',
  },
}[lang];

const OFFER = { ...SHARED, ...OFFERS };

// Skip pages where a popup would compete with the page's own goal.
const excluded = ['/contact', '/es/contacto', '/thank-you', '/es/gracias', '/privacy', '/es/privacidad']
  .some((p) => path.startsWith(p));

const formName = 'popup-special';

/* Desktop only side image. Renders only when the file is in public/images,
   so a missing file degrades to the gradient panel the popup shipped with
   rather than to a broken image on top of the lead form. */
const asideSrc: string | null = '/images/technician-cleaning-wall-vent-800.webp';
---
{!excluded && (
<div class="promo-overlay" id="promo-overlay" role="dialog" aria-modal="true" aria-labelledby="promo-title" hidden>
  <div class="promo-card" id="promo-card">
    <div class="promo-visual" aria-hidden="true">
      {asideSrc && <img class="promo-aside" src={asideSrc} alt="" width="800" height="531" loading="lazy" decoding="async" />}
      <div class="promo-badge">
        <span class="badge-top">{OFFER.badgeTop}</span>
        <span class="badge-price">{OFFER.price}</span>
        <span class="badge-bottom">{OFFER.badgeBottom}</span>
      </div>
    </div>

    <div class="promo-content" id="promo-content">
      <button type="button" class="promo-close" id="promo-close" aria-label={OFFER.close}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>

      <div class="promo-brand">
        <img src="/logo.svg" alt="" width="34" height="34" loading="lazy" />
        <span class="promo-brand-word"><span>dryer <em>vent</em></span><small>Florida</small></span>
      </div>

      <h2 class="promo-headline" id="promo-title">
        {OFFER.headline1}{' '}<span class="hl">{OFFER.headline2}</span>{OFFER.headline3 ? ' ' + OFFER.headline3 : ''}
      </h2>
      <p class="promo-sub">{OFFER.sub}</p>
      <p class="promo-price-inline"><strong>{OFFER.price}</strong> {OFFER.badgeTop.toLowerCase()}</p>

      <ul class="promo-trust">
        {OFFER.trust.map((t) => <li><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.2 4.2L19 7"/></svg><span>{t}</span></li>)}
      </ul>

      <form class="promo-form" id="promo-form" name={formName} method="POST" data-netlify="true" netlify-honeypot="bot-field" data-offer-labels={JSON.stringify(offerLabels)}>
        <input type="hidden" name="form-name" value={formName} />
        <LeadMeta lang={lang} source="popup" />
        <input type="hidden" name="offer" value={offerKey} />
        {/* The offer in words, and how the popup was opened. "source: popup"
            was true and useless: it could not tell a popup the reader
            triggered by scrolling from one the chat assistant handed over
            after a conversation, and it never said what discount had been
            promised. Both are set by script, because the chat can change the
            offer and the trigger after this markup is rendered. */}
        <input type="hidden" name="offer_text" value={offerLabels[offerKey]} />
        <input type="hidden" name="lead_origin" value="" />
        {/* Filled by script from the ZIP the visitor types, never asked for.
            Present in the markup because Netlify Forms builds its field list
            from the static HTML: a field injected at runtime is dropped. */}
        <input type="hidden" name="zip_city" value="" />
        <input type="hidden" name="zip_county" value="" />
        {/* What the visitor told the chat assistant before it handed them
            here, so whoever calls back is not starting from nothing. Empty
            on every lead that did not come through the chat. */}
        <input type="hidden" name="chat_note" value="" />
        <p class="visually-hidden" aria-hidden="true">
          <label>Do not fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <label class="promo-field">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="8.2" r="3.6"/><path d="M5 20c1.3-3.2 3.7-4.8 7-4.8s5.7 1.6 7 4.8"/></svg>
          <input type="text" name="name" placeholder={OFFER.name} required autocomplete="name" />
        </label>
        <label class="promo-field">
          <svg viewBox="0 0 24 24"><path d="M6 3h4l1.5 4.5L9 9.5c1 2.5 3 4.5 5.5 5.5l2-2.5L21 14v4a2 2 0 0 1-2 2C10.7 19.4 4.6 13.3 4 5a2 2 0 0 1 2-2Z"/></svg>
          <input type="tel" name="phone" placeholder={OFFER.phone} required autocomplete="tel" inputmode="tel" />
        </label>
        <label class="promo-field">
          <svg viewBox="0 0 24 24"><path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
          <input type="text" name="zip" placeholder={OFFER.zip} required autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}" />
        </label>
        <button type="submit" class="promo-cta">
          {OFFER.cta}
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
        </button>
        <p class="promo-fine">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
          {OFFER.fine}
        </p>
      </form>

      <div class="promo-success" id="promo-success" hidden>
        <svg viewBox="0 0 24 24" width="52" height="52" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5"/><path d="M8 12.5l2.8 2.8L16.5 9"/></svg>
        <h3>{OFFER.successTitle}</h3>
        <p>{OFFER.successBody}</p>
      </div>
    </div>
  </div>
</div>
)}

<style>
  .promo-overlay {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; align-items: center; justify-content: center;
    padding: 1rem;
    background: rgba(10, 26, 48, 0.62);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .promo-overlay[hidden] { display: none; }

  .promo-card {
    position: relative;
    display: grid; grid-template-columns: 340px minmax(0, 1fr);
    width: min(860px, 100%); max-height: calc(100vh - 2rem); max-height: calc(100dvh - 2rem);
    background: #fff; border-radius: 18px; overflow: hidden;
    box-shadow: 0 30px 80px rgba(10, 26, 48, 0.4);
    animation: promo-in 0.28s ease-out;
  }
  @keyframes promo-in { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }

  /* ---- photo side ---- */
  .promo-visual { position: relative; background: var(--c-navy); min-height: 100%; }
  .promo-aside { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 32% center; }
  .promo-visual::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,26,48,0) 45%, rgba(10,26,48,0.55) 100%); }
  .promo-badge {
    position: absolute; z-index: 1; left: 1.1rem; right: 1.1rem; bottom: 1.1rem;
    background: #fff; border-radius: 14px; padding: 0.85rem 1rem;
    display: flex; flex-direction: column; gap: 0.1rem;
    box-shadow: 0 14px 30px rgba(4, 20, 35, 0.35);
  }
  .badge-top { font-size: 0.66rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-orange); }
  .badge-price { font-family: var(--font-head); font-size: 1.85rem; font-weight: 800; line-height: 1.05; letter-spacing: -0.035em; color: var(--c-navy); }
  .badge-bottom { font-size: 0.76rem; font-weight: 600; color: var(--c-body); }
  .promo-card.is-done .promo-badge { display: none; }

  /* ---- form side ---- */
  .promo-content { position: relative; overflow-y: auto; padding: 1.6rem 1.8rem 1.5rem; -webkit-overflow-scrolling: touch; }
  .promo-close {
    position: absolute; top: 0.9rem; right: 0.9rem; z-index: 2;
    display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%;
    border: 1px solid var(--c-line); background: #fff; color: var(--c-body); cursor: pointer;
  }
  .promo-close:hover { color: var(--c-ink); border-color: #c8cfd8; }

  .promo-brand { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
  .promo-brand img { width: 34px; height: 34px; }
  .promo-brand-word { display: flex; flex-direction: column; line-height: 0.95; font-family: var(--font-head); font-weight: 800; font-size: 1.22rem; letter-spacing: -0.035em; color: var(--c-navy); }
  .promo-brand-word em { font-style: normal; color: var(--c-orange); }
  .promo-brand-word small { font-size: 0.46rem; font-weight: 700; letter-spacing: 0.6em; text-transform: uppercase; margin-top: 0.22rem; }

  .promo-headline {
    font-family: var(--font-head); font-weight: 800; color: var(--c-navy);
    font-size: clamp(1.45rem, 1.1rem + 1.2vw, 1.9rem); line-height: 1.1; letter-spacing: -0.035em;
    margin: 0 2rem 0.5rem 0;
  }
  .promo-headline .hl { color: var(--c-orange); }
  .promo-sub { font-size: 0.95rem; color: var(--c-body); margin: 0 0 0.9rem; line-height: 1.5; }
  .promo-price-inline { display: none; }
  .promo-body { display: none; }

  .promo-trust { list-style: none; padding: 0; margin: 0 0 1.1rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem 0.9rem; }
  .promo-trust li { display: flex; align-items: center; gap: 0.4rem; margin: 0; font-size: 0.82rem; font-weight: 600; color: var(--c-ink); }
  .promo-trust svg { flex: 0 0 auto; color: var(--c-orange); }

  .promo-form { display: grid; gap: 0.6rem; }
  .promo-field { position: relative; display: block; }
  .promo-field svg {
    position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%);
    width: 18px; height: 18px; fill: none; stroke: var(--c-muted); stroke-width: 1.8;
    stroke-linecap: round; stroke-linejoin: round; pointer-events: none;
  }
  .promo-field input {
    width: 100%; font: inherit; font-size: 0.98rem; color: var(--c-ink);
    padding: 0.78rem 0.9rem 0.78rem 2.6rem;
    border: 1.5px solid var(--c-line); border-radius: 10px; background: #fff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .promo-field input:focus { outline: none; border-color: var(--c-orange); box-shadow: var(--ring); }
  .promo-cta {
    margin-top: 0.3rem;
    display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    width: 100%; padding: 0.95rem 1rem; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--c-orange); color: #fff;
    font-family: var(--font-head); font-weight: 800; font-size: 1.02rem;
    box-shadow: 0 10px 24px rgba(242, 106, 33, 0.32);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .promo-cta:hover { background: var(--c-orange-dark); transform: translateY(-1px); }
  .promo-cta:disabled { opacity: 0.7; cursor: wait; transform: none; }
  .promo-fine { display: flex; align-items: flex-start; justify-content: center; gap: 0.35rem; text-align: center; font-size: 0.76rem; color: var(--c-muted); margin: 0.3rem 0 0; line-height: 1.45; }
  .promo-fine svg { flex: 0 0 auto; margin-top: 0.15rem; }

  .promo-success { text-align: center; padding: 2.5rem 0.5rem; color: var(--c-ink); }
  .promo-success svg { stroke: var(--c-orange); margin-bottom: 0.6rem; }
  .promo-success h3 { font-size: 1.4rem; margin: 0 0 0.5rem; }
  .promo-success p { color: var(--c-body); margin: 0; }

  /* Tablet and phone: one column, no photo. The price moves into the copy
     so the form and its button fit on one screen. */
  @media (max-width: 760px) {
    .promo-overlay { align-items: flex-end; padding: 0; }
    .promo-card {
      grid-template-columns: 1fr; width: 100%;
      max-height: 92vh; max-height: 92dvh;
      border-radius: 20px 20px 0 0;
      animation: promo-up 0.3s ease-out;
    }
    @keyframes promo-up { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
    .promo-visual { display: none; }
    .promo-content { padding: 1.3rem 1.2rem calc(1.2rem + env(safe-area-inset-bottom, 0px)); }
    .promo-brand { margin-bottom: 0.8rem; }
    .promo-headline { font-size: 1.5rem; }
    .promo-sub { margin-bottom: 0.6rem; font-size: 0.92rem; }
    .promo-price-inline {
      display: inline-flex; align-items: baseline; gap: 0.4rem;
      background: #fff1e8; color: var(--c-orange-dark); border-radius: 999px;
      padding: 0.3rem 0.8rem; font-size: 0.82rem; font-weight: 600; margin: 0 0 0.8rem;
    }
    .promo-price-inline strong { font-family: var(--font-head); font-size: 0.98rem; color: var(--c-navy); }
    .promo-trust { margin-bottom: 0.9rem; }
    .promo-trust li { font-size: 0.78rem; }
  }
  @media (max-height: 640px) and (min-width: 761px) {
    .promo-brand, .promo-trust { display: none; }
  }
</style>

<script>
  const overlay = document.getElementById('promo-overlay');
  if (overlay) {
    const KEY = 'fbPromoShown';
    const closeBtn = document.getElementById('promo-close');
    const form = document.getElementById('promo-form') as HTMLFormElement | null;
    const success = document.getElementById('promo-success');

    const track = (name: string, params?: Record<string, string>) => {
      try {
        (window as any).gtag?.('event', name, params);
      } catch {
        /* analytics blocked: ignore */
      }
    };

    const close = () => {
      overlay.hidden = true;
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      track('popup_close');
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') close();
    };

    const field = (name: string) =>
      form?.querySelector(`input[name="${name}"]`) as HTMLInputElement | null;
    const setField = (name: string, value: string) => {
      const el = field(name);
      if (el) el.value = value;
    };

    /* Read at the moment it is used, never cached. The chat assistant can
       change the offer after this script has run, and a copy taken at load
       would report the page's offer instead of the one the visitor was
       actually shown. */
    const offerNow = () => field('offer')?.value ?? '';

    /* Keeps the words next to the key. Whoever calls this lead back needs to
       know what was promised, and "duct" is not that. */
    const OFFER_LABELS: Record<string, string> = (() => {
      try {
        return JSON.parse(form?.dataset.offerLabels ?? '{}');
      } catch {
        return {};
      }
    })();

    /* How the popup was opened, written for a human reading an email at
       seven in the morning rather than for a dashboard. */
    const ORIGIN_LABEL: Record<string, string> = {
      auto: 'Popup, opened on its own',
      quote_bar: 'Popup, from the sticky quote bar',
      help_widget: 'Popup, from the chat widget button',
      help_chat: 'Popup, handed over by the chat assistant',
    };

    /* ZIP to city, so the lead that lands in the inbox reads "33019
       (Hollywood, Broward County)" rather than five digits nobody can place.
       The table is 41KB of JSON, so it is fetched when the popup opens rather
       than shipped with the page, which leaves it warm by the time anyone has
       finished typing a name and a phone number. Everything here degrades to
       "no city" and never to "no lead". */
    let zipTable: Promise<Record<string, string>> | null = null;
    const loadZips = () => {
      if (!zipTable) {
        zipTable = fetch('/data/fl-zip-cities.json')
          .then((r) => (r.ok ? r.json() : {}))
          .catch(() => ({}));
      }
      return zipTable;
    };

    const zipField = form?.querySelector('input[name="zip"]') as HTMLInputElement | null;
    const cityField = form?.querySelector('input[name="zip_city"]') as HTMLInputElement | null;
    const countyField = form?.querySelector('input[name="zip_county"]') as HTMLInputElement | null;

    const resolveZip = async () => {
      if (!zipField || !cityField || !countyField) return '';
      const zip = zipField.value.trim().slice(0, 5);
      if (!/^\d{5}$/.test(zip)) {
        cityField.value = '';
        countyField.value = '';
        return '';
      }
      const table = await loadZips();
      const hit = table[zip];
      /* Out of state, or a typo. Better blank than a guess. */
      const [city, county] = hit ? hit.split('|') : ['', ''];
      cityField.value = city;
      countyField.value = county ? `${county} County` : '';
      return city;
    };

    zipField?.addEventListener('input', () => {
      void resolveZip();
    });

    const showPopup = (trigger: string) => {
      if (!overlay.hidden) return;
      try {
        sessionStorage.setItem(KEY, '1');
      } catch {
        /* private mode: still show, just no once-per-session memory */
      }
      overlay.hidden = false;
      void loadZips();
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', onKey);
      (closeBtn as HTMLElement | null)?.focus();
      setField('lead_origin', ORIGIN_LABEL[trigger] ?? trigger);
      track('popup_view', { offer: offerNow(), trigger });
    };

    /* Explicit open from the sticky quote bar or the help widget: always
       allowed, even if the auto popup already fired or was closed this
       session. The help widget passes what its assistant worked out, so the
       visitor does not answer the same question twice. */
    window.addEventListener('fb:open-promo', (e) => {
      const d = (e as CustomEvent).detail || {};
      if (d.zip && zipField) {
        zipField.value = String(d.zip).slice(0, 5);
        void resolveZip();
      }
      if (d.note) {
        const n = form?.querySelector('input[name="chat_note"]') as HTMLInputElement | null;
        if (n) n.value = String(d.note).slice(0, 300);
      }
      if (d.offer) {
        const key = String(d.offer);
        setField('offer', key);
        /* The words have to follow the key, or the email promises a duct
           discount on a dryer lead. */
        if (OFFER_LABELS[key]) setField('offer_text', OFFER_LABELS[key]);
      }
      showPopup(d.trigger || 'quote_bar');
    });

    // Auto engagement trigger: open at 45% scroll depth or after 25 seconds
    // on the page, whichever comes first, once per session. An instant popup
    // interrupted readers before they saw a single line.
    try {
      if (!sessionStorage.getItem(KEY)) {
        let fired = false;
        const auto = () => {
          if (fired) return;
          fired = true;
          clearTimeout(timer);
          removeEventListener('scroll', onScroll);
          showPopup('auto');
        };
        const timer = setTimeout(auto, 25000);
        const onScroll = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          if (max <= 0 || scrollY / max >= 0.45) auto();
        };
        addEventListener('scroll', onScroll, { passive: true });
      }
    } catch {
      /* sessionStorage unavailable: skip the auto popup, bar still works */
    }

    closeBtn?.addEventListener('click', close);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      /* Minted before the send, not after, so a retry of this same
         submission reports the same lead to Google Ads rather than a
         second one. */
      const leadId = (window as any).fbNewLeadId?.();
      try {
        /* Someone who pastes a ZIP and hits send immediately can beat the
           fetch. Wait for it, but only briefly: a city in the email is worth
           a moment, and never worth the lead. */
        await Promise.race([resolveZip(), new Promise((r) => setTimeout(r, 1200))]);
        const data = new FormData(form);
        const body = new URLSearchParams(data as unknown as Record<string, string>).toString();
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        if (success) success.hidden = false;
        /* Strips the offer copy out of the card so the confirmation is the
           whole panel and lands where the visitor is already looking, and
           takes the discount badge off the technician's face with it. The
           state lives on the card because the badge is in .promo-visual,
           a sibling of the content, not inside it. */
        document.getElementById('promo-card')?.classList.add('is-done');
        /* Announced, not just drawn: at this point focus is still on a
           button inside a form that has just been removed from the page. */
        success?.setAttribute('tabindex', '-1');
        success?.focus();
        /* Long enough to read the confirmation and the phone number in it,
           short enough that nobody has to dismiss the page they were on. */
        setTimeout(close, 5000);
        /* Same parameter shape the contact form reports, so one GA report
           covers both and "which city" does not depend on which form. */
        track('generate_lead', {
          form_type: 'popup_special',
          offer: offerNow(),
          service: 'Dryer Vent Cleaning',
          lead_city: cityField?.value ?? '',
          source: 'popup',
          site_language: (form?.querySelector('input[name="locale"]') as HTMLInputElement | null)?.value ?? 'en',
          page_path: location.pathname,
        });
        /* The popup never reaches /thank-you/, so the conversion has to be
           reported here. This and the thank-you page are the only two
           places a lead is confirmed, and both now report it. */
        (window as any).fbLeadConversion?.(leadId);
      } catch {
        // Network hiccup: fall back to a normal POST so the lead is not lost.
        form.submit();
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
</script>
