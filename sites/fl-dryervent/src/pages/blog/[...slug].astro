---
import type { GetStaticPaths } from 'astro';
import { categoryPhoto } from '../../data/images';
import { getCollection, render } from 'astro:content';
import { esAltFor } from '../../data/blogPairs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import CTABand from '../../components/CTABand.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import { articleSchema } from '../../lib/schema';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = `${site}/blog/${post.id}`;

const schema: Record<string, unknown>[] = [
  articleSchema(site, {
    headline: d.title,
    description: d.description,
    url: pageUrl,
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  }),
];

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Related posts: same category, excluding current.
const related = (await getCollection('blog'))
  .filter((p) => p.data.category === d.category && p.id !== post.id)
  .slice(0, 3);

/* Google renders about 60 characters and appends the site name on its own,
   so a hard coded brand suffix on an already long headline only buys a
   truncation. Add it when it fits, drop it when it does not. */
const brandedTitle =
  d.title.length + 21 <= 60 ? `${d.title} | Dryer Vent Florida` : d.title;
---
<BaseLayout title={brandedTitle} description={d.description} schema={schema} ogType="article" altHref={esAltFor(post.id)}>
  <Breadcrumbs
    crumbs={[
      { name: 'Home', href: '/' },
      { name: 'Blog', href: '/blog/' },
      { name: d.title, href: `/blog/${post.id}/` },
    ]}
  />

  <article class="section">
    <div class="container container-narrow">
      <header class="post-header">
        <span class="pill">{d.category}</span>
        <h1>{d.title}</h1>
        <p class="post-byline">
          Published {fmt(d.pubDate)}
          {d.updatedDate && <> · Updated {fmt(d.updatedDate)}</>}
        </p>
      </header>
      <figure class="post-figure"><img src={categoryPhoto(d.category).src} srcset={`${categoryPhoto(d.category).small} 640w, ${categoryPhoto(d.category).src} 1200w`} sizes="(max-width: 860px) 100vw, 760px" alt={categoryPhoto(d.category).alt} width="1200" height="896" decoding="async" /></figure>


      <div class="answer-box">
        <span class="answer-label">Quick answer</span>
        <p>{d.answer}</p>
      </div>

      <div class="prose post-content">
        <Content />
      </div>

      {d.faq.length > 0 && <FAQ items={d.faq} />}

      {d.tags.length > 0 && (
        <div class="tags">
          {d.tags.map((t) => (<span class="tag">#{t}</span>))}
        </div>
      )}

      {related.length > 0 && (
        <div class="related-posts">
          <h2>Related guides</h2>
          <ul>
            {related.map((r) => (<li><a href={`/blog/${r.id}/`}>{r.data.title}</a></li>))}
          </ul>
        </div>
      )}
    </div>
  </article>

  <RelatedPages />
  <CTABand />
</BaseLayout>

<style>
  .post-header { margin-bottom: 1.5rem; }
  .post-header h1 { margin: 0.6rem 0 0.4rem; }
  .post-byline { color: var(--c-muted); font-size: 0.9rem; margin: 0; }
  .post-content { font-size: 1.075rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
  .tag { color: var(--c-primary); font-size: 0.85rem; font-weight: 600; }
  .related-posts { margin-top: 2.5rem; border-top: 1px solid var(--c-line); padding-top: 1.5rem; }
  .related-posts ul { list-style: none; padding: 0; }
  .related-posts li { margin-bottom: 0.5rem; }
  .post-figure { margin: 0 0 1.6rem; max-width: var(--maxw-narrow); }
  .post-figure img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 14px; }
</style>
