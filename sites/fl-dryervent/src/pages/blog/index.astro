---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryPhoto } from '../../data/images';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import { getCollection } from 'astro:content';
import { business } from '../../data/business';

const title = 'Dryer Vent Guides for Florida Homeowners';
const description = 'Plain guides on dryer vent cleaning, costs, fire risk, the Florida code for dryer ducts, condo vents and what you can safely do yourself.';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = [...new Set(posts.map((p) => p.data.category))].sort();
const featured = posts.filter((p) => p.data.featured).slice(0, 3);
const featuredIds = new Set(featured.map((p) => p.id));
const rest = posts.filter((p) => !featuredIds.has(p.id));

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout title={title} description={description} altHref="/es/blog/">
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }]} />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Guides &amp; resources</span>
        <h1>Dryer Vent Guides</h1>
        <p class="lead">Prices, warning signs, code and fire safety, explained for Florida houses and condos.</p>
      </div>

      {featured.length > 0 && (
        <div class="grid grid-3 featured">
          {featured.map((p) => (
            <a href={`/blog/${p.id}/`} class="card post-card featured-card">
              <img class="post-img" src={categoryPhoto(p.data.category).small} alt="" width="640" height="478" loading="lazy" decoding="async" />
              <span class="pill">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="post-meta">{fmt(p.data.pubDate)}</span>
            </a>
          ))}
        </div>
      )}

      <div class="cat-bar">
        {categories.map((c) => (<span class="cat-tag">{c}</span>))}
      </div>

      <div class="grid grid-3">
        {rest.map((p) => (
          <a href={`/blog/${p.id}/`} class="card post-card">
            <img class="post-img" src={categoryPhoto(p.data.category).small} alt="" width="640" height="478" loading="lazy" decoding="async" />
            <span class="pill">{p.data.category}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            <span class="post-meta">{fmt(p.data.pubDate)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CTABand />
</BaseLayout>

<style>
  .post-card { display: flex; flex-direction: column; text-decoration: none; gap: 0.5rem; }
  .post-card:hover { text-decoration: none; }
  .post-card h3 { color: var(--c-ink); font-size: 1.15rem; margin: 0.3rem 0; }
  .post-card p { color: var(--c-body); font-size: 0.92rem; margin: 0; flex-grow: 1; }
  .post-meta { color: var(--c-muted); font-size: 0.82rem; margin-top: 0.4rem; }
  .featured { margin-bottom: 2rem; }
  .featured-card { border-color: #f7c9ad; }
  .cat-bar { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.5rem 0; }
  .cat-tag { background: var(--c-bg-alt); border: 1px solid var(--c-line); border-radius: 999px; padding: 0.35rem 0.9rem; font-size: 0.82rem; font-weight: 600; color: var(--c-body); }
  .post-card { padding-top: 0; overflow: hidden; }
  .post-img { width: calc(100% + 3.2rem); max-width: none; margin: 0 -1.6rem 1.1rem; aspect-ratio: 16 / 9; object-fit: cover; }
</style>
