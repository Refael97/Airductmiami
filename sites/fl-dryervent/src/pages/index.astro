---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import FAQ from '../components/FAQ.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { business } from '../data/business';
import { services, PRICE } from '../data/services';
import { cities, citiesByRegion } from '../data/cities';

const title = `Dryer Vent Cleaning in Florida | $${PRICE.cleanLow} to $${PRICE.cleanHigh}`;
const description = `Dryer vent cleaning, repair and installation across Florida. Cleaning $${PRICE.cleanLow} to $${PRICE.cleanHigh}, airflow measured before and after, price given before we book.`;

const homeFaq = [
  { question: 'How much does dryer vent cleaning cost in Florida?', answer: `$${PRICE.cleanLow} to $${PRICE.cleanHigh} for most homes. Repair, replacement or a new run is $${PRICE.workLow} to $${PRICE.workHigh}. You get the figure for your vent before we book.` },
  { question: 'How often should a dryer vent be cleaned?', answer: 'Once a year for most households, every six to nine months with a long or roof run, a large family or pets that shed.' },
  { question: 'Why does my dryer take two cycles?', answer: 'Most often because the vent is restricted, by lint along the run, a crushed hose behind the dryer, or a blocked hood outside. A full lint screen and an overloaded drum are the other two causes, and both are easy to rule out first.' },
  { question: 'Are you insured?', answer: 'Yes. Dryer vent cleaning is not a licensed trade in Florida, so there is no licence for anyone to hold, and we would rather say so than claim one.' },
  { question: 'Do you serve my area?', answer: `We work across Florida, with pages for ${cities.length} cities from Miami and Fort Lauderdale to Orlando, Tampa, Fort Myers and Naples. Call ${business.phone} to confirm your ZIP code.` },
];

const regions = citiesByRegion();
const stats = [
  { value: `$${PRICE.cleanLow} to $${PRICE.cleanHigh}`, label: 'Dryer vent cleaning' },
  { value: 'Before + after', label: 'Airflow measured at the hood' },
  { value: 'Same week', label: 'Appointments' },
  { value: `${cities.length} cities`, label: 'Across Florida' },
];
---
<BaseLayout title={title} description={description} altHref="/es/">
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Dryer vents, and only dryer vents</span>
        <h1>Dryer Vent Cleaning, Repair &amp; Installation in Florida</h1>
        <p class="lead">
          If the towels need two cycles, the vent is usually why. We clean the whole run from the dryer to the
          outside hood, fix what cleaning cannot, and show you the airflow before and after so the result is a
          number, not a promise.
        </p>
        <div class="hero-actions">
          <a href={`tel:${business.phoneHref}`} class="btn btn-accent btn-lg">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3A19.5 19.5 0 0 1 5.2 13 19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0 1 22 16.9Z"/></svg>
            Call {business.phone}</a>
          <a href="/contact/" class="btn btn-outline btn-lg">Get the price</a>
        </div>
        <ul class="hero-trust check-list">
          <li>Cleaning ${PRICE.cleanLow} to ${PRICE.cleanHigh}, price given before booking</li>
          <li>Rigid metal duct for every repair and installation</li>
          <li>Insured, same week appointments across Florida</li>
        </ul>
      </div>
      <div class="hero-visual">
        <div class="vent-card" role="img" aria-label="Diagram: airflow at the outside hood measured before and after a dryer vent cleaning">
          <svg viewBox="0 0 320 170" width="100%" height="auto" aria-hidden="true">
            <rect x="10" y="40" width="70" height="90" rx="10" fill="#fff" stroke="#0f3d5e" stroke-width="3"/>
            <circle cx="45" cy="88" r="22" fill="none" stroke="#0f3d5e" stroke-width="3"/>
            <path d="M80 70 H150 Q170 70 170 50 V30 H290" fill="none" stroke="#9fb4c4" stroke-width="14" stroke-linecap="round"/>
            <path d="M80 70 H150 Q170 70 170 50 V30 H290" fill="none" stroke="#ff8a3d" stroke-width="4" stroke-dasharray="8 10" stroke-linecap="round"/>
            <rect x="282" y="16" width="26" height="28" rx="4" fill="#0f3d5e"/>
          </svg>
          <p class="vent-card-title">Measured, not guessed</p>
          <p class="vent-card-text">Airflow is read at the outside hood with the dryer running, before we touch anything and again when we finish. You see both numbers.</p>
          <a href="/services/dryer-vent-cleaning/" class="btn btn-primary">How a cleaning works →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="stats-band">
    <div class="container stats-grid">
      {stats.map((s) => (<div class="stat"><span class="stat-value">{s.value}</span><span class="stat-label">{s.label}</span></div>))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">What we do</span>
        <h2>Five jobs, all of them dryer vents</h2>
        <p class="lead">Cleaning for a run that is slow, repair for one that is broken, a new duct for one that was never right.</p>
      </div>
      <div class="grid grid-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}/`} class="card service-card">
            <span class="icon" aria-hidden="true"><ServiceIcon slug={s.slug} /></span>
            <h3>{s.name}</h3>
            <p>{s.answer.split('. ')[0]}.</p>
            <span class="card-link">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container why-grid">
      <div>
        <span class="eyebrow">Why a specialist</span>
        <h2>A dryer vent is a small job that is easy to do badly</h2>
        <p>A brush pushed into the wall from the laundry side moves the lint deeper and leaves the hood blocked. A cleaning that never looks at the transition hose misses the most common restriction in the house. And no cleaning fixes a run that is too long or has come apart in the attic.</p>
        <ul class="check-list">
          <li><strong>Both ends of the run</strong>, from the dryer and from the hood where it can be reached.</li>
          <li><strong>The hose and the hood included</strong>, because that is where much of the blockage sits.</li>
          <li><strong>Florida Building Code checked</strong>: rigid metal, no screws into the duct, the 35 foot length rule.</li>
          <li><strong>Price before booking</strong>, and nothing added without asking first.</li>
        </ul>
        <a href="/about/" class="btn btn-primary">How we work</a>
      </div>
      <div class="why-facts">
        <div class="why-fact"><span class="wf-num">2,900</span><span>home clothes dryer fires a year in the US, according to the US Fire Administration</span></div>
        <div class="why-fact"><span class="wf-num">1 in 3</span><span>of them traced to the leading cause: failure to clean</span></div>
        <div class="why-fact"><span class="wf-num">35 ft</span><span>maximum dryer duct length under the code, less 5 ft for every 90 degree bend</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Across Florida</span>
        <h2>Dryer vent cleaning near you</h2>
        <p class="lead">Every city below has its own page: how vents are usually run there and what we find most often.</p>
      </div>
      <div class="areas-grid">
        {regions.map(([region, list]) => (
          <div class="area-col">
            <h3>{region}</h3>
            <ul>{list.map((c) => (<li><a href={`/service-areas/${c.slug}/`}>{c.name}</a></li>))}</ul>
          </div>
        ))}
      </div>
      <p class="text-center" style="margin-top:1.5rem;"><a href="/service-areas/" class="btn btn-outline">All service areas →</a></p>
    </div>
  </section>

  <CTABand />

  <section class="section section-alt">
    <div class="container container-narrow">
      <div class="section-head center"><span class="eyebrow">Good to know</span><h2>Frequently Asked Questions</h2></div>
      <FAQ items={homeFaq} title="" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero { background: var(--grad-hero); padding-block: clamp(2.5rem, 6vw, 4.5rem); position: relative; }
  .wave-divider { margin-top: -1px; background: #fff; }
  .ba-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .ba-cap { text-align: center; margin: 0.7rem 0 0; font-weight: 700; color: var(--c-ink); }
  @media (max-width: 760px) { .ba-grid { grid-template-columns: 1fr; } }
  .hero-inner { display: grid; grid-template-columns: 1.35fr 1fr; gap: 2.5rem; align-items: center; }
  .hero-copy h1 { margin-bottom: 0.6rem; }
  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin: 1.4rem 0; }
  .hero-trust { margin-top: 1rem; }
  .hero-trust li { font-weight: 600; color: var(--c-ink); }
  .hero-visual { position: relative; }
  .hero-img {
    width: 100%; height: auto; border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg); display: block;
  }
  .hero-card-inner {
    position: absolute; left: 1rem; right: 1rem; bottom: -1.2rem;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(6px);
    border: 1px solid var(--c-line); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 1.1rem 1.3rem;
  }
  .hero-card-title { font-weight: 800; color: var(--c-ink); font-size: 1.05rem; margin-bottom: 0.3rem; }
  .hero-card-text { color: var(--c-body); font-size: 0.92rem; margin-bottom: 0.8rem; }
  .hero-card-inner .btn { padding: 0.6rem 1.2rem; font-size: 0.9rem; }

  .stats-band { background: var(--c-bg-deep); }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding-block: 1.6rem; }
  .stat { text-align: center; color: #cfe0ec; }
  .stat-value { display: block; font-size: 1.7rem; font-weight: 800; color: #fff; }
  .stat-label { font-size: 0.85rem; }

  .service-card { display: block; text-decoration: none; }
  .service-card:hover { text-decoration: none; }
  .service-card h3 { color: var(--c-ink); }
  .service-card p { color: var(--c-body); font-size: 0.95rem; }
  .card-link { color: var(--c-primary); font-weight: 700; font-size: 0.9rem; }

  .why-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; align-items: center; }
  .why-facts { display: grid; gap: 1rem; }
  .why-fact {
    background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius);
    padding: 1.2rem 1.4rem; box-shadow: var(--shadow-sm);
    display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center;
  }
  .wf-num { font-size: 1.8rem; font-weight: 800; color: var(--c-primary); }

  .areas-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; }
  .area-col h3 { font-size: 1.05rem; color: var(--c-primary-dark); border-bottom: 2px solid var(--c-line); padding-bottom: 0.4rem; margin-bottom: 0.7rem; }
  .area-col ul { list-style: none; padding: 0; margin: 0; }
  .area-col li { margin-bottom: 0.35rem; }
  .area-col a { font-size: 0.92rem; color: var(--c-body); }

  @media (max-width: 860px) {
    .hero-inner, .why-grid { grid-template-columns: 1fr; }
    .hero-card-inner { position: static; margin-top: 0.9rem; }

    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .vent-card { background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); padding: 1.3rem 1.4rem; }
  .vent-card svg { display: block; margin-bottom: 0.8rem; }
  .vent-card-title { font-weight: 800; color: var(--c-ink); font-size: 1.1rem; margin-bottom: 0.3rem; }
  .vent-card-text { color: var(--c-body); font-size: 0.95rem; margin-bottom: 0.9rem; }
</style>
