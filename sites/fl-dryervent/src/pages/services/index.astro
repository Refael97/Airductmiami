---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import { services } from '../../data/services';
import { servicePhoto } from '../../data/images';
import { business } from '../../data/business';

const title = `Dryer Vent Services in Florida | Clean, Repair, Install`;
const description = 'Dryer vent cleaning $100 to $200, repair and new dryer duct installation $200 to $600, vent caps, bird nests and condo buildings across Florida.';
---
<BaseLayout title={title} description={description} altHref="/es/servicios/">
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }]} />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our services</span>
        <h1>Dryer Vent Services in Florida</h1>
        <p class="lead">Every service here is a dryer vent service: cleaning, inspection, repair and replacement, new runs, roof and wall caps, booster fans, condos and commercial buildings.</p>
      </div>
      <div class="grid grid-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}/`} class="card service-card">
            <img class="svc-img" src={servicePhoto[s.slug]?.small} alt="" width="640" height="478" loading="lazy" decoding="async" />
            <h3>{s.name}</h3>
            <p>{s.answer.split('. ')[0]}.</p>
            <span class="card-link">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CTABand />
</BaseLayout>

<style>
  .service-card { display: block; text-decoration: none; padding-top: 0; overflow: hidden; }
  .svc-img { width: calc(100% + 3.2rem); max-width: none; margin: 0 -1.6rem 1.1rem; aspect-ratio: 16 / 9; object-fit: cover; }
  .service-card:hover { text-decoration: none; }
  .service-card h3 { color: var(--c-ink); }
  .service-card p { color: var(--c-body); font-size: 0.95rem; }
  .card-link { color: var(--c-orange); font-family: var(--font-head); font-weight: 700; font-size: 0.9rem; }
</style>
