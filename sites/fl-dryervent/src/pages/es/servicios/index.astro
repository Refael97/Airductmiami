---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABand from '../../../components/CTABand.astro';
import { services } from '../../../data/services';
import { serviceEsContent } from '../../../data/services.es';
import { business } from '../../../data/business';
import ServiceIcon from '../../../components/ServiceIcon.astro';
import { ui, serviceHref } from '../../../data/ui';

const lang = 'es' as const;
const t = ui[lang];
const title = 'Servicios de Ventila de Secadora en Florida';
const description = 'Limpieza de ventila de secadora $100 a $200, reparación e instalación $200 a $600, salidas, nidos de pájaro y edificios de condominio en Florida.';
---
<BaseLayout title={title} description={description} lang={lang} altHref="/services/">
 <Breadcrumbs crumbs={[{ name: t.breadcrumbHome, href: t.home }, { name: t.nav[0].label, href: t.services }]} />
 <section class="section">
 <div class="container">
 <div class="section-head">
 <span class="eyebrow">Nuestros servicios</span>
 <h1>Servicios de Ventila de Secadora en Florida</h1>
 <p class="lead">Cinco servicios, todos de ventilas de secadora: limpieza, reparación, instalación, la salida de afuera y edificios de condominio completos.</p>
 </div>
 <div class="grid grid-3">
 {services.map((s) => {
 const es = serviceEsContent[s.slug];
 return (
 <a href={serviceHref(lang, s.slug)} class="card service-card">
 <span class="icon" aria-hidden="true"><ServiceIcon slug={s.slug} /></span>
 <h3>{es.name}</h3>
 <p>{es.answer.split('. ')[0]}.</p>
 <span class="card-link">{t.learnMore} →</span>
 </a>
 );
 })}
 </div>
 </div>
 </section>
 <CTABand lang={lang} />
</BaseLayout>

<style>
  .service-card { display: block; text-decoration: none; }
  .service-card:hover { text-decoration: none; }
  .service-card h3 { color: var(--c-ink); }
  .service-card p { color: var(--c-body); font-size: 0.95rem; }
  .card-link { color: var(--c-primary); font-weight: 700; font-size: 0.9rem; }
</style>
