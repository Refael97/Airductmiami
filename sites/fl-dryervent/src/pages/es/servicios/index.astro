---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABand from '../../../components/CTABand.astro';
import { services } from '../../../data/services';
import { serviceEsContent } from '../../../data/services.es';
import { business } from '../../../data/business';
import { servicePhoto } from '../../../data/images';
import { ui, serviceHref } from '../../../data/ui';

const lang = 'es' as const;
const t = ui[lang];
const title = 'Servicios de Ventila de Secadora en Florida';
const description = 'Limpieza de ventila de secadora $100 a $200, reparación e instalación $200 a $600, salidas, nidos de pájaro y edificios de condominio en Florida.';
---
<BaseLayout title={title} description={description} lang={lang} altHref="/services/">
 <Breadcrumbs crumbs={[{ name: t.breadcrumbHome, href: t.home }, { name: t.nav[0].label, href: t.services }]} />
 <section class="section">
 <div class="container">
 <div class="section-head">
 <span class="eyebrow">Nuestros servicios</span>
 <h1>Servicios de Ventila de Secadora en Florida</h1>
 <p class="lead">Todos nuestros servicios son de ventilas de secadora: limpieza, inspección, reparación y reemplazo, tramos nuevos, salidas de techo y pared, extractores auxiliares, condominios y edificios comerciales.</p>
 </div>
 <div class="grid grid-3">
 {services.map((s) => {
 const es = serviceEsContent[s.slug];
 return (
 <a href={serviceHref(lang, s.slug)} class="card service-card">
 <img class="svc-img" src={servicePhoto[s.slug]?.small} alt="" width="640" height="478" loading="lazy" decoding="async" />
 <h3>{es.name}</h3>
 <p>{es.answer.split('. ')[0]}.</p>
 <span class="card-link">{t.learnMore} →</span>
 </a>
 );
 })}
 </div>
 </div>
 </section>
 <CTABand lang={lang} />
</BaseLayout>

<style>
  .service-card { display: block; text-decoration: none; padding-top: 0; overflow: hidden; }
  .svc-img { width: calc(100% + 3.2rem); max-width: none; margin: 0 -1.6rem 1.1rem; aspect-ratio: 16 / 9; object-fit: cover; }
  .service-card:hover { text-decoration: none; }
  .service-card h3 { color: var(--c-ink); }
  .service-card p { color: var(--c-body); font-size: 0.95rem; }
  .card-link { color: var(--c-orange); font-family: var(--font-head); font-weight: 700; font-size: 0.9rem; }
</style>
