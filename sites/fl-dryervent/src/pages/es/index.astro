---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import FAQ from '../../components/FAQ.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { business } from '../../data/business';
import { services, PRICE } from '../../data/services';
import { serviceEsContent } from '../../data/services.es';
import { cities, citiesByRegion, REGION_ES } from '../../data/cities';

const title = `Limpieza de Ventila de Secadora en Florida | $${PRICE.cleanLow} a $${PRICE.cleanHigh}`;
const description = `Limpieza, reparación e instalación de ventilas de secadora en Florida. Limpieza $${PRICE.cleanLow} a $${PRICE.cleanHigh}, flujo medido antes y después, precio antes de agendar.`;

const homeFaq = [
  { question: '¿Cuánto cuesta limpiar la ventila de la secadora en Florida?', answer: `Entre $${PRICE.cleanLow} y $${PRICE.cleanHigh} en la mayoría de las casas. Reparar, cambiar o instalar un tramo nuevo cuesta entre $${PRICE.workLow} y $${PRICE.workHigh}. Le damos el precio de su ventila antes de agendar.` },
  { question: '¿Cada cuánto hay que limpiar la ventila?', answer: 'Una vez al año en la mayoría de las casas, cada seis a nueve meses con un tramo largo o por el techo, una familia grande o mascotas que sueltan mucho pelo.' },
  { question: '¿Por qué mi secadora necesita dos ciclos?', answer: 'Casi siempre porque la ventila está tapada: pelusa en el tramo, una manguera aplastada detrás de la secadora o una salida bloqueada afuera. Un filtro de pelusa lleno o demasiada ropa son las otras dos causas, y conviene descartarlas primero.' },
  { question: '¿Están asegurados?', answer: 'Sí. La limpieza de ventilas de secadora no es un oficio con licencia en Florida, así que no hay licencia que tener, y preferimos decirlo antes que inventar una.' },
  { question: '¿Atienden mi zona?', answer: `Trabajamos en toda Florida, con páginas para ${cities.length} ciudades, de Miami y Fort Lauderdale a Orlando, Tampa, Fort Myers y Naples. Llame al ${business.phone} para confirmar su código postal.` },
];

const regions = citiesByRegion();
const stats = [
  { value: `$${PRICE.cleanLow} a $${PRICE.cleanHigh}`, label: 'Limpieza de ventila' },
  { value: 'Antes y después', label: 'Flujo medido en la salida' },
  { value: 'Misma semana', label: 'Citas' },
  { value: `${cities.length} ciudades`, label: 'En toda Florida' },
];
---
<BaseLayout title={title} description={description} lang="es" altHref="/">
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Ventilas de secadora, y nada más</span>
        <h1>Limpieza, Reparación e Instalación de Ventilas de Secadora en Florida</h1>
        <p class="lead">
          Si las toallas necesitan dos ciclos, casi siempre es la ventila. Limpiamos todo el tramo de la secadora a la
          salida de afuera, arreglamos lo que una limpieza no arregla, y le mostramos el flujo de aire antes y después
          para que el resultado sea un número y no una promesa.
        </p>
        <div class="hero-actions">
          <a href={`tel:${business.phoneHref}`} class="btn btn-accent btn-lg">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3A19.5 19.5 0 0 1 5.2 13 19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0 1 22 16.9Z"/></svg>
            Llame al {business.phone}</a>
          <a href="/es/contacto/" class="btn btn-outline btn-lg">Pida el precio</a>
        </div>
        <ul class="hero-trust check-list">
          <li>Limpieza ${PRICE.cleanLow} a ${PRICE.cleanHigh}, precio antes de agendar</li>
          <li>Ducto de metal rígido en cada reparación e instalación</li>
          <li>Asegurados, citas la misma semana en toda Florida</li>
        </ul>
      </div>
      <div class="hero-visual">
        <div class="vent-card" role="img" aria-label="Diagrama: el flujo de aire en la salida se mide antes y después de limpiar la ventila">
          <svg viewBox="0 0 320 170" width="100%" height="auto" aria-hidden="true">
            <rect x="10" y="40" width="70" height="90" rx="10" fill="#fff" stroke="#0f3d5e" stroke-width="3"/>
            <circle cx="45" cy="88" r="22" fill="none" stroke="#0f3d5e" stroke-width="3"/>
            <path d="M80 70 H150 Q170 70 170 50 V30 H290" fill="none" stroke="#9fb4c4" stroke-width="14" stroke-linecap="round"/>
            <path d="M80 70 H150 Q170 70 170 50 V30 H290" fill="none" stroke="#ff8a3d" stroke-width="4" stroke-dasharray="8 10" stroke-linecap="round"/>
            <rect x="282" y="16" width="26" height="28" rx="4" fill="#0f3d5e"/>
          </svg>
          <p class="vent-card-title">Medido, no adivinado</p>
          <p class="vent-card-text">Medimos el flujo en la salida de afuera con la secadora prendida, antes de tocar nada y otra vez al terminar. Usted ve los dos números.</p>
          <a href="/es/servicios/dryer-vent-cleaning/" class="btn btn-primary">Cómo es una limpieza →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="stats-band">
    <div class="container stats-grid">
      {stats.map((s) => (<div class="stat"><span class="stat-value">{s.value}</span><span class="stat-label">{s.label}</span></div>))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Lo que hacemos</span>
        <h2>Cinco trabajos, todos de ventilas de secadora</h2>
        <p class="lead">Limpieza para una ventila lenta, reparación para una rota, y un ducto nuevo para la que nunca estuvo bien.</p>
      </div>
      <div class="grid grid-3">
        {services.map((s) => {
          const es = serviceEsContent[s.slug];
          return (
            <a href={`/es/servicios/${s.slug}/`} class="card service-card">
              <span class="icon" aria-hidden="true"><ServiceIcon slug={s.slug} /></span>
              <h3>{es.name}</h3>
              <p>{es.answer.split('. ')[0]}.</p>
              <span class="card-link">Más información →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container why-grid">
      <div>
        <span class="eyebrow">Por qué un especialista</span>
        <h2>La ventila es un trabajo chico que es fácil hacer mal</h2>
        <p>Un cepillo metido desde la lavandería empuja la pelusa más adentro y deja la salida tapada. Una limpieza que no revisa la manguera de atrás se pierde la obstrucción más común de la casa. Y ninguna limpieza arregla un tramo demasiado largo o que se soltó en el ático.</p>
        <ul class="check-list">
          <li><strong>Los dos extremos del tramo</strong>, desde la secadora y desde la salida cuando se alcanza.</li>
          <li><strong>Manguera y salida incluidas</strong>, porque ahí está gran parte de la obstrucción.</li>
          <li><strong>Código de construcción de Florida</strong>: metal rígido, sin tornillos en el ducto, la regla de 35 pies.</li>
          <li><strong>Precio antes de agendar</strong>, y nada se agrega sin preguntarle.</li>
        </ul>
        <a href="/es/nosotros/" class="btn btn-primary">Cómo trabajamos</a>
      </div>
      <div class="why-facts">
        <div class="why-fact"><span class="wf-num">2,900</span><span>incendios de secadora en casas cada año en Estados Unidos, según la Administración de Incendios de EE. UU.</span></div>
        <div class="why-fact"><span class="wf-num">1 de 3</span><span>vienen de la causa principal: no limpiar la ventila</span></div>
        <div class="why-fact"><span class="wf-num">35 pies</span><span>largo máximo del ducto de secadora por código, menos 5 pies por cada curva de 90 grados</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">En toda Florida</span>
        <h2>Limpieza de ventila de secadora cerca de usted</h2>
        <p class="lead">Cada ciudad tiene su página: cómo suelen ir las ventilas allí y lo que más encontramos.</p>
      </div>
      <div class="areas-grid">
        {regions.map(([region, list]) => (
          <div class="area-col">
            <h3>{REGION_ES[region]}</h3>
            <ul>{list.map((c) => (<li><a href={`/es/areas-de-servicio/${c.slug}/`}>{c.name}</a></li>))}</ul>
          </div>
        ))}
      </div>
      <p class="text-center" style="margin-top:1.5rem;"><a href="/es/areas-de-servicio/" class="btn btn-outline">Todas las áreas →</a></p>
    </div>
  </section>

  <CTABand lang="es" />

  <section class="section section-alt">
    <div class="container container-narrow">
      <div class="section-head center"><span class="eyebrow">Bueno saber</span><h2>Preguntas Frecuentes</h2></div>
      <FAQ items={homeFaq} title="" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero { background: var(--grad-hero); padding-block: clamp(2.5rem, 6vw, 4.5rem); position: relative; }
  .wave-divider { margin-top: -1px; background: #fff; }
  .ba-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .ba-cap { text-align: center; margin: 0.7rem 0 0; font-weight: 700; color: var(--c-ink); }
  @media (max-width: 760px) { .ba-grid { grid-template-columns: 1fr; } }
  .hero-inner { display: grid; grid-template-columns: 1.35fr 1fr; gap: 2.5rem; align-items: center; }
  .hero-copy h1 { margin-bottom: 0.6rem; }
  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin: 1.4rem 0; }
  .hero-trust { margin-top: 1rem; }
  .hero-trust li { font-weight: 600; color: var(--c-ink); }
  .hero-visual { position: relative; }
  .hero-img {
    width: 100%; height: auto; border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg); display: block;
  }
  .hero-card-inner {
    position: absolute; left: 1rem; right: 1rem; bottom: -1.2rem;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(6px);
    border: 1px solid var(--c-line); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 1.1rem 1.3rem;
  }
  .hero-card-title { font-weight: 800; color: var(--c-ink); font-size: 1.05rem; margin-bottom: 0.3rem; }
  .hero-card-text { color: var(--c-body); font-size: 0.92rem; margin-bottom: 0.8rem; }
  .hero-card-inner .btn { padding: 0.6rem 1.2rem; font-size: 0.9rem; }

  .stats-band { background: var(--c-bg-deep); }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding-block: 1.6rem; }
  .stat { text-align: center; color: #cfe0ec; }
  .stat-value { display: block; font-size: 1.7rem; font-weight: 800; color: #fff; }
  .stat-label { font-size: 0.85rem; }

  .service-card { display: block; text-decoration: none; }
  .service-card:hover { text-decoration: none; }
  .service-card h3 { color: var(--c-ink); }
  .service-card p { color: var(--c-body); font-size: 0.95rem; }
  .card-link { color: var(--c-primary); font-weight: 700; font-size: 0.9rem; }

  .why-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; align-items: center; }
  .why-facts { display: grid; gap: 1rem; }
  .why-fact {
    background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius);
    padding: 1.2rem 1.4rem; box-shadow: var(--shadow-sm);
    display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center;
  }
  .wf-num { font-size: 1.8rem; font-weight: 800; color: var(--c-primary); }

  .areas-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; }
  .area-col h3 { font-size: 1.05rem; color: var(--c-primary-dark); border-bottom: 2px solid var(--c-line); padding-bottom: 0.4rem; margin-bottom: 0.7rem; }
  .area-col ul { list-style: none; padding: 0; margin: 0; }
  .area-col li { margin-bottom: 0.35rem; }
  .area-col a { font-size: 0.92rem; color: var(--c-body); }

  @media (max-width: 860px) {
    .hero-inner, .why-grid { grid-template-columns: 1fr; }
    .hero-card-inner { position: static; margin-top: 0.9rem; }

    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .vent-card { background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); padding: 1.3rem 1.4rem; }
  .vent-card svg { display: block; margin-bottom: 0.8rem; }
  .vent-card-title { font-weight: 800; color: var(--c-ink); font-size: 1.1rem; margin-bottom: 0.3rem; }
  .vent-card-text { color: var(--c-body); font-size: 0.95rem; margin-bottom: 0.9rem; }
</style>
