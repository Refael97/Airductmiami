---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePage.astro';
import { business } from '../../data/business';
import { PRICE } from '../../data/services';
import { cities } from '../../data/cities';

const title = `Limpieza de Ventila de Secadora en Florida | $${PRICE.cleanLow} a $${PRICE.cleanHigh}`;

const description = `Limpieza, reparación e instalación de ventilas de secadora en Florida. Limpieza $${PRICE.cleanLow} a $${PRICE.cleanHigh}, flujo medido antes y después, precio antes de agendar.`;

const homeFaq = [
  { question: '¿Cuánto cuesta limpiar la ventila de la secadora en Florida?', answer: `Entre $${PRICE.cleanLow} y $${PRICE.cleanHigh} en la mayoría de las casas. Reparar, cambiar o instalar un tramo nuevo cuesta entre $${PRICE.workLow} y $${PRICE.workHigh}. Le damos el precio de su ventila antes de agendar.` },
  { question: '¿Cada cuánto hay que limpiar la ventila?', answer: 'Una vez al año en la mayoría de las casas, cada seis a nueve meses con un tramo largo o por el techo, una familia grande o mascotas que sueltan mucho pelo.' },
  { question: '¿Por qué mi secadora necesita dos ciclos?', answer: 'Casi siempre porque la ventila está tapada: pelusa en el tramo, una manguera aplastada detrás de la secadora o una salida bloqueada afuera. Un filtro de pelusa lleno o demasiada ropa son las otras dos causas, y conviene descartarlas primero.' },
  { question: '¿Están asegurados?', answer: 'Sí. La limpieza de ventilas de secadora no es un oficio con licencia en Florida, así que no hay licencia que tener, y preferimos decirlo antes que inventar una.' },
  { question: '¿Atienden mi zona?', answer: `Trabajamos en toda Florida, con páginas para ${cities.length} ciudades, de Miami y Fort Lauderdale a Orlando, Tampa, Fort Myers y Naples. Llame al ${business.phone} para confirmar su código postal.` },
];
---
<BaseLayout title={title} description={description} lang="es" altHref="/">
  <HomePage lang="es" faq={homeFaq} />
</BaseLayout>
