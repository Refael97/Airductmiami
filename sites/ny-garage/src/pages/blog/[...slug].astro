---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import CtaBand from '../../components/CtaBand.astro';
import FAQ from '../../components/FAQ.astro';
import PriceDisclaimer from '../../components/PriceDisclaimer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getService } from '../../data/services';
import { business } from '../../data/business';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await post.render();
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Guides', href: '/blog/' },
  { name: post.data.title, href: `/blog/${post.slug}/` },
];

const related = post.data.relatedServices
  .map((s) => getService(s))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

/** Other articles in the same cluster, for onward reading. */
const all = await getCollection('blog', ({ data }) => !data.draft);
const siblings = all
  .filter((p) => p.slug !== post.slug && p.data.cluster === post.data.cluster)
  .slice(0, 4);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: business.name },
  publisher: { '@id': `${site}/#business` },
  mainEntityOfPage: `${site}/blog/${post.slug}/`,
};

/** Price articles must carry the starting-price disclaimer. */
const showPriceNote = post.data.cluster === 'cost' || post.data.cluster === 'product';
---
<BaseLayout title={`${post.data.title} | ${business.name}`} description={post.data.description} schema={schema} ogType="article">
  <Breadcrumbs crumbs={crumbs} />

  <section class="section">
    <div class="container post-grid">
      <article class="prose post">
        <span class="eyebrow">{post.data.cluster === 'cost' ? 'Cost guide' : post.data.cluster === 'symptom' ? 'Symptom guide' : post.data.cluster === 'product' ? 'Choosing guide' : post.data.cluster === 'trust' ? 'Hiring guide' : post.data.cluster === 'safety' ? 'Safety' : 'Maintenance'}</span>
        <h1>{post.data.title}</h1>
        <p class="byline">
          Published {fmt(post.data.pubDate)}
          {post.data.updatedDate && <> · Updated {fmt(post.data.updatedDate)}</>}
        </p>

        <AnswerBox text={post.data.answer} />

        <Content />

        {showPriceNote && <PriceDisclaimer variant="block" />}

        {post.data.faq.length > 0 && <FAQ items={post.data.faq} title="Related questions" />}
      </article>

      <aside class="post-aside">
        {related.length > 0 && (
          <div class="card aside-card">
            <h2>Services in this guide</h2>
            <ul class="plain">
              {related.map((s) => (
                <li>
                  <a href={`/services/${s.slug}/`}>{s.shortName}</a>
                  <span>from ${s.priceLow.toLocaleString('en-US')}</span>
                </li>
              ))}
            </ul>
            <a href="/prices/" class="aside-more">Full price list →</a>
          </div>
        )}

        <div class="card aside-card">
          <h2>Need this fixed?</h2>
          <p class="aside-note">
            Tell us what happened and we will give you the number before anyone is
            dispatched.
          </p>
          <a href="/contact/" class="btn btn-accent btn-sm">Get a free quote</a>
        </div>

        {siblings.length > 0 && (
          <div class="card aside-card">
            <h2>More like this</h2>
            <ul class="link-list">
              {siblings.map((p) => (
                <li><a href={`/blog/${p.slug}/`}>{p.data.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .post-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 2.5rem; align-items: start; }
  .post { max-width: none; }
  .post h1 { margin-bottom: 0.3rem; }
  .byline { font-size: 0.84rem; color: var(--c-muted); margin-bottom: 1.4rem; }

  .post-aside { position: sticky; top: 6.5rem; display: grid; gap: 1.2rem; }
  .aside-card h2 { font-size: 1rem; margin-bottom: 0.8rem; }
  .aside-note { font-size: 0.88rem; margin-bottom: 0.9rem; }
  .plain { list-style: none; padding: 0; margin: 0; }
  .plain li {
    display: flex; justify-content: space-between; gap: 0.6rem;
    padding: 0.45rem 0; border-bottom: 1px solid var(--c-line); font-size: 0.9rem;
  }
  .plain li:last-child { border-bottom: 0; }
  .plain span { color: var(--c-primary); font-weight: 700; white-space: nowrap; }
  .link-list { list-style: none; padding: 0; margin: 0; }
  .link-list li { margin-bottom: 0.5rem; font-size: 0.9rem; }
  .aside-more { display: inline-block; margin-top: 0.9rem; font-size: 0.88rem; font-weight: 700; }

  @media (max-width: 960px) {
    .post-grid { grid-template-columns: 1fr; }
    .post-aside { position: static; }
  }
</style>
