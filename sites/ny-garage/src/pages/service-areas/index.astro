---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import CtaBand from '../../components/CtaBand.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import { regions } from '../../data/regions';
import { citiesByRegion, cities } from '../../data/cities';
import { business } from '../../data/business';

const title = `Garage Door Service Areas in New York | ${business.name}`;
const description = `Where we work: ${cities.length} communities across Nassau, Suffolk, Westchester, Staten Island, Queens and Brooklyn. Same-day garage door repair with published starting prices.`;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Service Areas', href: '/service-areas/' },
];

const ordered = [...regions].sort((a, b) => a.order - b.order);

const faq = [
  {
    question: 'Do you serve Manhattan?',
    answer:
      'No, and it is worth being straight about why. Private residential garages barely exist in Manhattan, so there is very little for us to work on there. Our coverage follows the housing that actually has garages: Long Island, Westchester, Staten Island, and the parts of Queens and Brooklyn where driveways are normal.',
  },
  {
    question: 'My town is not listed. Can you still come?',
    answer:
      'Usually yes. The pages here cover the communities we work in most often, not the limit of where we travel. Send the address with your quote request and we will tell you honestly whether we can reach you and what the arrival window looks like.',
  },
  {
    question: 'Are prices different in different areas?',
    answer:
      'No. The published starting prices are the same everywhere we work. What changes the final number is the door, not the postcode. A narrow single door in Mount Vernon is simply a smaller job than a custom wood double in Scarsdale.',
  },
  {
    question: 'How fast can you reach me?',
    answer:
      'Same day in most of the service area, seven days a week. Response is fastest in Nassau, northeast Queens and the Staten Island South Shore, and slightly longer at the eastern end of Suffolk and the northern end of Westchester.',
  },
];
---
<BaseLayout title={title} description={description}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="areas-hero">
    <div class="container">
      <span class="eyebrow">Service areas</span>
      <div class="stripe-rule" aria-hidden="true"></div>
      <h1>Where we work</h1>
      <p class="lead">
        {cities.length} communities across six regions. The list is weighted by
        where garages actually are, which is why it looks nothing like a list of
        the biggest places in New York.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="narrow">
        <AnswerBox
          text={`${business.name} covers the New York metro area: Nassau County, Suffolk County, Westchester County, Staten Island, Queens and Brooklyn. Same-day garage door repair is available across all six, with the same published starting prices everywhere: $170 per spring, $100 for cable repair and $281 for opener installation.`}
        />
      </div>

      {ordered.map((r) => {
        const list = citiesByRegion(r.slug);
        return (
          <div class="region-block" data-anim="fade-up">
            <div class="region-head">
              <span class="rh-icon"><Icon name="pin" size={26} /></span>
              <div>
                <h2><a href={`/service-areas/${r.slug}/`}>{r.name}</a></h2>
                <p>{r.answer.split('. ')[0]}.</p>
              </div>
              <a href={`/service-areas/${r.slug}/`} class="btn btn-outline btn-sm">Region page</a>
            </div>
            <ul class="city-grid">
              {list.map((c) => (
                <li><a href={`/service-areas/${c.slug}/`}>{c.name}</a></li>
              ))}
            </ul>
          </div>
        );
      })}

      <div class="narrow"><FAQ items={faq} title="Coverage questions" /></div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .areas-hero { background: var(--grad-hero); padding-block: 2.6rem 2.4rem; }
  .narrow { max-width: var(--maxw-narrow); }

  .region-block {
    background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius);
    box-shadow: var(--shadow-card); padding: 1.6rem 1.75rem; margin-bottom: 1.4rem;
  }
  .region-head { display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1.1rem; }
  .rh-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.8rem; height: 2.8rem; border-radius: 10px; flex-shrink: 0;
    background: var(--c-primary-light); color: var(--c-primary);
  }
  .region-head h2 { font-size: 1.55rem; margin-bottom: 0.2rem; }
  .region-head h2 a { color: var(--c-ink); text-decoration: none; }
  .region-head h2 a:hover { color: var(--c-primary); }
  .region-head p { font-size: 0.9rem; color: var(--c-body); margin: 0; }
  .region-head .btn { margin-left: auto; flex-shrink: 0; }

  .city-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.4rem 1rem;
  }
  .city-grid li { margin: 0; }
  .city-grid a { font-size: 0.93rem; font-weight: 600; }

  @media (max-width: 620px) {
    .region-head { flex-wrap: wrap; }
    .region-head .btn { margin-left: 0; width: 100%; }
  }
</style>
