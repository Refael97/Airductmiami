---
/**
 * One route for both door materials and opener drive types. They share the
 * same page shape (answer, depth, pros, cons, facts, FAQ) and the same URL
 * namespace, and no slug collides between the two sets.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import PriceDisclaimer from '../../components/PriceDisclaimer.astro';
import CtaBand from '../../components/CtaBand.astro';
import FAQ from '../../components/FAQ.astro';
import { doorMaterials, openerTypes } from '../../data/products';
import { serviceSchema } from '../../lib/schema';

export function getStaticPaths() {
  return [
    ...doorMaterials.map((m) => ({
      params: { product: m.slug },
      props: { kind: 'material' as const, item: m },
    })),
    ...openerTypes.map((o) => ({
      params: { product: o.slug },
      props: { kind: 'opener' as const, item: o },
    })),
  ];
}

const { kind, item } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const url = `${site}/buyers-guide/${item.slug}/`;

const isMaterial = kind === 'material';
const siblings = isMaterial ? doorMaterials : openerTypes;
const others = siblings.filter((s) => s.slug !== item.slug);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: "Doors & Openers", href: '/buyers-guide/' },
  { name: item.shortName, href: `/buyers-guide/${item.slug}/` },
];

const relatedService = isMaterial
  ? { slug: 'new-garage-door-installation', label: 'New door installation' }
  : { slug: 'garage-door-opener-installation', label: 'Opener installation' };

const schema = serviceSchema(site, {
  name: item.name,
  description: item.metaDescription,
  url,
  slug: item.slug,
  priceLow: item.priceLow,
  priceHigh: item.priceHigh,
});
---
<BaseLayout title={item.metaTitle} description={item.metaDescription} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="p-hero">
    <div class="container p-hero-inner">
      <div>
        <span class="eyebrow">{isMaterial ? 'Door material' : 'Opener drive type'}</span>
        <div class="stripe-rule" aria-hidden="true"></div>
        <h1>{item.name}</h1>
        <p class="lead">{item.metaDescription}</p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-accent btn-lg">Get a free quote</a>
          <a href="/buyers-guide/" class="btn btn-outline btn-lg">Compare all options</a>
        </div>
      </div>
      <aside class="p-price" data-anim="fade-up">
        <span class="pp-label">Installed price</span>
        <span class="pp-value">
          ${item.priceLow.toLocaleString('en-US')} to ${item.priceHigh.toLocaleString('en-US')}
        </span>
        {!isMaterial && <span class="pp-noise">Noise: {(item as (typeof openerTypes)[number]).noise}</span>}
        <p class="pp-best"><strong>Best for:</strong> {item.bestFor}</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container p-body">
      <article class="prose">
        <AnswerBox text={item.answer} />

        {item.intro.map((p) => <p>{p}</p>)}

        <div class="pro-con">
          <div class="pc-col pros">
            <h2>What it is good at</h2>
            <ul>{item.pros.map((p) => <li>{p}</li>)}</ul>
          </div>
          <div class="pc-col cons">
            <h2>What it is bad at</h2>
            <ul>{item.cons.map((c) => <li>{c}</li>)}</ul>
          </div>
        </div>

        <QuickFacts facts={item.facts} />

        <PriceDisclaimer variant="block" />

        <FAQ items={item.faq} title={`${item.shortName} questions`} />
      </article>

      <aside class="p-aside">
        <div class="card aside-card">
          <h3>{isMaterial ? 'Other materials' : 'Other drive types'}</h3>
          <ul class="plain">
            {others.map((o) => (
              <li>
                <a href={`/buyers-guide/${o.slug}/`}>{o.shortName}</a>
                <span>from ${o.priceLow.toLocaleString('en-US')}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="card aside-card">
          <h3>Ready to fit one?</h3>
          <p class="aside-note">
            We publish the installation price and put the estimate in writing before
            anything is ordered.
          </p>
          <a href={`/services/${relatedService.slug}/`} class="btn btn-outline btn-sm">
            {relatedService.label}
          </a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .p-hero { background: var(--grad-hero); padding-block: 2.4rem 2.8rem; }
  .p-hero-inner { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 2.5rem; align-items: center; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.4rem; }

  .p-price {
    background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius);
    box-shadow: var(--shadow-card); padding: 1.75rem; position: relative; overflow: hidden;
  }
  .p-price::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 5px; background: var(--stripe-brand); }
  .pp-label {
    display: block; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--c-muted);
  }
  .pp-value {
    display: block; font-family: var(--font-display); font-weight: 400;
    font-size: 2rem; line-height: 1.1; color: var(--c-primary); margin: 0.25rem 0 0.4rem;
  }
  .pp-noise {
    display: inline-block; font-size: 0.8rem; font-weight: 700;
    background: var(--c-primary-light); color: var(--c-primary);
    padding: 0.2rem 0.6rem; border-radius: 999px;
  }
  .pp-best { font-size: 0.88rem; margin: 0.8rem 0 0; color: var(--c-body); }
  .pp-best strong { color: var(--c-ink); }

  .p-body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 2.5rem; align-items: start; }
  .p-body .prose { max-width: none; }

  .pro-con { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; margin: 2rem 0 0; }
  .pc-col h2 { margin-top: 0; font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem); }
  .pc-col ul { list-style: none; padding: 0; }
  .pc-col li { position: relative; padding-left: 1.6rem; font-size: 0.94rem; margin-bottom: 0.6rem; }
  .pros li::before { content: '✓'; position: absolute; left: 0; color: #177841; font-weight: 800; }
  .cons li::before { content: '✕'; position: absolute; left: 0; color: var(--c-accent); font-weight: 800; }

  .p-aside { position: sticky; top: 6.5rem; display: grid; gap: 1.2rem; }
  .aside-card h3 { font-size: 1rem; margin-bottom: 0.8rem; }
  .aside-note { font-size: 0.88rem; margin-bottom: 0.9rem; }
  .plain { list-style: none; padding: 0; margin: 0; }
  .plain li {
    display: flex; justify-content: space-between; gap: 0.6rem;
    padding: 0.45rem 0; border-bottom: 1px solid var(--c-line); font-size: 0.9rem;
  }
  .plain li:last-child { border-bottom: 0; }
  .plain span { color: var(--c-primary); font-weight: 700; white-space: nowrap; }

  @media (max-width: 960px) {
    .p-hero-inner { grid-template-columns: 1fr; gap: 1.8rem; }
    .p-body { grid-template-columns: 1fr; }
    .p-aside { position: static; }
  }
  @media (max-width: 620px) {
    .pro-con { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
