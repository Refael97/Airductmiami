---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import PriceDisclaimer from '../../components/PriceDisclaimer.astro';
import CtaBand from '../../components/CtaBand.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import { doorMaterials, openerTypes, brands } from '../../data/products';
import { business } from '../../data/business';

const title = `Garage Doors and Openers Buyer's Guide | New York | ${business.name}`;
const description =
  'Which garage door material and which opener drive type to choose in New York, what each costs installed, and the trade-offs nobody mentions in the showroom.';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: "Doors & Openers", href: '/buyers-guide/' },
];

const materialIcon: Record<string, string> = {
  'steel-garage-doors': 'door',
  'aluminium-garage-doors': 'door',
  'wood-garage-doors': 'install',
  'fiberglass-garage-doors': 'door',
  'vinyl-garage-doors': 'door',
};

const openerIcon: Record<string, string> = {
  'chain-drive-openers': 'opener',
  'belt-drive-openers': 'opener',
  'screw-drive-openers': 'wrench',
  'direct-drive-openers': 'opener',
  'jackshaft-wall-mount-openers': 'remote',
};

const faq = [
  {
    question: 'Which garage door material is best for New York?',
    answer:
      'Steel for most homes, because it is the cheapest strong option and handles the temperature range well. Aluminum or fiberglass on the coast, where rust is the main enemy. Wood only where the house genuinely calls for it, because it needs a heavier spring and refinishing every few years. Vinyl where the garage takes abuse.',
  },
  {
    question: 'Which opener should I choose?',
    answer:
      'Belt drive if there is living space above or beside the garage, because the noise difference is dramatic. Chain drive if the garage is detached, because nothing lasts longer for less. Jackshaft if you have low headroom, because it is often the only thing that fits.',
  },
  {
    question: 'How much should a new garage door cost in New York?',
    answer:
      'A new door installed starts at $1,056 and runs to $4,620 depending on size, material, insulation and hardware. A standard insulated steel double sits in the middle of that. Custom wood and full-view glass sit above it.',
  },
  {
    question: 'Should I repair my door or replace it?',
    answer:
      'Repair when the sections are sound and only wear parts have failed, which is most of the time. Replace when sections are rusted through or damaged beyond a matchable panel, when the garage is attached to living space and the door is uninsulated, or when the repair cost approaches half the price of a new door.',
  },
  {
    question: 'Does a new garage door add value to a house?',
    answer:
      'It is consistently one of the highest-return exterior projects in remodeling cost studies, because the door is a large part of what the street sees. That is a real effect, but it argues for buying a door that suits the house rather than the most expensive one available.',
  },
];
---
<BaseLayout title={title} description={description}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="guide-hero">
    <div class="container">
      <span class="eyebrow">Buyer's guide</span>
      <div class="stripe-rule" aria-hidden="true"></div>
      <h1>Choosing a garage door and opener</h1>
      <p class="lead">
        Two decisions, made once, that you live with for twenty years. This is the
        honest version: what each material and each drive type actually costs
        installed in New York, and what each one is bad at.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="narrow">
        <AnswerBox
          text="For most New York homes a 24 gauge insulated steel door is the right choice, installed from about $1,056 for a single and more for a double. Near salt water, aluminum or fiberglass avoids the rust problem. For the opener, choose belt drive if anyone sleeps above the garage, chain drive if the garage is detached, and a wall mounted jackshaft if there is not enough headroom for a rail."
        />
      </div>

      <h2 class="sub" id="materials">Garage door materials</h2>
      <p class="sub-lead">Five materials, ranked here by how often they are the right answer in this region.</p>
      <div class="grid grid-3">
        {doorMaterials.map((m, i) => (
          <a href={`/buyers-guide/${m.slug}/`} class="card p-card" data-anim="fade-up" data-anim-delay={String((i % 3) * 80)}>
            <span class="icon"><Icon name={materialIcon[m.slug] ?? 'door'} size={30} /></span>
            <h3>{m.shortName}</h3>
            <p>{m.bestFor}</p>
            <span class="card-price">${m.priceLow.toLocaleString('en-US')} to ${m.priceHigh.toLocaleString('en-US')} installed</span>
          </a>
        ))}
      </div>

      <h2 class="sub" id="openers">Opener drive types</h2>
      <p class="sub-lead">The drive type decides how loud the opener is, which is the thing people care about six months later.</p>
      <div class="grid grid-3">
        {openerTypes.map((o, i) => (
          <a href={`/buyers-guide/${o.slug}/`} class="card p-card" data-anim="fade-up" data-anim-delay={String((i % 3) * 80)}>
            <span class="icon"><Icon name={openerIcon[o.slug] ?? 'opener'} size={30} /></span>
            <h3>{o.shortName}</h3>
            <p>{o.bestFor}</p>
            <span class="card-meta">{o.noise}</span>
            <span class="card-price">${o.priceLow} to ${o.priceHigh} installed</span>
          </a>
        ))}
      </div>

      <h2 class="sub" id="brands">Brands we service</h2>
      <p class="sub-lead">The brands we see most in New York garages, and what typically goes wrong with each.</p>
      <ul class="brand-list">
        {brands.map((b) => (
          <li>
            <a href={`/brands/${b.slug}/`}>
              <strong>{b.name}</strong>
              <span>{b.kind === 'opener' ? 'Openers' : 'Doors'}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="narrow"><PriceDisclaimer variant="block" /></div>
      <div class="narrow"><FAQ items={faq} title="Choosing questions" /></div>
    </div>
  </section>

  <CtaBand
    heading="Not sure which one fits your garage?"
    text="Describe the opening and what is there now, and we will tell you what actually fits before anyone quotes you a door."
  />
</BaseLayout>

<style>
  .guide-hero { background: var(--grad-hero); padding-block: 2.6rem 2.4rem; }
  .guide-hero .lead { max-width: 46rem; }
  .narrow { max-width: var(--maxw-narrow); }
  .sub { margin: 2.6rem 0 0.4rem; }
  .sub-lead { color: var(--c-body); margin-bottom: 1.4rem; max-width: 46rem; }

  .p-card { display: block; text-decoration: none; }
  .p-card:hover { text-decoration: none; }
  .p-card:hover .icon { background: var(--c-primary); color: #fff; }
  .p-card .icon { transition: background 0.2s ease, color 0.2s ease; }
  .p-card h3 { color: var(--c-ink); font-size: 1.08rem; margin-bottom: 0.35rem; }
  .p-card p { color: var(--c-body); font-size: 0.9rem; margin-bottom: 0.7rem; }
  .card-meta {
    display: inline-block; font-size: 0.76rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--c-muted); margin-right: 0.5rem;
  }
  .card-price {
    display: inline-block; font-weight: 800; font-size: 0.84rem;
    color: var(--c-primary); background: var(--c-primary-light);
    padding: 0.25rem 0.6rem; border-radius: 999px;
  }

  .brand-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.8rem; }
  .brand-list li { margin: 0; }
  .brand-list a {
    display: flex; flex-direction: column; gap: 0.15rem;
    border: 1px solid var(--c-line); border-radius: 10px; padding: 0.85rem 1rem;
    background: #fff; text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .brand-list a:hover { text-decoration: none; border-color: var(--c-primary); box-shadow: var(--shadow-card); }
  .brand-list strong { color: var(--c-ink); font-size: 1rem; }
  .brand-list span { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-muted); font-weight: 700; }
</style>
