---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
import { services } from '../data/services';

const title = `Thanks, we have your request | ${business.name}`;
const description = 'We have your quote request and will come back to you with a price and an arrival window.';

const guides = services.slice(0, 4);
---
<BaseLayout title={title} description={description} noindex={true}>
  <section class="section">
    <div class="container narrow center">
      <span class="tick" aria-hidden="true"><Icon name="check" size={44} /></span>
      <h1>We have it</h1>
      <p class="lead">
        Your request is in. We will come back to you with a price range for your
        specific problem and an arrival window. Nobody is dispatched and nothing is
        charged until you have that number and have said yes.
      </p>

      <div class="next card">
        <h2>What happens next</h2>
        <ol>
          <li>We read what you sent and work out what the job actually is.</li>
          <li>You get a price range for that problem, not a generic one.</li>
          <li>You get an arrival window, and the emergency premium up front if it applies.</li>
          <li>If you go ahead, you get the estimate in writing before anything is touched.</li>
        </ol>
      </div>

      <p class="urgent">
        If your car is trapped or the door is stuck open, call {business.phone} rather
        than waiting on the reply.
      </p>

      <h2 class="reading">While you wait</h2>
      <ul class="links">
        {guides.map((s) => (
          <li><a href={`/services/${s.slug}/`}>{s.name}, from ${s.priceLow}</a></li>
        ))}
        <li><a href="/prices/">The full published price list</a></li>
      </ul>
    </div>
  </section>

  {/* The conversion event fires here rather than on form submit. A submit
      handler races the navigation and drops events; this page is only ever
      reached after a submission has actually gone through. */}
  <script is:inline>
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'generate_lead', {
        currency: 'USD',
        source: 'contact_form',
        page_path: location.pathname,
      });
    }
  </script>
</BaseLayout>

<style>
  .narrow { max-width: var(--maxw-narrow); }
  .center { text-align: center; }
  .tick {
    display: inline-flex; align-items: center; justify-content: center;
    width: 5rem; height: 5rem; border-radius: 50%;
    background: rgba(34, 163, 90, 0.12); color: #177841; margin-bottom: 1rem;
  }
  .lead { margin-inline: auto; max-width: 40rem; }
  .next { text-align: left; margin: 2rem auto; max-width: 34rem; }
  .next h2 { font-size: 1.1rem; margin-bottom: 0.7rem; }
  .next ol { padding-left: 1.2rem; margin: 0; }
  .next li { font-size: 0.94rem; margin-bottom: 0.5rem; }
  .urgent { font-weight: 700; color: var(--c-ink); }
  .reading { margin-top: 2.5rem; font-size: 1.4rem; }
  .links { list-style: none; padding: 0; display: grid; gap: 0.5rem; justify-content: center; }
</style>
