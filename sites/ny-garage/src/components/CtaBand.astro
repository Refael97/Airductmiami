---
/**
 * The closing call to action, used at the foot of every deep page.
 * Deliberately quiet: the customer is stressed and their car is stuck, so
 * the brand solves rather than sells. No urgency theater, no exclamation
 * marks. See the site character note in research/ny-garage/BRIEF.md.
 */
interface Props {
  heading?: string;
  text?: string;
  cta?: string;
}
const {
  heading = 'Tell us what happened and we will tell you what it costs',
  text = 'Free quote, no obligation, and a real arrival window if you need us today.',
  cta = 'Get a free quote',
} = Astro.props;
---
<section class="cta-band">
  <div class="container" data-anim="fade-up">
    <h2>{heading}</h2>
    <p>{text}</p>
    <a href="/contact/" class="btn btn-accent btn-lg">{cta}</a>
  </div>
</section>

<style>
  .cta-band {
    background: var(--grad-primary);
    color: #fff;
    padding-block: 3rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta-band::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 4px;
    background: var(--stripe-brand);
  }
  .cta-band h2 { color: #fff; margin-bottom: 0.5rem; }
  .cta-band p { color: #d3dded; margin-bottom: 1.3rem; }
</style>
