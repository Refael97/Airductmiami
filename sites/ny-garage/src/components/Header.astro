---
import { business } from '../data/business';

const nav = [
  { label: 'Services', href: '/services/' },
  { label: 'Prices', href: '/prices/' },
  { label: 'Doors & Openers', href: '/buyers-guide/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Guides', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];
---
<header class="site-header">
  <div class="emergency-strip">
    <div class="container">
      <span class="strip-dot" aria-hidden="true"></span>
      <span>Broken spring or car trapped? Same-day service, seven days a week.</span>
    </div>
  </div>

  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${business.name} home`}>
      <img src="/logo.svg" alt="" width="44" height="44" class="brand-mark" />
      <span class="brand-word">
        <span class="bw-top">{business.name}</span>
        <span class="bw-sub">Reliable · Local · Professional</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Main">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>

    <a href="/contact/" class="btn btn-accent header-cta">Free quote</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 500;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .emergency-strip {
    background: var(--c-primary); color: #e7edf5;
    font-size: 0.82rem; font-weight: 600;
    padding: 0.45rem 0;
    position: relative;
  }
  /* Diagonal garage-door stripe along the top edge, decorative */
  .emergency-strip::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 3px;
    background: var(--stripe-brand);
  }
  .emergency-strip .container { display: flex; align-items: center; gap: 0.5rem; justify-content: center; text-align: center; }
  .strip-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--c-accent); flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(214, 40, 40, 0.32);
  }

  .header-inner {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem;
    padding-block: 0.7rem;
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; flex-shrink: 0; }
  .brand:hover { text-decoration: none; }
  .brand-word { display: flex; flex-direction: column; line-height: 1.1; }
  .bw-top {
    font-family: var(--font-display); font-weight: 400; font-size: 1.5rem;
    line-height: 1; color: var(--c-primary);
    text-transform: uppercase; letter-spacing: 0.015em;
  }
  .bw-sub {
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--c-muted);
  }

  .site-nav { display: flex; gap: 1.35rem; margin-left: auto; }
  .site-nav a {
    color: var(--c-body); font-weight: 600; font-size: 0.94rem; text-decoration: none;
    padding-block: 0.3rem; border-bottom: 2px solid transparent;
  }
  .site-nav a:hover { color: var(--c-primary); border-bottom-color: var(--c-accent); text-decoration: none; }

  .header-cta { flex-shrink: 0; min-height: 46px; padding-inline: 1.3rem; }

  @media (max-width: 960px) {
    .site-nav { order: 3; width: 100%; margin-left: 0; gap: 0; flex-wrap: wrap; }
    .site-nav a {
      flex: 1 1 33%; padding: 0.5rem 0.3rem;
      display: flex; align-items: center; justify-content: center;
      min-height: 2.9rem; text-align: center; line-height: 1.2;
      border-bottom: 1px solid var(--c-line); font-size: 0.85rem;
    }
    .header-cta { margin-left: auto; }
    .emergency-strip { font-size: 0.75rem; }
  }

  /* On a phone the brand block and the CTA must share one row, so the
     tagline is dropped and the wordmark steps down a size. */
  @media (max-width: 620px) {
    .header-inner { gap: 0.6rem; padding-block: 0.55rem; }
    .brand { gap: 0.45rem; }
    .brand-mark { width: 36px; height: 36px; }
    .bw-top { font-size: 1.28rem; }
    .bw-sub { display: none; }
    .header-cta { min-height: 42px; padding-inline: 1rem; font-size: 0.92rem; }
    .site-nav a { font-size: 0.8rem; min-height: 2.7rem; }
  }
</style>
