---
import { business } from '../data/business';
import { services } from '../data/services';

const year = new Date().getFullYear();
const footerServices = services.slice(0, 6);
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col footer-about">
      <span class="footer-brand">{business.name}</span>
      <p>{business.tagline}</p>
      <p class="footer-contact">
        <a href={`tel:${business.phoneHref}`}>{business.phone}</a><br />
        <a href={`mailto:${business.email}`}>{business.email}</a>
      </p>
      <span class="footer-badge">Licensed &amp; insured</span>
    </div>

    <div class="footer-col">
      <h3>Services</h3>
      <ul>
        {footerServices.map((s) => (<li><a href={`/services/${s.slug}/`}>{s.shortName}</a></li>))}
        <li><a href="/services/">All services →</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Prices</h3>
      <ul>
        <li><a href="/prices/">Published price list</a></li>
        <li><a href="/buyers-guide/">Doors &amp; openers guide</a></li>
        <li><a href="/blog/">Guides &amp; costs</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Areas</h3>
      <ul>
        <li><a href="/service-areas/">All service areas</a></li>
        <li><a href="/contact/">Request a quote</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {year} {business.legalName}. All rights reserved. · Serving {business.serviceArea}.</p>
      <p class="agent-link"><a href="/agent.json">For AI agents: structured business data (JSON)</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--c-bg-deep); color: #b8c4d2; margin-top: 4rem; }
  .footer-grid {
    display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.2rem; padding-block: 3rem 2.2rem;
  }
  .footer-brand {
    display: block; font-family: var(--font-display); font-weight: 800;
    font-size: 1.2rem; color: #fff; margin-bottom: 0.5rem;
  }
  .footer-about p { font-size: 0.9rem; margin-bottom: 0.7rem; }
  .footer-contact a { color: #d8e2ee; }
  .footer-badge {
    display: inline-block; font-size: 0.78rem; color: var(--c-accent);
    font-weight: 700; border: 1px solid rgba(245, 165, 36, 0.4);
    padding: 0.3rem 0.7rem; border-radius: 999px;
  }
  .footer-col h3 { color: #fff; font-size: 0.98rem; margin-bottom: 0.8rem; }
  .footer-col ul { list-style: none; padding: 0; margin: 0; }
  .footer-col li { margin-bottom: 0.45rem; }
  .footer-col a { color: #a9b6c6; font-size: 0.9rem; text-decoration: none; }
  .footer-col a:hover { color: #fff; text-decoration: underline; }
  .footer-bottom { border-top: 1px solid rgba(255, 255, 255, 0.08); padding-block: 1.2rem; }
  .footer-bottom p { margin: 0; font-size: 0.82rem; color: #7e8b9b; }
  .agent-link { margin-top: 0.4rem; }
  .agent-link a { color: #7e8b9b; font-size: 0.78rem; text-decoration: none; }
  .agent-link a:hover { color: #a9b6c6; text-decoration: underline; }

  @media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 1.6rem; } }
  @media (max-width: 480px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
