---
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
import '@fontsource/bebas-neue';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Reveal from '../components/Reveal.astro';
import { localBusinessSchema, websiteSchema } from '../lib/schema';
import { business } from '../data/business';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  noindex?: boolean;
}

const { title, description, canonical, schema, ogType = 'website', noindex = false } = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
/** One canonical URL form: trailing slash, matching the sitemap and the edge redirect. */
const withSlash = (p: string) => (p.endsWith('/') || /\.\w+$/.test(p) ? p : `${p}/`);
const canonicalURL = `${site}${withSlash(canonical ?? Astro.url.pathname)}`;
const ogImage = `${site}/og-image.png`;

const siteSchema = [localBusinessSchema(site), websiteSchema(site)];
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Reveal animations only apply when scripting is on, so nothing can
         stay invisible if the script never runs. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="generator" content={Astro.generator} />
    <meta name="geo.region" content="US-NY" />
    <meta name="geo.placename" content="New York" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <JsonLd schema={siteSchema} />
    {schema && <JsonLd schema={schema} />}

    <!-- GA4. Loaded async so it never blocks rendering, and skipped entirely
         on localhost so development traffic does not pollute the property. -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${business.ga4Id}`}></script>
    <script is:inline define:vars={{ gaId: business.ga4Id }}>
      (function () {
        var host = location.hostname;
        if (host === 'localhost' || host === '127.0.0.1' || host === '') return;

        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId);

        /* Phone taps, captured by delegation so the listener survives any
           number of tel: links being added to any page later. Capture phase,
           because the click navigates away immediately. */
        document.addEventListener(
          'click',
          function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
            if (a) gtag('event', 'phone_call', { page_path: location.pathname });
          },
          true
        );
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Reveal />
  </body>
</html>
