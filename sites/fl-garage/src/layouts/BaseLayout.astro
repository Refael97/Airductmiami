---
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
import '@fontsource/bebas-neue';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PromoPopup from '../components/PromoPopup.astro';
import BookingModal from '../components/BookingModal.astro';
import BookingScript from '../components/BookingScript.astro';
import HelpChat from '../components/HelpChat.astro';
import JsonLd from '../components/JsonLd.astro';
import Reveal from '../components/Reveal.astro';
import { localBusinessSchema, websiteSchema } from '../lib/schema';
import { business } from '../data/business';
import { ui, paths, type Locale } from '../data/ui';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  noindex?: boolean;
  lang?: Locale;
  /** Path (no origin) of this same page in the other language, for hreflang and the switcher. */
  altHref?: string;
}

const {
  title,
  description,
  canonical,
  schema,
  ogType = 'website',
  noindex = false,
  lang = 'en',
  altHref,
} = Astro.props;

const t = ui[lang];
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
/** One canonical URL form: trailing slash, matching the sitemap and the edge redirect. */
const withSlash = (p: string) => (p.endsWith('/') || /\.\w+$/.test(p) ? p : `${p}/`);
const canonicalURL = `${site}${withSlash(canonical ?? Astro.url.pathname)}`;
const ogImage = `${site}/og-image.png`;

const currentPath = withSlash(Astro.url.pathname);
/* Normalise the alternate once, here, and hand the same form to hreflang
   and to the header switcher. A slashless alternate is a 301 hop for the
   crawler and a second URL form for Google to consider. */
const altPath = altHref ? withSlash(altHref) : undefined;
/* A noindexed page has no business declaring hreflang. */
const emitHreflang = !noindex;
const enHref = lang === 'en' ? currentPath : altPath;
const esHref = lang === 'es' ? currentPath : altPath;
/* The switcher always has somewhere to go: the translation when one
   exists, the other language's home page when it does not. */
const switchHref = altPath ?? paths[lang === 'en' ? 'es' : 'en'].home;

const siteSchema = [localBusinessSchema(site, lang), websiteSchema(site, lang)];
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Reveal animations only apply when scripting is on, so nothing can
         stay invisible if the script never runs. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {emitHreflang && enHref && <link rel="alternate" hreflang="en" href={`${site}${enHref}`} />}
    {emitHreflang && esHref && <link rel="alternate" hreflang="es" href={`${site}${esHref}`} />}
    {emitHreflang && enHref && <link rel="alternate" hreflang="x-default" href={`${site}${enHref}`} />}

    <meta name="generator" content={Astro.generator} />
    <meta name="geo.region" content="US-FL" />
    <meta name="geo.placename" content="Florida" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content={t.ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <JsonLd schema={siteSchema} />
    {schema && <JsonLd schema={schema} />}

    <!-- GA4. Loaded async so it never blocks rendering, and skipped entirely
         on localhost so development traffic does not pollute the property. -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${business.ga4Id}`}></script>
    <script is:inline define:vars={{ gaId: business.ga4Id, adsId: business.adsId, adsSendTo: business.adsLeadSendTo, keyValue: business.keyEventValue, keyCurrency: business.keyEventCurrency, lang }}>
      (function () {
        var host = location.hostname;
        if (host === 'localhost' || host === '127.0.0.1' || host === '') return;

        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId, { site_language: lang });

        /* The Google Ads account that pays for the clicks needs its own
           config line. One gtag.js serves several destinations, but only the
           ones it has been configured for. Skipped entirely while
           business.adsId is empty, so this is inert until there is an
           account rather than being a broken tag that looks installed. */
        if (adsId) gtag('config', adsId);

        /* One lead, one conversion, minted at submit and carried to
           wherever the lead is confirmed. Both sends of the same lead
           therefore carry the same transaction_id and Google keeps one; a
           fresh random id per call would satisfy the field and defeat the
           point of having it. */
        function gdNewLeadId() {
          return 'lead-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10);
        }
        function gdLeadConversion(id) {
          if (!adsSendTo) return;
          try {
            gtag('event', 'conversion', {
              send_to: adsSendTo,
              value: 1.0,
              currency: 'USD',
              transaction_id: id || gdNewLeadId(),
            });
          } catch (err) {
            /* analytics blocked: the lead still reached the inbox */
          }
        }
        window.gdNewLeadId = gdNewLeadId;
        window.gdLeadConversion = gdLeadConversion;

        /* Phone taps, captured by delegation so the listener survives any
           number of tel: links being added to any page later. Capture phase,
           because the click navigates away immediately.

           What this records and what it does not: someone opened their
           dialler. It cannot tell you whether they pressed call, whether it
           connected, or how long it lasted. Knowing that needs a call
           tracking number that records the call itself. The event is named
           `phone_call` because that is the key event the owner created in
           the property on 19 September, and the site sends what the property
           is set up to receive; the limit above is the one to remember when
           reading the number, and it is why this is a floor on calls rather
           than a count of them.

           It used to send two events on one tap, `phone_call_tap` with the
           detail and `phone_call` without it. Two names for one click is how
           a property ends up with two different call numbers and no way to
           say which is right, so there is now one event carrying everything.

           The three parameters are what make it usable. `phone_number`
           separates the technician's direct line in the help widget from the
           published number in the header and footer. `placement` says which
           surface earned it, derived from where the link sits rather than
           from a hand maintained attribute on every link. `page_path` says
           which page the visitor was reading when they gave up on the web
           and reached for the phone, which is the one that tells you where
           the site is failing to answer a question. */
        function placementOf(a) {
          if (a.closest('[data-help-chat]')) return 'help_widget';
          if (a.closest('header')) return 'header';
          if (a.closest('footer')) return 'footer';
          if (a.closest('.promo-card')) return 'promo_popup';
          if (a.closest('dialog')) return 'booking_modal';
          if (a.closest('aside')) return 'sidebar';
          return 'page_body';
        }

        document.addEventListener(
          'click',
          function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
            if (!a) return;
            gtag('event', 'phone_call', {
              /* Both, or the event counts in Analytics and never reaches
                 Google Ads. See business.keyEventValue. */
              value: keyValue,
              currency: keyCurrency,
              phone_number: a.getAttribute('href').replace('tel:', ''),
              placement: placementOf(a),
              page_path: location.pathname,
              site_language: lang,
            });
          },
          true
        );

        /* The lead event is `new_lead`, which is the key event the owner
           created in the property on 19 September. It replaced
           `generate_lead`, GA4's recommended name for the same thing, and
           the trade is deliberate: the recommended name buys a section in
           GA4's default reports, and sending both names would mean two lead
           counts in one property with nothing to say which is right. The
           property decides the name; one action sends one event.

           That event used to fire on every load of a thank-you page, which
           counted refreshes, back-button returns and anyone who bookmarked
           it. On the sister site the same bug turned 13 real leads into 26
           recorded ones: the number the business steers by, at roughly twice
           the truth. This site had it too.

           So a lead form leaves a note on its way out and the thank-you
           page fires only if it finds one, then eats it. No note, no
           conversion. A refresh finds nothing, a direct visit finds nothing.

           Keyed on site_id rather than on data-netlify, because site_id is
           the network lead contract that every lead form carries (see
           LeadMeta.astro) and it stays true if this site ever posts to a
           direct endpoint instead. The popup is excluded: it submits over
           fetch, stays on the page and reports itself, and without the
           exclusion its note would sit in storage and fire on some
           unrelated visit to /thank-you/ weeks later. */
        var LEAD_KEY = 'gdLeadPending';
        /* Bubble phase, not capture, and this is the whole reason: the quote
           wizard validates in its own submit handler and calls
           preventDefault on an out-of-area ZIP, a too-fast fill or a sales
           pitch. A capture listener runs before that and would write a note
           for a submission the browser never sent, which would then fire a
           false conversion if the visitor reached the thank-you page by any
           other route inside ten minutes. Here the form has already had its
           say, and defaultPrevented tells us what it decided. */
        document.addEventListener(
          'submit',
          function (e) {
            if (e.defaultPrevented) return;
            var f = e.target;
            if (!f || f.id === 'promo-form') return;
            if (!f.querySelector('[name="site_id"]')) return;
            function val(name) {
              var el = f.querySelector('[name="' + name + '"]');
              if (el && el.type === 'radio') {
                var picked = f.querySelector('[name="' + name + '"]:checked');
                el = picked || null;
              }
              return el && el.value ? String(el.value).slice(0, 60) : '';
            }
            try {
              sessionStorage.setItem(LEAD_KEY, JSON.stringify({
                t: Date.now(),
                lead_id: gdNewLeadId(),
                /* Both, or the event counts in Analytics and never reaches
                   Google Ads. See business.keyEventValue. */
                value: keyValue,
                currency: keyCurrency,
                form_type: val('form-name') || 'quote',
                /* Three ways this site describes a job, and they answer
                   different questions: what was ordered, what kind of door
                   work it is, and what is actually wrong with it. */
                service: val('service'),
                job_type: val('job_type'),
                symptom: val('symptom'),
                /* The geography this site collects is a ZIP, not a city.
                   lead_city is kept in the shape so one report can cover
                   both sites, and left empty rather than guessed. */
                lead_city: '',
                lead_zip: val('zip'),
                /* Whether they picked a slot in the scheduler, not which
                   slot: a raw appointment is a distinct value per lead and
                   would burn a custom dimension on something unreportable.
                   The exact time is in the lead email, where it is needed.

                   This replaced `urgency`, which was collected here for
                   three days and was always empty. Its select lives inside
                   .wz-fallback, which BookingScript removes from the DOM the
                   moment it runs, so only a visitor with JavaScript off ever
                   answers it. Netlify still lists the field from the static
                   HTML at deploy time, which is why it shows up blank in
                   every lead email and looked like a field people were
                   skipping rather than one they were never shown. */
                booked_slot: val('appointment') ? 'yes' : 'no',
                source: val('source'),
                site_language: val('locale') || lang,
                page_path: val('page') || location.pathname,
              }));
            } catch (err) {
              /* private mode: the lead still sends, it just goes uncounted */
            }
          },
          false
        );

        if (/^\/(thank-you|es\/gracias)\/?$/.test(location.pathname)) {
          try {
            var raw = sessionStorage.getItem(LEAD_KEY);
            if (raw) {
              sessionStorage.removeItem(LEAD_KEY);
              var lead = JSON.parse(raw);
              /* A note older than ten minutes is not this visit's lead. */
              if (Date.now() - lead.t < 600000) {
                delete lead.t;
                /* Carried for Google Ads only, so the GA4 event keeps
                   exactly the parameter shape the custom dimensions in
                   docs/GA4-CONVERSIONS-GARAGE.md are registered against. */
                var leadId = lead.lead_id;
                delete lead.lead_id;
                gtag('event', 'new_lead', lead);
                gdLeadConversion(leadId);
              }
            }
          } catch (err) {
            /* unreadable note: better to miss one than to invent one */
          }
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="visually-hidden">{t.skipToContent}</a>
    <Header lang={lang} switchHref={switchHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <PromoPopup lang={lang} />
    <BookingModal lang={lang} />
    {/* Last, so every form on the page already exists when it runs: the
        inline one on the contact page and the copy inside the modal. */}
    <BookingScript lang={lang} />
    <HelpChat lang={lang} />
    <Reveal />
  </body>
</html>
