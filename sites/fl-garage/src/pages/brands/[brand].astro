---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import PriceDisclaimer from '../../components/PriceDisclaimer.astro';
import CtaBand from '../../components/CtaBand.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import { brands } from '../../data/products';
import { getService } from '../../data/services';
import { serviceSchema } from '../../lib/schema';

export function getStaticPaths() {
  return brands.map((b) => ({ params: { brand: b.slug }, props: { brand: b } }));
}

const { brand } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const url = `${site}/brands/${brand.slug}/`;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: "Doors & Openers", href: '/buyers-guide/' },
  { name: brand.name, href: `/brands/${brand.slug}/` },
];

const isOpener = brand.kind === 'opener';
const repair = getService(isOpener ? 'garage-door-opener-repair' : 'garage-door-panel-replacement')!;
const install = getService(isOpener ? 'garage-door-opener-installation' : 'new-garage-door-installation')!;
const others = brands.filter((b) => b.slug !== brand.slug);

const schema = serviceSchema(site, {
  name: `${brand.name} Garage ${isOpener ? 'Door Opener' : 'Door'} Repair`,
  description: brand.metaDescription,
  url,
  slug: brand.slug,
  priceLow: repair.priceLow,
  priceHigh: install.priceHigh,
});
---
<BaseLayout title={brand.metaTitle} description={brand.metaDescription} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="b-hero">
    <div class="container">
      <span class="eyebrow">{isOpener ? 'Opener brand' : 'Door brand'}</span>
      <div class="stripe-rule" aria-hidden="true"></div>
      <h1>{brand.name} {isOpener ? 'opener' : 'door'} repair and installation</h1>
      <p class="lead">{brand.metaDescription}</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-accent btn-lg">Get a free quote</a>
        <a href="/prices/" class="btn btn-outline btn-lg">See the price list</a>
      </div>
      <p class="disclosure">
        We are an independent repair company. We are not affiliated with {brand.name}
        and we do not represent them. We service and install their products.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container b-body">
      <article class="prose">
        <AnswerBox text={brand.answer} />

        {brand.intro.map((p) => <p>{p}</p>)}

        <h2>What usually goes wrong with {brand.name}</h2>
        <ul class="check-list">
          {brand.common.map((c) => <li>{c}</li>)}
        </ul>

        <h2>What it costs</h2>
        <div class="two-prices">
          <a href={`/services/${repair.slug}/`} class="price-tile">
            <span class="pt-ico"><Icon name="wrench" size={26} /></span>
            <span class="pt-label">{repair.shortName}</span>
            <span class="pt-price">from ${repair.priceLow}</span>
          </a>
          <a href={`/services/${install.slug}/`} class="price-tile">
            <span class="pt-ico"><Icon name="install" size={26} /></span>
            <span class="pt-label">{install.shortName}</span>
            <span class="pt-price">from ${install.priceLow.toLocaleString('en-US')}</span>
          </a>
        </div>

        <PriceDisclaimer variant="block" />

        <FAQ items={brand.faq} title={`${brand.name} questions`} />
      </article>

      <aside class="b-aside">
        <div class="card aside-card">
          <h3>Other brands we service</h3>
          <ul class="plain">
            {others.map((b) => (
              <li>
                <a href={`/brands/${b.slug}/`}>{b.name}</a>
                <span>{b.kind === 'opener' ? 'Openers' : 'Doors'}</span>
              </li>
            ))}
          </ul>
          <a href="/buyers-guide/" class="aside-more">Buyer's guide →</a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .b-hero { background: var(--grad-hero); padding-block: 2.6rem 2.4rem; }
  .b-hero .lead { max-width: 46rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.3rem; }
  .disclosure { font-size: 0.82rem; color: var(--c-muted); margin: 1.1rem 0 0; max-width: 46rem; }

  .b-body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 2.5rem; align-items: start; }
  .b-body .prose { max-width: none; }

  .two-prices { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; margin: 1.2rem 0 0; }
  .price-tile {
    display: flex; flex-direction: column; gap: 0.25rem; text-decoration: none;
    background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius);
    box-shadow: var(--shadow-card); padding: 1.2rem 1.3rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .price-tile:hover { text-decoration: none; border-color: var(--c-primary); box-shadow: var(--shadow-card-hover); }
  .pt-ico {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.6rem; height: 2.6rem; border-radius: 10px;
    background: var(--c-primary-light); color: var(--c-primary); margin-bottom: 0.4rem;
  }
  .pt-label { font-weight: 700; color: var(--c-ink); font-size: 0.95rem; }
  .pt-price { font-family: var(--font-display); font-size: 1.7rem; line-height: 1.1; color: var(--c-primary); }

  .b-aside { position: sticky; top: 6.5rem; }
  .aside-card h3 { font-size: 1rem; margin-bottom: 0.8rem; }
  .plain { list-style: none; padding: 0; margin: 0; }
  .plain li {
    display: flex; justify-content: space-between; gap: 0.6rem;
    padding: 0.45rem 0; border-bottom: 1px solid var(--c-line); font-size: 0.9rem;
  }
  .plain li:last-child { border-bottom: 0; }
  .plain span { color: var(--c-muted); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; }
  .aside-more { display: inline-block; margin-top: 0.9rem; font-size: 0.88rem; font-weight: 700; }

  @media (max-width: 960px) {
    .b-body { grid-template-columns: 1fr; }
    .b-aside { position: static; }
  }
</style>
