---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { business } from '../../data/business';

const title = `Garage Door Guides and Costs | New York | ${business.name}`;
const description =
  'Straight answers on garage door costs, symptoms, maintenance, safety and how to spot a bait quote, written for New York homes.';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Guides', href: '/blog/' },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const clusters = [
  { key: 'cost', label: 'What things cost', blurb: 'Real New York numbers, not national averages.' },
  { key: 'symptom', label: 'Something is wrong', blurb: 'Work out what has failed before anyone quotes you.' },
  { key: 'maintenance', label: 'Lifespan and maintenance', blurb: 'How long parts last and what shortens them.' },
  { key: 'safety', label: 'Safety', blurb: 'What is genuinely dangerous and what is not.' },
  { key: 'trust', label: 'Hiring and trust', blurb: 'How to tell an honest quote from a bait quote.' },
  { key: 'product', label: 'Choosing doors and openers', blurb: 'Comparisons for the replacement decision.' },
] as const;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={title} description={description}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="blog-hero">
    <div class="container">
      <span class="eyebrow">Guides</span>
      <div class="stripe-rule" aria-hidden="true"></div>
      <h1>Garage door guides and costs</h1>
      <p class="lead">
        Written to answer the question rather than to get you on the phone. If a
        guide here saves you a call, that is a fair outcome.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {clusters.map((c) => {
        const list = posts.filter((p) => p.data.cluster === c.key);
        if (list.length === 0) return null;
        return (
          <div class="cluster" data-anim="fade-up">
            <div class="cluster-head">
              <h2>{c.label}</h2>
              <p>{c.blurb}</p>
            </div>
            <div class="grid grid-3">
              {list.map((p) => (
                <a href={`/blog/${p.slug}/`} class="card post-card">
                  <h3>{p.data.title}</h3>
                  <p>{p.data.description}</p>
                  <span class="meta">{fmt(p.data.pubDate)}</span>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .blog-hero { background: var(--grad-hero); padding-block: 2.6rem 2.4rem; }
  .cluster { margin-bottom: 2.8rem; }
  .cluster-head { margin-bottom: 1.2rem; }
  .cluster-head h2 { margin-bottom: 0.2rem; }
  .cluster-head p { color: var(--c-body); margin: 0; }
  .post-card { display: block; text-decoration: none; }
  .post-card:hover { text-decoration: none; }
  .post-card h3 { color: var(--c-ink); font-size: 1.05rem; margin-bottom: 0.4rem; }
  .post-card p { color: var(--c-body); font-size: 0.9rem; margin-bottom: 0.7rem; }
  .meta { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-muted); font-weight: 700; }
</style>
