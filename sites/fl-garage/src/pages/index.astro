---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import PriceDisclaimer from '../components/PriceDisclaimer.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
import { services, getService, priceTableOrder } from '../data/services';
import { iconFor } from '../data/serviceIcons';

const title = `Garage Door Repair in New York | Published Prices | ${business.name}`;
const description = `Same-day garage door repair across Long Island, Westchester, Staten Island, Queens and Brooklyn. We publish our starting prices: spring replacement from $170, opener installation from $281. Written estimate before any work.`;

const priceRows = priceTableOrder
  .map((slug) => getService(slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const emergencyServices = services.filter((s) => s.emergency);

const homeFaq = [
  { question: 'How much does garage door repair cost in New York?', answer: 'Spring replacement starts at $170 per spring, cable repair at $100, opener repair at $100, and opener installation at $281. Those are starting prices for a standard single door. A double door, an unusual model, or additional worn parts will cost more, and you get a written quote before any work starts.' },
  { question: 'Do you offer same-day garage door repair?', answer: 'Yes, seven days a week across the metro area. You get a real arrival window and the pricing before we dispatch, including the emergency call-out cost of $200 to $350.' },
  { question: 'Can I still use my garage door with a broken spring?', answer: 'No. Do not run the opener, because it will strain the motor, bend panels, and can drop the door. Leave it and call us.' },
  { question: 'Do you charge a service call fee to come out?', answer: 'We quote before we dispatch and the number does not change on arrival. We do not use a low advertised call-out fee as a way to get in the door and then inflate the bill.' },
  { question: 'Are you licensed and insured?', answer: 'Yes, and every job comes with a written estimate before work starts plus a one year warranty on parts and labor.' },
];
---
<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy" data-anim="slide-left">
        <span class="eyebrow">Serving {business.serviceArea}</span>
        <div class="stripe-rule" aria-hidden="true"></div>
        <h1>Here is what it costs.<br /><span class="hl">Before you call.</span></h1>
        <p class="lead">
          Garage door repair across Long Island, Westchester, Staten Island, Queens and
          Brooklyn. Starting prices published up front, a written estimate before
          anything is touched, and the price we quote is the price you pay.
        </p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-accent btn-lg">Get a free quote</a>
          <a href="/prices/" class="btn btn-outline btn-lg">See the full price list</a>
        </div>
        <ul class="hero-trust">
          <li>Same-day service</li>
          <li>Written estimate first</li>
          <li>Licensed &amp; insured</li>
          <li>1 year parts &amp; labor</li>
        </ul>
      </div>

      <aside class="hero-panel" aria-labelledby="price-panel-title" data-anim="fade-up" data-anim-delay="120">
        <div class="panel-head">
          <h2 id="price-panel-title">What repairs actually cost</h2>
          <p>Real New York starting prices. No "call for pricing".</p>
        </div>
        <table class="price-table">
          <tbody>
            {priceRows.slice(0, 5).map((s) => (
              <tr>
                <th scope="row"><a href={`/services/${s.slug}/`}>{s.shortName}</a></th>
                <td>from ${s.priceLow}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <PriceDisclaimer />
        <a href="/prices/" class="panel-link">Full price list, every service →</a>
      </aside>
    </div>
  </section>

  <!-- Trust strip. Every claim here is verifiable. No rating and no review
       count until real reviews exist, per docs/TRUST-AND-CLAIMS.md. -->
  <section class="trust-band">
    <div class="container trust-strip" data-anim="fade-up">
      <span class="trust-badge"><span class="tb-ico"><Icon name="shield" size={16} /></span>Licensed &amp; insured</span>
      <span class="trust-badge"><span class="tb-ico"><Icon name="truck" size={16} /></span>Same-day service</span>
      <span class="trust-badge"><span class="tb-ico"><Icon name="quote" size={16} /></span>Written estimate first</span>
      <span class="trust-badge"><span class="tb-ico"><Icon name="pin" size={16} /></span>Local NY technicians</span>
      <span class="trust-badge"><span class="tb-ico"><Icon name="check" size={16} /></span>1 year parts &amp; labor</span>
    </div>
  </section>

  <!-- Emergency band. The photograph sits behind a heavy navy wash: it is
       atmosphere, not evidence, and the text must stay readable over it. -->
  <section class="emergency-band">
    <div class="container">
      <div class="band-copy">
        <h2>Car trapped? Door stuck open?</h2>
        <p>
          Same-day emergency service, seven days a week. The call-out premium is
          $200 to $350 and it is stated before we dispatch. The repair itself is quoted
          at the same published price as any other day.
        </p>
      </div>
      <div class="band-actions">
        <a href="/services/emergency-garage-door-repair/" class="btn btn-accent">Emergency service</a>
        <div class="band-services">
          {emergencyServices.filter((s) => s.slug !== 'emergency-garage-door-repair').map((s) => (
            <a href={`/services/${s.slug}/`}>{s.shortName}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">What we do</span>
        <div class="stripe-rule" aria-hidden="true"></div>
        <h2>Garage door repair and installation</h2>
        <p class="lead">Every service below has its starting price published on its own page, with what changes it.</p>
      </div>
      <div class="grid grid-3">
        {services.map((s, i) => (
          <a
            href={`/services/${s.slug}/`}
            class="card service-card"
            data-anim="fade-up"
            data-anim-delay={String((i % 3) * 90)}
          >
            <span class="icon"><Icon name={iconFor(s.slug)} size={30} /></span>
            <h3>{s.name}</h3>
            <p>{s.answer.split('. ')[0]}.</p>
            <span class="card-price">from ${s.priceLow}</span>
          </a>
        ))}
      </div>
      <div class="narrow"><PriceDisclaimer variant="block" /></div>
    </div>
  </section>

  <!-- The doors we work on.
       These are illustrations of the door types common to each part of the
       metro area, not photographs of our own jobs. The caption says so.
       Per docs/MEDIA-STANDARD.md, generated imagery may illustrate and may
       not impersonate: the day a real job produces photos, they go in a
       gallery of their own and are labelled as ours. -->
  <section class="section section-alt doors-band">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Every kind of door</span>
        <div class="stripe-rule" aria-hidden="true"></div>
        <h2>New York does not have one kind of garage</h2>
        <p class="lead">
          A narrow single under a Brooklyn stoop and a carriage house door on a
          Westchester colonial are different jobs with different parts and
          different prices. That is why the price list says "starting at".
        </p>
      </div>

      <div class="door-grid">
        <a href="/service-areas/brooklyn/" class="door-card" data-anim="fade-up">
          <img
            src="/images/brooklyn-under-house-single-door.webp"
            width="1200" height="896" loading="lazy" decoding="async"
            alt="Narrow single garage door under the living space of an attached brick house, the typical arrangement in Bay Ridge and Marine Park"
          />
          <div class="door-meta">
            <h3>Under-house singles</h3>
            <p>Brooklyn and Staten Island. Low headroom, which usually means a wall mounted opener.</p>
          </div>
        </a>

        <a href="/service-areas/westchester-county/" class="door-card" data-anim="fade-up" data-anim-delay="90">
          <img
            src="/images/westchester-carriage-doors.webp"
            width="1200" height="896" loading="lazy" decoding="async"
            alt="Carriage house style wooden garage doors with strap hinges on a detached three-bay garage, common in Westchester County"
          />
          <div class="door-meta">
            <h3>Carriage and wood</h3>
            <p>Westchester and Garden City. Heavier than steel, so the spring specification changes.</p>
          </div>
        </a>

        <a href="/service-areas/nassau-county/" class="door-card" data-anim="fade-up" data-anim-delay="180">
          <img
            src="/images/long-island-split-level-door.webp"
            width="1200" height="896" loading="lazy" decoding="async"
            alt="Modern flush panel white steel garage door on the attached garage of a 1960s Long Island split level house"
          />
          <div class="door-meta">
            <h3>Postwar Long Island</h3>
            <p>Nassau and Suffolk. Mostly doors installed once in the 1990s and never serviced since.</p>
          </div>
        </a>
      </div>

      <p class="media-note">
        Images above illustrate the door types common to each area. They are not
        photographs of our own work. When our jobs produce real before and after
        photos, they will appear here with the city and the service named.
      </p>

      <p class="text-center" style="margin-top:1.2rem;">
        <a href="/buyers-guide/" class="btn btn-outline">Compare doors and openers</a>
      </p>
    </div>
  </section>

  <!-- What actually breaks. The door-type grid above serves installation
       intent; this serves repair intent, which the keyword data puts at
       roughly ten times the volume. Each card links to the service and
       carries its published starting price. -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">What actually breaks</span>
        <div class="stripe-rule" aria-hidden="true"></div>
        <h2>Four failures cover most of what we are called out for</h2>
        <p class="lead">
          If one of these looks like your garage, the price is already on this
          page. You should not have to let anyone in to find out what it costs.
        </p>
      </div>

      <div class="fault-grid">
        <a href="/services/garage-door-spring-replacement/" class="door-card" data-anim="fade-up">
          <img
            src="/images/broken-torsion-spring.webp"
            width="1400" height="781" loading="lazy" decoding="async"
            alt="Snapped garage door torsion spring on its shaft, showing the gap where the coil separated and the splayed ends either side of the break"
          />
          <div class="door-meta">
            <h3>Broken torsion spring</h3>
            <p>A loud bang, then a door too heavy to lift. The most common call we take.</p>
            <span class="fault-price">from $170</span>
          </div>
        </a>

        <a href="/services/garage-door-off-track-repair/" class="door-card" data-anim="fade-up" data-anim-delay="90">
          <img
            src="/images/garage-door-off-track.webp"
            width="1200" height="896" loading="lazy" decoding="async"
            alt="Residential garage door with the top section pulled out of its vertical track and leaning inward, the roller clearly out of the rail"
          />
          <div class="door-meta">
            <h3>Off the track</h3>
            <p>The door binds, leans, or jams halfway. Do not run the opener again.</p>
            <span class="fault-price">from $150</span>
          </div>
        </a>

        <a href="/services/garage-door-cable-repair/" class="door-card" data-anim="fade-up" data-anim-delay="180">
          <img
            src="/images/frayed-lift-cable.webp"
            width="1200" height="896" loading="lazy" decoding="async"
            alt="Frayed galvanised garage door lift cable at the bottom bracket, individual wire strands broken and splayed outward with rust staining"
          />
          <div class="door-meta">
            <h3>Frayed or snapped cable</h3>
            <p>Fraying is visible for months before it goes. Worth catching early.</p>
            <span class="fault-price">from $100</span>
          </div>
        </a>

        <a href="/services/garage-door-tune-up/" class="door-card" data-anim="fade-up" data-anim-delay="270">
          <img
            src="/images/worn-garage-door-rollers.webp"
            width="1200" height="896" loading="lazy" decoding="async"
            alt="Worn garage door roller in its hinge, the nylon wheel cracked and the bearing seized, with grease staining around the stem and track"
          />
          <div class="door-meta">
            <h3>Worn rollers and hinges</h3>
            <p>Grinding, rattling, a door that shudders. This is what maintenance catches.</p>
            <span class="fault-price">from $95</span>
          </div>
        </a>
      </div>

      <p class="media-note">
        Images above illustrate the failures described. They are not photographs
        of our own work, and no before and after is implied. When our jobs
        produce real ones, they will appear here with the city and the service
        named.
      </p>

      <p class="text-center" style="margin-top:1.2rem;">
        <a href="/prices/" class="btn btn-outline">See every published price</a>
      </p>
    </div>
  </section>

  <!-- Why we publish prices -->
  <section class="section section-alt">
    <div class="container narrow">
      <div class="section-head center">
        <span class="eyebrow">Why our prices are on the website</span>
        <h2>Because the alternative is how this industry got its reputation</h2>
      </div>
      <div class="prose">
        <p>
          The pattern is familiar to anyone who has been through it. An advertised
          repair for $49, or a $29 service charge, and then a technician who finds
          cables, drums, bearings and rollers that all need replacing. People have
          been quoted $1,500 to replace two springs that cost $320 to $700 to do
          properly.
        </p>
        <p>
          We are a newer company. We cannot tell you we have been here since 1987,
          and we are not going to pretend otherwise. What we can do is publish every
          price before you call, put the estimate in writing before we touch
          anything, and show you the failed part rather than describing it.
        </p>
        <p>
          If a recommendation genuinely costs you more, such as replacing both
          springs when one snapped, we explain why and let you decide. That one is a
          real recommendation, not an upsell: the second spring has the same fatigue
          as the first and usually follows within months.
        </p>
      </div>
      <p class="text-center" style="margin-top:1.4rem;">
        <a href="/blog/garage-door-repair-scams/" class="btn btn-outline">How to spot a bait quote</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container narrow">
      <FAQ items={homeFaq} title="Common questions" />
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band">
    <div class="container">
      <h2>Tell us what happened and we will tell you what it costs</h2>
      <p>Free quote, no obligation, and a real arrival window if you need us today.</p>
      <a href="/contact/" class="btn btn-accent btn-lg">Get a free quote</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--grad-hero);
    padding-block: 3.2rem 3.6rem;
    position: relative;
    isolation: isolate;
  }
  /* Steel panel texture, faded out towards the bottom so it reads as a
     surface behind the copy rather than as ruled lines across it. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--texture-steel);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 62%);
    mask-image: linear-gradient(180deg, #000 0%, transparent 62%);
  }
  .hero-inner { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 3rem; align-items: center; }
  .hero h1 { font-size: clamp(2.1rem, 4.6vw, 3.4rem); line-height: 1.08; margin-bottom: 1rem; }
  .hero h1 .hl { color: var(--c-accent-dark); }
  .hero .lead { max-width: 34rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 1.6rem 0 1.4rem; }
  .hero-trust {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem;
    list-style: none; padding: 0; margin: 0;
    font-size: 0.88rem; font-weight: 700; color: var(--c-body);
  }
  .hero-trust li::before { content: '✓'; color: #177841; font-weight: 800; margin-right: 0.35rem; }

  .trust-band { border-bottom: 1px solid var(--c-line); background: #fff; }
  .trust-band .trust-strip { padding-block: 1.05rem; justify-content: space-between; row-gap: 0.8rem; }

  .hero-panel {
    background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius);
    padding: 1.75rem; box-shadow: var(--shadow-card-hover);
    position: relative; overflow: hidden;
  }
  .hero-panel::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 5px;
    background: var(--stripe-brand);
  }
  .panel-head h2 { font-size: 1.18rem; margin-bottom: 0.2rem; }
  .panel-head p { font-size: 0.86rem; color: var(--c-muted); margin-bottom: 1rem; }
  .price-table { width: 100%; border-collapse: collapse; }
  .price-table th, .price-table td { padding: 0.62rem 0; border-bottom: 1px solid var(--c-line); text-align: left; }
  .price-table th { font-weight: 600; font-size: 0.92rem; }
  .price-table th a { color: var(--c-ink); text-decoration: none; }
  .price-table th a:hover { color: var(--c-primary); }
  .price-table td { text-align: right; font-weight: 800; color: var(--c-primary); font-size: 0.92rem; white-space: nowrap; }
  .panel-link { display: inline-block; margin-top: 0.9rem; font-weight: 700; font-size: 0.9rem; color: var(--c-primary); text-decoration: none; }
  .panel-link:hover { text-decoration: underline; }

  /* The photograph is atmosphere behind a heavy navy wash. If the file is
     missing the gradient alone still renders, so nothing breaks. */
  .emergency-band {
    background-color: var(--c-primary);
    background-image:
      linear-gradient(100deg, rgba(15, 39, 71, 0.97) 0%, rgba(15, 39, 71, 0.9) 45%, rgba(15, 39, 71, 0.72) 100%),
      url('/images/ny-colonial-double-door.webp');
    background-size: cover;
    background-position: center 62%;
    color: #e7edf5;
    padding-block: 2.6rem;
    position: relative;
  }
  .emergency-band::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 3px;
    background: var(--stripe-brand);
  }
  .emergency-band .container { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 2rem; align-items: center; position: relative; }
  .emergency-band h2 { color: #fff; font-size: 1.6rem; margin-bottom: 0.5rem; }
  .emergency-band p { margin: 0; font-size: 0.96rem; color: #c3cede; }
  .band-actions { display: flex; flex-direction: column; gap: 0.8rem; align-items: flex-start; }
  .band-services { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .band-services a { color: #a9b6c6; font-size: 0.86rem; }

  .service-card { display: block; text-decoration: none; }
  .service-card:hover { text-decoration: none; }
  .service-card:hover .icon { background: var(--c-primary); color: #fff; }
  .service-card .icon { transition: background 0.2s ease, color 0.2s ease; }
  .service-card h3 { color: var(--c-ink); font-size: 1.06rem; margin-bottom: 0.35rem; }
  .service-card p { color: var(--c-body); font-size: 0.9rem; margin-bottom: 0.6rem; }
  .card-price {
    display: inline-block; font-weight: 800; font-size: 0.88rem;
    color: var(--c-primary); background: var(--c-primary-light);
    padding: 0.25rem 0.6rem; border-radius: 999px;
  }

  /* ---------- Door type illustrations ---------- */
  .door-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.4rem;
  }
  .door-card {
    display: block; text-decoration: none; background: #fff;
    border: 1px solid var(--c-line); border-radius: var(--radius);
    box-shadow: var(--shadow-card); overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .door-card:hover {
    text-decoration: none; transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover); border-color: #d5dae1;
  }
  /* Fixed ratio so a slow or missing image cannot shift the layout */
  .door-card img {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover;
    display: block; background: var(--c-bg-alt);
  }
  .door-meta { padding: 1.1rem 1.2rem 1.3rem; }
  .door-meta h3 { font-size: 1.02rem; color: var(--c-ink); margin-bottom: 0.3rem; }
  .door-meta p { font-size: 0.9rem; color: var(--c-body); margin: 0; }

  /* Same card as the door grid, four across instead of three. */
  .fault-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.3rem;
  }
  .fault-price {
    display: inline-block; margin-top: 0.6rem; font-weight: 700;
    color: var(--c-primary); font-size: 0.92rem;
  }
  @media (max-width: 1000px) { .fault-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .fault-grid { grid-template-columns: 1fr; } }
  .media-note {
    font-size: 0.8rem; color: var(--c-muted); line-height: 1.55;
    max-width: 46rem; margin: 1.4rem auto 0; text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .door-card:hover { transform: none; }
  }

  .cta-band { background: var(--grad-primary); color: #fff; padding-block: 3rem; text-align: center; }
  .cta-band h2 { color: #fff; margin-bottom: 0.5rem; }
  .cta-band p { color: #d3dded; margin-bottom: 1.3rem; }

  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; gap: 2rem; }
    .emergency-band .container { grid-template-columns: 1fr; }
  }
</style>
