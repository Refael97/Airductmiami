---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import FAQ from '../components/FAQ.astro';
import { business } from '../data/business';

const title = `Garage Door FAQ | New York | ${business.name}`;
const description =
  'The questions people actually ask before hiring a garage door company in New York: what it costs, how fast we get there, whether the door is safe to use, and how to spot a bait quote.';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'FAQ', href: '/faq/' },
];

const groups = [
  {
    title: 'Cost',
    items: [
      {
        question: 'How much does garage door repair cost in New York?',
        answer:
          'Spring replacement starts at $170 per spring, cable repair at $100, opener repair at $100, opener installation at $281, off-track correction at $150, section replacement at $250, and a new door installed at $1,056. Those are starting prices for a standard single door in normal condition.',
      },
      {
        question: 'What is a fair price for two garage door springs?',
        answer:
          'Roughly $320 to $700 installed for a standard door in this market. Quotes well above that for two standard springs are worth a second opinion. High-cycle springs and oversized doors legitimately cost more, and whoever is quoting should tell you which applies.',
      },
      {
        question: 'Why does my quote differ from the published price?',
        answer:
          'Four things move a job above the starting price: door size, door type and model, the condition of the parts around the failure, and access or timing. We tell you which of those applies before we start, not after.',
      },
      {
        question: 'Do you charge a service call fee?',
        answer:
          'Not as a separate bait fee. We quote the job before dispatch based on what you describe. Genuine emergency or after-hours dispatch carries a $200 to $350 call-out premium, stated before we send anyone.',
      },
      {
        question: 'Do you offer financing?',
        answer:
          'Not currently. For a full door replacement we can stage the work where that helps, and we will tell you honestly when a repair will get you a few more years rather than pushing the larger job.',
      },
    ],
  },
  {
    title: 'Speed and emergencies',
    items: [
      {
        question: 'Can you come today?',
        answer:
          'Usually, seven days a week. You get a real arrival window before we dispatch rather than a vague promise, and if it slips we tell you.',
      },
      {
        question: 'My car is trapped in the garage. What do I do?',
        answer:
          'Do not run the opener. If a spring has snapped the door is dead weight and forcing it can bend panels or drop the door. Most doors have a manual release cord, and with a second person the door can usually be lifted and propped. Then stop using it and call us.',
      },
      {
        question: 'The door is stuck open and I cannot secure the house. Is that an emergency?',
        answer:
          'Yes, and we treat it as one. An open garage on an attached house is a security problem, not an inconvenience. Same-day emergency service is available with the call-out premium stated up front.',
      },
    ],
  },
  {
    title: 'Safety and using the door',
    items: [
      {
        question: 'Can I use my garage door with a broken spring?',
        answer:
          'No. The springs carry the weight, not the opener. Running the opener on a broken spring strains the motor, bends panels and can drop the door. Leave it alone until it is fixed.',
      },
      {
        question: 'Why should I not replace a torsion spring myself?',
        answer:
          'A torsion spring under tension stores enough energy to break bones, and it releases that energy instantly if it is not unwound under control with winding bars. Emergency rooms see the results of this every year. It is the one job on a garage door that genuinely should not be attempted.',
      },
      {
        question: 'My door reverses immediately after it closes. Why?',
        answer:
          'Usually the photo eye safety sensors are misaligned or something is breaking the beam, or the down force is set too low. Both are quick to correct. It can also mean the door is out of balance and the opener is tripping its own safety limit.',
      },
      {
        question: 'How do I know if my door is balanced?',
        answer:
          'Pull the manual release, lift the door halfway by hand, and let go. A balanced door stays put. If it drops or rises on its own, the spring is not matched to the door, and the opener has been doing work it was never meant to do.',
      },
    ],
  },
  {
    title: 'Repair or replace',
    items: [
      {
        question: 'Should I repair my door or replace it?',
        answer:
          'Repair when the sections are sound and only wear parts have failed, which is most of the time. Replace when sections are rusted through or damaged beyond a matchable panel, when the garage is attached to living space and the door is uninsulated, or when the repair cost approaches half the price of a new door.',
      },
      {
        question: 'How long do garage door springs last?',
        answer:
          'A standard torsion spring is rated for about 10,000 open and close cycles, which for most households is seven to ten years. High-cycle springs are rated for 20,000 or more. Cold weather is what usually finishes off a spring already near the end of its life, which is why New York sees a clear winter spike.',
      },
      {
        question: 'How old is too old for an opener?',
        answer:
          'Anything made before 1993 has no photo eye safety sensors and should be replaced on that basis alone. Past about twenty years, parts availability becomes the deciding factor, and a repair costing more than half a new unit is not worth doing.',
      },
      {
        question: 'Do I need one spring replaced or both?',
        answer:
          'If the door has two and one broke, both have the same cycle count and the survivor usually follows within months. Replacing both together adds $150 to $300 rather than doubling the cost, because most of the labor is shared. It is your call, and we will do just the one if you prefer.',
      },
    ],
  },
  {
    title: 'Trust',
    items: [
      {
        question: 'How do I spot a bait quote?',
        answer:
          'The tell is a very low advertised number for the visit rather than for the work. Ask for the full price of the actual repair, in writing, before anyone is dispatched. A company that will not give you that before arriving is telling you something.',
      },
      {
        question: 'Are you licensed and insured?',
        answer:
          'Yes. Ask any contractor for both and expect a real answer rather than a slogan on a van.',
      },
      {
        question: 'Why do you not show customer reviews?',
        answer:
          'Because we do not have enough real ones yet, and we are not going to write them. When customers leave genuine reviews they will appear here with their names attached. Until then, judge us on the published prices and the written estimate.',
      },
      {
        question: 'Where are you based?',
        answer:
          'We are a service area business covering the New York metro area. We travel to the customer and do not receive customers at a location, so we do not publish a street address. We would rather say that than list a mailbox as a showroom.',
      },
      {
        question: 'What is your warranty?',
        answer:
          'One year on parts and one year on labor for the work we do, written on the invoice.',
      },
    ],
  },
];

/** One FAQPage schema for the page, built from every group. */
const allItems = groups.flatMap((g) => g.items);
---
<BaseLayout title={title} description={description}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="faq-hero">
    <div class="container">
      <span class="eyebrow">Questions</span>
      <div class="stripe-rule" aria-hidden="true"></div>
      <h1>Garage door questions, answered properly</h1>
      <p class="lead">
        These are the things people actually ask before hiring someone, including
        the ones the trade tends to talk around.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      {groups.map((g, i) => (
        <div class="faq-group">
          <h2>{g.title}</h2>
          <FAQ items={g.items} title="" emitSchema={false} />
        </div>
      ))}
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allItems.map((i) => ({
    '@type': 'Question',
    name: i.question,
    acceptedAnswer: { '@type': 'Answer', text: i.answer },
  })),
})} />

<style>
  .faq-hero { background: var(--grad-hero); padding-block: 2.6rem 2.4rem; }
  .narrow { max-width: var(--maxw-narrow); }
  .faq-group { margin-bottom: 2.2rem; }
  .faq-group h2 { margin-bottom: 0.4rem; }
</style>
