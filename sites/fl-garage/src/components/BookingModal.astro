---
/**
 * The booking form as a modal, opened from anywhere on the site.
 *
 * The point of this is scrolling. A visitor reading a service page halfway
 * down has to travel to reach a form, and every screen of that journey is a
 * chance to leave. This puts the same four steps directly in front of them.
 *
 * Every trigger is an ordinary link to the contact page carrying
 * `data-open-booking`. The script cancels the navigation and opens the
 * dialog; without the script the link still goes to the contact page, where
 * the same form is waiting. No trigger is a dead button.
 *
 * `<dialog>` rather than a hand rolled overlay: the browser gives us the top
 * layer, the backdrop, focus trapping, Escape to close and inertness of the
 * page behind it, all of which are easy to implement badly.
 *
 * The height rule here is the one that matters. The card is a grid with an
 * explicit `minmax(0, 1fr)` body row. Without it the row takes its content
 * height, the card clips at its max-height, the body never becomes
 * scrollable, and the submit button sits below the fold with no way to reach
 * it. That exact bug shipped on the promo popup once.
 */
import BookingForm from './BookingForm.astro';
import { ui, paths, type Locale } from '../data/ui';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const p = paths[lang];
---
<dialog class="bk-dialog" id="booking-dialog" aria-labelledby="booking-title">
  <div class="bk-card">
    <header class="bk-head">
      <div>
        <h2 id="booking-title">{t.wizModalTitle}</h2>
        <p>{t.wizModalLead}</p>
      </div>
      <button type="button" class="bk-close" data-close-booking aria-label={t.wizClose}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </header>

    <div class="bk-body">
      <BookingForm lang={lang} idPrefix="bk" source="booking_modal" thankYou={p.thankYou} />
    </div>
  </div>
</dialog>

<script is:inline>
  (function () {
    var dlg = document.getElementById('booking-dialog');
    if (!dlg || typeof dlg.showModal !== 'function') return;

    function open(e) {
      if (e) e.preventDefault();
      dlg.showModal();
      var first = dlg.querySelector('.wz-job input');
      if (first) first.focus({ preventScroll: true });
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'booking_open', { page_path: location.pathname });
      }
    }

    document.addEventListener('click', function (e) {
      var t = e.target.closest ? e.target.closest('[data-open-booking]') : null;
      if (t) return open(e);
      var c = e.target.closest ? e.target.closest('[data-close-booking]') : null;
      if (c) dlg.close();
    });

    /* Clicking the backdrop closes it. The dialog element is the backdrop's
       hit target, so a click landing on the dialog itself and not on the
       card inside it is a backdrop click. */
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg) dlg.close();
    });

    window.openBookingModal = open;
  })();
</script>

<style is:global>
  .bk-dialog {
    padding: 0; border: 0; background: transparent;
    max-width: min(920px, 96vw); width: 100%;
    max-height: 94vh;
    overflow: visible;
  }
  .bk-dialog::backdrop { background: rgba(11, 22, 40, 0.62); backdrop-filter: blur(2px); }

  .bk-card {
    display: grid;
    /* Head auto, body takes the rest and is allowed to shrink. Without the
       minmax(0, ...) the body row grows to its content and the submit
       button ends up unreachable below the card's max-height. */
    grid-template-rows: auto minmax(0, 1fr);
    max-height: 94vh;
    background: #fff; border-radius: 16px; overflow: hidden;
    box-shadow: 0 24px 70px rgba(11, 22, 40, 0.35);
  }

  .bk-head {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;
    padding: 1.1rem 1.3rem; border-bottom: 1px solid var(--c-line);
    background: var(--c-bg-alt, #f4f6f8);
  }
  .bk-head h2 { font-size: 1.15rem; margin: 0 0 0.15rem; }
  .bk-head p { margin: 0; font-size: 0.85rem; color: var(--c-muted); }
  .bk-close {
    flex: 0 0 auto; display: grid; place-items: center;
    width: 2.2rem; height: 2.2rem; border-radius: 50%;
    border: 1px solid var(--c-line); background: #fff; color: var(--c-body);
    cursor: pointer;
  }
  .bk-close:hover { color: var(--c-ink); border-color: #c8cfd8; }

  .bk-body { overflow-y: auto; padding: 1.2rem 1.3rem 1.4rem; }
  .bk-body .quote-form { margin-top: 0; }

  @media (max-width: 560px) {
    .bk-dialog { max-width: 100vw; max-height: 100vh; margin: 0; }
    .bk-card { max-height: 100vh; border-radius: 0; }
    .bk-body { padding: 1rem 1rem 1.2rem; }
  }
</style>
