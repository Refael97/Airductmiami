---
/**
 * Outline icon set, per the brand book: line art, slightly thick strokes,
 * navy. Inline SVG so it inherits currentColor and ships no extra request.
 *
 * Usage: <Icon name="spring" /> or <Icon name="check" size={18} />
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 30, class: cls = '' } = Astro.props;

const paths: Record<string, string> = {
  // Garage door: frame, panel lines, ground
  door: `<rect x="3" y="5" width="18" height="15" rx="1.5"/>
         <path d="M3 9.5h18M3 14h18M3 20h18"/>`,

  // Torsion spring: coil across a shaft
  spring: `<path d="M2 12h2M20 12h2"/>
           <path d="M4 12c0-2.2 1.1-3.5 2.4-3.5S8.8 9.8 8.8 12s1.1 3.5 2.4 3.5S13.6 14.2 13.6 12s1.1-3.5 2.4-3.5S18.4 9.8 18.4 12"/>
           <path d="M18.4 12c0 2.2 .7 3.5 1.6 3.5"/>`,

  // Cable and drum
  cable: `<circle cx="6" cy="6" r="3"/>
          <path d="M6 9v6a3 3 0 0 0 3 3h4"/>
          <path d="M13 15l3 3-3 3"/>
          <path d="M18 4v7"/>`,

  // Roller in a track
  roller: `<circle cx="9" cy="12" r="3.5"/>
           <path d="M12.5 12H21"/>
           <path d="M18 8.5v7M21 8.5v7"/>
           <path d="M9 8.5V4M9 20v-4.5"/>`,

  // Opener unit with rail
  opener: `<rect x="4" y="4" width="9" height="7" rx="1.5"/>
           <path d="M13 7.5h7"/>
           <path d="M8.5 11v4"/>
           <path d="M5 15h7l-3.5 5z"/>`,

  // Remote control
  remote: `<rect x="8" y="3" width="8" height="18" rx="2"/>
           <circle cx="12" cy="8" r="1.2"/>
           <path d="M10 13h4M10 16.5h4"/>`,

  // New door installation: door with a plus
  install: `<rect x="3" y="6" width="13" height="13" rx="1.5"/>
            <path d="M3 10.5h13M3 15h13"/>
            <path d="M19 6v6M22 9h-6"/>`,

  // 24/7 emergency: clock
  clock: `<circle cx="12" cy="12" r="9"/>
          <path d="M12 7v5l3.5 2"/>`,

  // Off track door
  offtrack: `<path d="M4 4v16M20 4v16"/>
             <rect x="6.5" y="7" width="11" height="8" rx="1" transform="rotate(-7 12 11)"/>`,

  // Tune up / maintenance wrench
  wrench: `<path d="M14.5 6.5a4 4 0 1 0 4.2 5.8L21 14.6 18.6 17l-2.3-2.3A4 4 0 0 1 10.5 9"/>
           <path d="M10.4 9.1 4 15.5 6.5 18l6.4-6.4"/>`,

  // Shield: licensed and insured
  shield: `<path d="M12 3l7.5 3v5.5c0 4.4-3 8-7.5 9.5-4.5-1.5-7.5-5.1-7.5-9.5V6z"/>
           <path d="m9 12 2.2 2.2L15.5 10"/>`,

  // Check mark in a circle
  check: `<circle cx="12" cy="12" r="9"/>
          <path d="m8.5 12.2 2.4 2.4 4.6-5"/>`,

  // Written estimate
  quote: `<path d="M6 3h8l4 4v14H6z"/>
          <path d="M14 3v4h4"/>
          <path d="M9 12h6M9 15.5h6M9 8.5h2"/>`,

  // Dollar sign, published pricing
  price: `<circle cx="12" cy="12" r="9"/>
          <path d="M12 6.8v10.4"/>
          <path d="M14.6 9.6A2.4 2.4 0 0 0 12 8.2c-1.4 0-2.5.9-2.5 2s1 1.7 2.5 2 2.6.8 2.6 2-1.1 2-2.6 2a2.5 2.5 0 0 1-2.6-1.5"/>`,

  // Map pin, service area
  pin: `<path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/>
        <circle cx="12" cy="10" r="2.6"/>`,

  // Phone
  phone: `<path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5z"/>`,

  // Truck, same day service
  truck: `<path d="M3 6.5h11v9H3z"/>
          <path d="M14 9.5h3.5L21 12.6v2.9h-7"/>
          <circle cx="7" cy="17.5" r="2"/>
          <circle cx="17" cy="17.5" r="2"/>`,

  // Warning triangle
  warning: `<path d="M12 4.5 21 19H3z"/>
            <path d="M12 10v4"/>
            <path d="M12 16.6v.1"/>`,
};

const d = paths[name] ?? paths.check;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={cls}
  set:html={d}
/>
