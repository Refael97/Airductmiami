---
/**
 * Header with a mega menu on the three sections deep enough to need one.
 *
 * The panels open on hover AND on focus-within, so they need no JavaScript
 * and still work for keyboard users. Every top-level item is a real link to
 * its hub page, which is what makes the whole thing degrade cleanly: on a
 * phone the panels are hidden and a tap goes to the hub, which lists the
 * same links in a readable layout. Nothing is reachable only by hovering.
 *
 * Bilingual: every string comes from data/ui.ts and every name from the
 * localised data helpers, so the Spanish header is the same component.
 */
import { business } from '../data/business';
import { services } from '../data/services';
import { doorMaterials, openerTypes, brands } from '../data/products';
import { regions } from '../data/regions';
import { citiesByRegion } from '../data/cities';
import Icon from './Icon.astro';
import { iconFor } from '../data/serviceIcons';
import { ui, paths, serviceHref, areaHref, productHref, brandHref, money, type Locale } from '../data/ui';
import { svc, region as regionOf, city as cityOf, material, opener, brand } from '../lib/i18n';

interface Props {
  lang?: Locale;
  /** URL of the same page in the other language. */
  switchHref?: string;
}
const { lang = 'en', switchHref } = Astro.props;
const t = ui[lang];
const p = paths[lang];
const other = lang === 'en' ? 'es' : 'en';

const orderedRegions = [...regions].sort((a, b) => a.order - b.order);
---
<header class="site-header">
  <div class="emergency-strip">
    <div class="container">
      <span class="strip-dot" aria-hidden="true"></span>
      <span>{t.strip}</span>
      <a
        href={switchHref ?? paths[other].home}
        class="lang-switch"
        hreflang={other}
        rel="alternate"
        lang={other}
      >{t.langSwitch}</a>
    </div>
  </div>

  <div class="container header-inner">
    <a href={p.home} class="brand" aria-label={`${business.name} home`}>
      <img src="/logo.svg" alt="" width="44" height="44" class="brand-mark" />
      <span class="brand-word">
        <span class="bw-top">{business.name}</span>
        <span class="bw-sub">{t.brandSub}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <!-- Services -->
      <div class="nav-item has-menu">
        <a href={p.services} class="nav-link">
          {t.navServices}
          <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
        </a>
        <div class="mega">
          <div class="container mega-inner">
            <div class="mega-col mega-wide">
              <h2 class="mega-head">{t.megaRepairs}</h2>
              <ul class="svc-list">
                {services.map((s0) => { const s = svc(lang, s0); return (
                  <li>
                    <a href={serviceHref(lang, s.slug)}>
                      <span class="sl-ico"><Icon name={iconFor(s.slug)} size={20} /></span>
                      <span class="sl-name">{s.shortName}</span>
                      <span class="sl-price">{t.from} {money(s.priceLow)}</span>
                    </a>
                  </li>
                ); })}
              </ul>
            </div>
            <div class="mega-col mega-aside">
              <h2 class="mega-head">{t.megaEveryPrice}</h2>
              <p class="mega-note">{t.megaEveryPriceNote}</p>
              <a href={p.prices} class="btn btn-accent btn-sm">{t.megaSeePriceList}</a>
              <a href={p.services} class="mega-more">{t.megaAllServices}</a>
            </div>
          </div>
        </div>
      </div>

      <a href={p.prices} class="nav-link nav-solo">{t.navPrices}</a>

      <!-- Doors and openers -->
      <div class="nav-item has-menu">
        <a href={p.buyersGuide} class="nav-link">
          {t.navDoorsOpeners}
          <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
        </a>
        <div class="mega">
          <div class="container mega-inner">
            <div class="mega-col">
              <h2 class="mega-head">{t.megaMaterials}</h2>
              <ul class="plain-list">
                {doorMaterials.map((m0) => { const m = material(lang, m0); return (
                  <li><a href={productHref(lang, m.slug)}>{m.shortName}<span>{t.from} {money(m.priceLow)}</span></a></li>
                ); })}
              </ul>
            </div>
            <div class="mega-col">
              <h2 class="mega-head">{t.megaOpenerTypes}</h2>
              <ul class="plain-list">
                {openerTypes.map((o0) => { const o = opener(lang, o0); return (
                  <li><a href={productHref(lang, o.slug)}>{o.shortName}<span>{o.noise}</span></a></li>
                ); })}
              </ul>
            </div>
            <div class="mega-col">
              <h2 class="mega-head">{t.megaBrands}</h2>
              <ul class="plain-list">
                {brands.map((b0) => { const b = brand(lang, b0); return (
                  <li><a href={brandHref(lang, b.slug)}>{b.name}<span>{b.kind === 'opener' ? t.openers : t.doors}</span></a></li>
                ); })}
              </ul>
            </div>
            <div class="mega-col mega-aside">
              <h2 class="mega-head">{t.megaNotSure}</h2>
              <p class="mega-note">{t.megaNotSureNote}</p>
              <a href={p.buyersGuide} class="btn btn-outline btn-sm">{t.megaBuyersGuide}</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Service areas -->
      <div class="nav-item has-menu">
        <a href={p.serviceAreas} class="nav-link">
          {t.navAreas}
          <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
        </a>
        <div class="mega">
          <div class="container mega-inner mega-areas">
            {orderedRegions.map((r0) => { const r = regionOf(lang, r0); return (
              <div class="mega-col">
                {/* Column headings drop the word County so the seven columns
                    stay on one line. The link still goes to the region page. */}
                <h2 class="mega-head"><a href={areaHref(lang, r.slug)}>{r.name.replace(/ County$| Condado$/, '').replace(/^Condado de /, '')}</a></h2>
                <ul class="city-list">
                  {citiesByRegion(r.slug).slice(0, 5).map((c0) => { const c = cityOf(lang, c0); return (
                    <li><a href={areaHref(lang, c.slug)}>{c.name}</a></li>
                  ); })}
                </ul>
              </div>
            ); })}
            <div class="mega-col mega-aside">
              <h2 class="mega-head">{t.megaSameDay}</h2>
              <p class="mega-note">{t.megaSameDayNote}</p>
              <a href={p.serviceAreas} class="mega-more">{t.megaAllAreas}</a>
            </div>
          </div>
        </div>
      </div>

      <a href={p.blog} class="nav-link nav-solo">{t.navGuides}</a>
      <a href={p.faq} class="nav-link nav-solo">{t.navFaq}</a>
    </nav>

    <a href={p.contact} class="btn btn-accent header-cta">{t.headerCta}</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 500;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .emergency-strip {
    background: var(--c-primary); color: #e7edf5;
    font-size: 0.82rem; font-weight: 600;
    padding: 0.45rem 0;
    position: relative;
  }
  /* Diagonal garage-door stripe along the top edge, decorative */
  .emergency-strip::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 3px;
    background: var(--stripe-brand);
  }
  .emergency-strip .container { display: flex; align-items: center; gap: 0.5rem; justify-content: center; text-align: center; }
  .lang-switch {
    position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    color: #fff; font-weight: 800; font-size: 0.78rem; letter-spacing: 0.04em;
    text-decoration: none; padding: 0.15rem 0.6rem; border: 1px solid rgba(255,255,255,0.35);
    border-radius: 999px;
  }
  .lang-switch:hover { background: rgba(255,255,255,0.12); text-decoration: none; }
  .emergency-strip .container { position: relative; padding-right: 5.5rem; }
  .strip-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--c-accent); flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(214, 40, 40, 0.32);
  }

  .header-inner {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem;
    padding-block: 0.7rem;
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; flex-shrink: 0; }
  .brand:hover { text-decoration: none; }
  .brand-word { display: flex; flex-direction: column; line-height: 1.1; }
  .bw-top {
    font-family: var(--font-display); font-weight: 400; font-size: 1.5rem;
    line-height: 1; color: var(--c-primary);
    text-transform: uppercase; letter-spacing: 0.015em;
  }
  .bw-sub {
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--c-muted);
  }

  /* min-width: 0 lets the nav give ground before the row wraps. Without
     it the nav holds its full intrinsic width, the CTA is pushed onto a
     second line, and the header grows a stray row. That happens in
     Spanish and not in English, because "Áreas de servicio" and
     "Cotización gratis" are simply longer than their English
     equivalents, so it is a bug you only see in one language. */
  /* The gap is set for the longer language. The container is capped at
     --maxw, so a wider viewport never gives the header more room, which
     means a media query cannot rescue this: the spacing has to fit the
     Spanish labels at every width or the CTA drops to a second row. */
  .site-nav {
    display: flex; align-items: center; gap: 0.8rem;
    margin-left: auto; min-width: 0; flex-shrink: 1;
  }
  .nav-item { display: flex; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 0.2rem;
    color: var(--c-body); font-weight: 600; font-size: 0.9rem; text-decoration: none;
    padding-block: 0.3rem; border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--c-primary); border-bottom-color: var(--c-accent); text-decoration: none; }
  .chev {
    width: 14px; height: 14px; fill: none; stroke: currentColor;
    stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round;
    transition: transform 0.18s ease; margin-top: 1px;
  }

  /* ---------- Mega panels ----------
     Hidden with visibility rather than display so the transition works and
     so the links stay in the accessibility tree order. */
  .mega {
    position: absolute;
    top: 100%; left: 0; right: 0;
    background: #fff;
    border-top: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
    box-shadow: 0 18px 40px rgba(15, 39, 71, 0.12);
    opacity: 0; visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
    z-index: 10;
  }
  .has-menu:hover > .mega,
  .has-menu:focus-within > .mega {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .has-menu:hover > .nav-link,
  .has-menu:focus-within > .nav-link {
    color: var(--c-primary); border-bottom-color: var(--c-accent);
  }
  .has-menu:hover > .nav-link .chev,
  .has-menu:focus-within > .nav-link .chev { transform: rotate(180deg); }

  .mega-inner {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 0.9fr);
    gap: 2rem;
    padding-block: 1.8rem 2rem;
    align-items: start;
  }
  .mega-areas { grid-template-columns: repeat(6, minmax(0, 1fr)) minmax(0, 1.5fr); gap: 1.4rem; }
  .mega-wide { grid-column: span 3; }

  .mega-head {
    font-family: var(--font-head);
    font-size: 0.74rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--c-muted);
    margin: 0 0 0.8rem; line-height: 1.3;
  }
  .mega-head a { color: var(--c-primary); text-decoration: none; }
  .mega-head a:hover { text-decoration: underline; }

  .mega-note { font-size: 0.85rem; color: var(--c-body); margin-bottom: 0.9rem; }
  .mega-more { display: inline-block; margin-top: 0.7rem; font-size: 0.86rem; font-weight: 700; }

  .mega-aside {
    background: var(--c-bg-alt);
    border: 1px solid var(--c-line);
    border-radius: 12px;
    padding: 1.1rem 1.2rem;
  }

  /* Services list, three columns inside its own wide cell */
  .svc-list {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.15rem 1.2rem;
  }
  .svc-list li { margin: 0; }
  .svc-list a {
    display: flex; align-items: center; gap: 0.55rem;
    padding: 0.45rem 0.5rem; border-radius: 8px; text-decoration: none;
    transition: background 0.15s ease;
  }
  .svc-list a:hover { background: var(--c-primary-light); text-decoration: none; }
  .sl-ico { display: inline-flex; color: var(--c-primary); flex-shrink: 0; }
  .sl-name { font-size: 0.88rem; font-weight: 600; color: var(--c-ink); }
  .sl-price {
    margin-left: auto; font-size: 0.78rem; font-weight: 800;
    color: var(--c-primary); white-space: nowrap;
  }

  .plain-list, .city-list { list-style: none; padding: 0; margin: 0; }
  .plain-list li, .city-list li { margin: 0; }
  .plain-list a, .city-list a {
    display: flex; align-items: baseline; gap: 0.5rem;
    padding: 0.32rem 0.4rem; border-radius: 6px;
    font-size: 0.88rem; font-weight: 600; color: var(--c-ink); text-decoration: none;
    transition: background 0.15s ease;
  }
  .plain-list a:hover, .city-list a:hover { background: var(--c-primary-light); text-decoration: none; }
  .plain-list span {
    margin-left: auto; font-size: 0.74rem; font-weight: 700;
    color: var(--c-muted); white-space: nowrap;
  }

  .header-cta { flex-shrink: 0; min-height: 46px; padding-inline: 1.05rem; white-space: nowrap; }

  /* ---------- Narrow screens ----------
     The panels are switched off entirely. Every top-level item is already a
     link to a hub page that lists the same things in a layout built for a
     phone, so nothing becomes unreachable. */
  .mega-areas { grid-template-columns: repeat(7, minmax(0, 1fr)) 1.3fr; }
  .mega-areas .mega-head { font-size: 0.8rem; }
  .mega-areas .city-list a { font-size: 0.82rem; padding: 0.25rem 0.3rem; }

  /* Below --maxw the container starts shrinking, so the header loses room
     for the first time and the longer language needs another step down.
     The mega panels stay until 1080px; this step is spacing only. */
  @media (max-width: 1160px) {
    .site-nav { gap: 0.6rem; }
    .nav-link { font-size: 0.86rem; }
    .header-cta { padding-inline: 0.85rem; font-size: 0.9rem; }
    .bw-sub { display: none; }
  }

  @media (max-width: 1080px) {
    .mega { display: none; }
    .chev { display: none; }
    .site-nav { gap: 0.9rem; }
    .nav-link { font-size: 0.9rem; }
  }

  @media (max-width: 960px) {
    .site-nav { order: 3; width: 100%; margin-left: 0; gap: 0; flex-wrap: wrap; }
    .nav-item { display: contents; }
    .nav-link {
      flex: 1 1 33%; padding: 0.5rem 0.3rem;
      display: flex; align-items: center; justify-content: center;
      min-height: 2.9rem; text-align: center; line-height: 1.2;
      border-bottom: 1px solid var(--c-line); font-size: 0.85rem;
      white-space: normal;
    }
    .nav-link:hover { border-bottom-color: var(--c-accent); }
    .header-cta { margin-left: auto; }
    .emergency-strip { font-size: 0.75rem; }
  }

  /* On a phone the brand block and the CTA must share one row, so the
     tagline is dropped and the wordmark steps down a size. */
  @media (max-width: 620px) {
    .header-inner { gap: 0.6rem; padding-block: 0.55rem; }
    .brand { gap: 0.45rem; }
    .brand-mark { width: 36px; height: 36px; }
    .bw-top { font-size: 1.28rem; }
    .bw-sub { display: none; }
    .header-cta { min-height: 42px; padding-inline: 1rem; font-size: 0.92rem; }
    .nav-link { font-size: 0.8rem; min-height: 2.7rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mega { transition: none; }
    .chev { transition: none; }
  }
</style>
