---
/**
 * The starting-price disclaimer. Must appear wherever prices appear.
 *
 * Publishing prices is this site's differentiator, but a published number
 * creates an obligation: the customer must not walk away thinking one price
 * covers every door and every fault. A single door and a double door are
 * different jobs, and so are a slipped cable and a snapped one. In Florida
 * the wind rating of a replacement door is a fifth factor, so it is named.
 *
 * `variant="inline"` is the short asterisk line for tables and cards.
 * `variant="block"` is the fuller explanation for service and price pages.
 */
import type { Locale } from '../data/ui';

interface Props {
  variant?: 'inline' | 'block';
  lang?: Locale;
}
const { variant = 'inline', lang = 'en' } = Astro.props;

const copy = {
  en: {
    inline:
      'Starting prices for a standard single door. Your final price depends on the door, the model, the wind rating a replacement needs and what we find. You get a written quote before any work starts.',
    heading: 'How to read these prices',
    p1a: 'Every number on this site is a ',
    p1b: 'starting price',
    p1c: ' for a standard single garage door in normal condition. It is a real number, not a teaser, and it is where a straightforward job begins.',
    p2: 'What moves your price above the starting point:',
    items: [
      ['Door size.', 'A double door is a bigger job than a single door, with more parts and more weight.'],
      ['Door type and model.', 'Materials, brands and discontinued models change what the parts cost and whether they are even available.'],
      ['Wind rating.', 'A replacement door in Florida must carry the rating for your wind zone, and in Miami-Dade and Broward a Miami-Dade NOA. Rated doors and rated panels cost more than unrated ones.'],
      ['Condition.', 'A failure rarely happens alone. Cables, drums, rollers and brackets that failed alongside are quoted before we replace anything.'],
      ['Access and timing.', 'Difficult access, and emergency or after-hours calls, carry their own cost, stated up front.'],
    ],
    promise:
      'What does not change: you get a written quote before any work begins, and that quote is the price you pay. We do not name a low number to get in the door and then raise it once the door is apart.',
    aria: 'How our pricing works',
  },
  es: {
    inline:
      'Precios iniciales para una puerta sencilla estándar. El precio final depende de la puerta, el modelo, la certificación de viento que necesite un reemplazo y lo que encontremos. Recibe un presupuesto por escrito antes de empezar cualquier trabajo.',
    heading: 'Cómo leer estos precios',
    p1a: 'Cada número de este sitio es un ',
    p1b: 'precio inicial',
    p1c: ' para una puerta de garaje sencilla estándar en condiciones normales. Es un número real, no un gancho, y es donde empieza un trabajo sin complicaciones.',
    p2: 'Qué lleva su precio por encima del punto de partida:',
    items: [
      ['Tamaño de la puerta.', 'Una puerta doble es un trabajo más grande que una sencilla, con más piezas y más peso.'],
      ['Tipo y modelo de puerta.', 'Los materiales, las marcas y los modelos descontinuados cambian lo que cuestan las piezas y si siquiera están disponibles.'],
      ['Certificación de viento.', 'Una puerta de reemplazo en Florida debe tener la certificación de su zona de viento, y en Miami-Dade y Broward un NOA de Miami-Dade. Las puertas y los paneles certificados cuestan más que los que no lo están.'],
      ['Estado general.', 'Una falla rara vez viene sola. Los cables, tambores, rodillos y soportes que fallaron junto con la pieza principal se cotizan antes de reemplazar nada.'],
      ['Acceso y horario.', 'El acceso difícil y las llamadas de emergencia o fuera de horario tienen su propio costo, informado por adelantado.'],
    ],
    promise:
      'Lo que no cambia: recibe un presupuesto por escrito antes de empezar cualquier trabajo, y ese presupuesto es el precio que paga. No decimos un número bajo para entrar y luego lo subimos cuando la puerta ya está desarmada.',
    aria: 'Cómo funcionan nuestros precios',
  },
}[lang];
---
{variant === 'inline' ? (
  <p class="price-note-inline">
    <span aria-hidden="true">*</span> {copy.inline}
  </p>
) : (
  <aside class="price-note-block" aria-label={copy.aria}>
    <h3><span aria-hidden="true">*</span> {copy.heading}</h3>
    <p>{copy.p1a}<strong>{copy.p1b}</strong>{copy.p1c}</p>
    <p>{copy.p2}</p>
    <ul>
      {copy.items.map(([k, v]) => (
        <li><strong>{k}</strong> {v}</li>
      ))}
    </ul>
    <p class="price-note-promise">{copy.promise}</p>
  </aside>
)}

<style>
  .price-note-inline {
    font-size: 0.8rem; line-height: 1.5; color: var(--c-muted);
    margin: 0.7rem 0 0;
  }
  .price-note-inline span { color: var(--c-accent-dark); font-weight: 800; }

  .price-note-block {
    background: var(--c-bg-alt);
    border: 1px solid var(--c-line);
    border-left: 4px solid var(--c-accent);
    border-radius: var(--radius-sm);
    padding: 1.2rem 1.3rem;
    margin: 1.6rem 0;
  }
  .price-note-block h3 { font-size: 1.02rem; margin-bottom: 0.6rem; }
  .price-note-block h3 span { color: var(--c-accent-dark); }
  .price-note-block p { font-size: 0.92rem; margin-bottom: 0.7rem; }
  .price-note-block ul { margin: 0 0 0.8rem; padding-left: 1.1rem; }
  .price-note-block li { font-size: 0.92rem; margin-bottom: 0.4rem; }
  .price-note-promise {
    margin-bottom: 0; padding-top: 0.7rem;
    border-top: 1px solid var(--c-line);
    font-weight: 600; color: var(--c-ink);
  }
</style>
