---
/**
 * The parts catalogue index.
 *
 * Laid out as a grid of cards because that is the shape a person scanning
 * for "the thing that looks like mine" can read fastest, and NOT as a shop
 * listing: no cart, no stock, no part-only price. Each card carries the
 * installed price from the matching service so the number a visitor sees on
 * the hub is the same number on the part page and the same number on the
 * price list.
 *
 * The DIY badge is on the card on purpose. Telling someone up front that a
 * bottom seal is a job they can do themselves costs us that job and earns
 * the next one, and it is the part of this catalogue a competitor would not
 * copy.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CtaBand from '../CtaBand.astro';
import PriceDisclaimer from '../PriceDisclaimer.astro';
import { parts } from '../../data/parts';
import { services } from '../../data/services';
import { partImages, hasImage, altFor } from '../../data/pageImages';
import { ui, paths, partHref, money, otherLocale, type Locale } from '../../data/ui';
import { part as localise } from '../../lib/i18n';
import { business } from '../../data/business';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const p = paths[lang];

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

const rows = parts.map((raw) => {
  const item = localise(lang, raw);
  const service = services.find((s) => s.slug === raw.service);
  const diyLabel =
    raw.diy === 'safe' ? t.partsDiySafe : raw.diy === 'depends' ? t.partsDiyDepends : t.partsDiyNo;
  return { raw, item, priceLow: service?.priceLow, diyLabel };
});

const crumbs = [
  { name: t.breadcrumbHome, href: p.home },
  { name: t.partsBreadcrumb, href: p.parts },
];

const title = `${t.partsHeading} | ${business.name}`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t.partsHeading,
  description: t.partsLead,
  url: `${site}${p.parts}`,
  inLanguage: lang === 'es' ? 'es-US' : 'en-US',
};
---
<BaseLayout title={title} description={t.partsLead} schema={schema} lang={lang} altHref={paths[otherLocale(lang)].parts}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="section">
    <div class="container">
      <h1>{t.partsHeading}</h1>
      <p class="lead ph-lead">{t.partsLead}</p>
      <p class="ph-intro">{t.partsIntro}</p>
      <p class="ph-note">{t.partsHubNote}</p>

      <ul class="ph-grid">
        {rows.map(({ raw, item, priceLow, diyLabel }) => (
          <li class="ph-card">
            <a href={partHref(lang, item.slug)} class="ph-link">
              {hasImage(partImages[item.slug]) && (
                <img
                  class="ph-shot"
                  src={`/images/${partImages[item.slug].file}`}
                  width="1200" height="900" loading="lazy" decoding="async"
                  alt={altFor(lang, partImages[item.slug])}
                />
              )}
              <h2 class="ph-name">{item.shortName}</h2>
              {priceLow !== undefined && (
                <p class="ph-price">{t.from} {money(priceLow)}</p>
              )}
              <p class="ph-answer">{item.answer.split('. ').slice(0, 2).join('. ')}.</p>
              <span class={`ph-diy ph-diy-${raw.diy}`}>{diyLabel}</span>
            </a>
          </li>
        ))}
      </ul>

      <PriceDisclaimer lang={lang} variant="block" />
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  /* Sits above the card's own padding, so the shot runs edge to edge at the
     top of the card the way the door cards on the home page do. */
  /* Bleeds over the card's 1.2rem side padding to reach its edges.
     `max-width: none` is load bearing: the global reset caps every image at
     100% of its container, which silently trimmed exactly the 2.4rem this
     adds and left a gutter down one side. `align-self: stretch` is not an
     alternative here, since a replaced element is never stretched by it. */
  .ph-shot {
    display: block; width: calc(100% + 2.4rem); max-width: none;
    margin: -1.1rem -1.2rem 0.9rem; aspect-ratio: 4 / 3; object-fit: cover;
    border-bottom: 1px solid var(--c-line); background: var(--c-bg-alt, #f4f6f8);
  }

  .ph-lead { max-width: 62ch; }
  .ph-intro { max-width: 68ch; color: var(--c-body); }
  .ph-note {
    max-width: 68ch; margin: 0 0 1.8rem;
    padding: 0.8rem 1rem; border-left: 4px solid var(--c-primary);
    background: var(--c-bg-alt, #f4f6f8); border-radius: 0 10px 10px 0;
    font-size: 0.92rem; color: var(--c-body);
  }

  .ph-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .ph-card { display: flex; }
  .ph-link {
    display: flex; flex-direction: column; gap: 0.4rem;
    width: 100%; padding: 1.1rem 1.2rem;
    background: #fff; border: 1px solid var(--c-line);
    border-radius: var(--radius, 14px); overflow: hidden;
    text-decoration: none; color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .ph-link:hover { border-color: var(--c-primary); transform: translateY(-2px); text-decoration: none; }
  .ph-name { margin: 0; font-size: 1.05rem; color: var(--c-ink); }
  .ph-price { margin: 0; font-weight: 800; color: var(--c-primary); font-size: 0.95rem; }
  .ph-answer { margin: 0; font-size: 0.88rem; line-height: 1.5; color: var(--c-body); }

  .ph-diy {
    align-self: flex-start; margin-top: auto;
    font-size: 0.72rem; font-weight: 800; letter-spacing: 0.03em;
    padding: 0.22rem 0.6rem; border-radius: 999px;
    border: 1px solid var(--c-line); background: var(--c-bg-alt, #f4f6f8);
  }
  /* Colour repeats what the words already say, it never replaces them. */
  .ph-diy-safe { color: #157a4d; border-color: #9ad3b8; }
  .ph-diy-depends { color: #8a5c0e; border-color: #e0c48a; }
  .ph-diy-no { color: #96201f; border-color: #e0a3a2; }
</style>
