---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import LeadMeta from '../LeadMeta.astro';
import PriceDisclaimer from '../PriceDisclaimer.astro';
import Icon from '../Icon.astro';
import FAQ from '../FAQ.astro';
import { business } from '../../data/business';
import { services } from '../../data/services';
import { regions } from '../../data/regions';
import { ui, paths, otherLocale, type Locale } from '../../data/ui';
import { svc, region as regionOf, copy } from '../../lib/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const p = paths[lang];
const c = copy(lang).contact;

const crumbs = [
  { name: t.breadcrumbHome, href: p.home },
  { name: t.breadcrumbContact, href: p.contact },
];

const serviceOptions = services.map((s) => svc(lang, s));
const regionOptions = [...regions].sort((a, b) => a.order - b.order).map((r) => regionOf(lang, r));

/**
 * Where the form posts.
 *
 * Unset: Netlify Forms handles it, via the data-netlify attributes below.
 * Set: the form posts straight to that URL, which is how this site runs on
 * any host that has no forms product of its own, Cloudflare Pages included.
 * Point it at the Make webhook and the eight network lead fields arrive
 * there unchanged.
 *
 * It is PUBLIC_ because it ends up in the HTML, which is fine: a webhook
 * URL is an address, not a credential. Never put a signing secret in it.
 */
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const usesNetlifyForms = formEndpoint === '';
/* One Netlify form definition serves both languages; `locale` on the
   submission says which one it came from. */
const formName = 'quote';

/**
 * The three cards on step one.
 *
 * Coarse on purpose. A visitor who has just heard a bang in the garage
 * knows which of these three they are; they do not yet know whether they
 * need a torsion spring or a cable. The precise service select stays on
 * step two for the ones who do know. `job_type` reaches the lead either
 * way, which is what lets a callback open with the right question.
 *
 * Images are decorative here: the text label carries the meaning, so alt
 * is empty deliberately rather than by omission.
 */
const jobTypes = [
  { value: 'repair', file: 'garage-door-parts-overview.webp', title: t.wizJobRepair, note: t.wizJobRepairNote },
  { value: 'new_door', file: 'new-garage-door-installed.webp', title: t.wizJobDoor, note: t.wizJobDoorNote },
  { value: 'opener', file: 'opener-motor-unit.webp', title: t.wizJobOpener, note: t.wizJobOpenerNote },
];
---
<BaseLayout title={c.metaTitle} description={c.metaDescription} lang={lang} altHref={paths[otherLocale(lang)].contact}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="section">
    <div class="container contact-grid">
      <div class="form-col">
        <span class="eyebrow">{t.eyebrowFreeQuote}</span>
        <div class="stripe-rule" aria-hidden="true"></div>
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>

        <form
          name={formName}
          method="POST"
          data-netlify={usesNetlifyForms ? 'true' : undefined}
          netlify-honeypot={usesNetlifyForms ? 'bot-field' : undefined}
          action={usesNetlifyForms ? p.thankYou : formEndpoint}
          class="quote-form card"
        >
          {usesNetlifyForms && <input type="hidden" name="form-name" value={formName} />}
          {/* Where the submission should land when the host does not
              redirect for us. Make reads this and 302s the visitor. */}
          {!usesNetlifyForms && <input type="hidden" name="redirect_to" value={p.thankYou} />}
          <p class="hp">
            <label>{t.formHoneypot} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          {/* Stamped on load, read on submit. Nobody fills this form in four
              seconds; a script does it instantly. See the guard below. */}
          <input type="hidden" name="loaded_at" id="loaded-at" value="" />
          <LeadMeta source="contact_form" lang={lang} />

          {/* The rail and the step nav below are hidden until the script
              runs. Without it every step stays open and this is the same
              single page form it has always been. */}
          <ol class="wz-rail" id="wz-rail" hidden>
            <li><span class="wz-num">1</span><span class="wz-lbl">{t.wizStep1}</span></li>
            <li><span class="wz-num">2</span><span class="wz-lbl">{t.wizStep2}</span></li>
            <li><span class="wz-num">3</span><span class="wz-lbl">{t.wizStep3}</span></li>
          </ol>

          <div class="wz-step" data-step="1">
            <p class="wz-legend" id="wz-job-legend">{t.wizJobLegend} <span aria-hidden="true">*</span></p>
            <div class="wz-jobs" role="radiogroup" aria-labelledby="wz-job-legend">
              {jobTypes.map((j) => (
                <label class="wz-job">
                  <input type="radio" name="job_type" value={j.value} required />
                  <img src={`/images/${j.file}`} width="1200" height="900" alt="" loading="lazy" decoding="async" />
                  <span class="wz-job-title">{j.title}</span>
                  <span class="wz-job-note">{j.note}</span>
                </label>
              ))}
            </div>

            <div class="field">
              <label for="zip">{t.formZip} <span aria-hidden="true">*</span></label>
              <input
                type="text" id="zip" name="zip" required
                inputmode="numeric" pattern="[0-9]{5}" maxlength="5"
                title={t.formZipTitle}
                autocomplete="postal-code"
              />
            </div>
          </div>

          <div class="wz-step" data-step="2">
            <div class="field">
              <label for="symptom">{t.formSymptom}</label>
              <select id="symptom" name="symptom">
                {c.symptoms.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>

            <div class="field-row">
              <div class="field">
                <label for="urgency">{t.formUrgency}</label>
                <select id="urgency" name="urgency">
                  {c.urgency.map((u, i) => <option value={u} selected={i === 1}>{u}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="window">{t.wizWindow}</label>
                <select id="window" name="window">
                  {c.windows.map((w, i) => <option value={w} selected={i === 3}>{w}</option>)}
                </select>
              </div>
            </div>
            <p class="wz-note">{t.wizWindowNote}</p>

            <div class="field-row">
              <div class="field">
                <label for="area">{t.formArea}</label>
                <select id="area" name="area">
                  <option value="">{t.formAreaSelect}</option>
                  {regionOptions.map((r) => <option value={r.name}>{r.name}</option>)}
                  <option value="Other">{t.formAreaOther}</option>
                </select>
              </div>
              <div class="field">
                <label for="service">{t.formService}</label>
                <select id="service" name="service">
                  <option value="Not sure">{t.formServiceNotSure}</option>
                  {serviceOptions.map((s) => <option value={s.name}>{s.name}</option>)}
                </select>
              </div>
            </div>
          </div>

          <div class="wz-step" data-step="3">
            <div class="field-row">
              <div class="field">
                <label for="name">{t.formName} <span aria-hidden="true">*</span></label>
                <input type="text" id="name" name="name" required autocomplete="name" />
              </div>
              <div class="field">
                <label for="phone">{t.formPhone} <span aria-hidden="true">*</span></label>
                <input type="tel" id="phone" name="phone" required autocomplete="tel" />
              </div>
            </div>

            <div class="field">
              <label for="email">{t.formEmail}</label>
              <input type="email" id="email" name="email" autocomplete="email" />
            </div>

            <div class="field">
              <label for="message">{t.formMessage}</label>
              <textarea id="message" name="message" rows="4" placeholder={t.formMessagePlaceholder}></textarea>
            </div>

            {/* Filled by the script on arrival at this step, so the visitor
                sees what they picked without paging back. Stays empty and
                hidden when the script never runs. */}
            <div class="wz-review" id="wz-review" hidden>
              <h2 class="wz-review-h">{t.wizReviewHeading}</h2>
              <dl id="wz-review-list"></dl>
            </div>

            <button type="submit" class="btn btn-accent btn-lg full">{t.formSubmit}</button>
            <p class="form-note">{t.formNote}</p>
          </div>

          {/* Outside the steps: an error raised on step one has to stay
              visible on step one. */}
          <p class="form-error" id="form-error" role="alert" hidden></p>

          <div class="wz-nav" id="wz-nav" hidden>
            <button type="button" class="btn btn-outline" data-wz="back">{t.wizBack}</button>
            <button type="button" class="btn btn-accent" data-wz="next">{t.wizNext}</button>
          </div>
        </form>
      </div>

      <aside class="info-col">
        <div class="card info-card">
          <h2>{t.whatWeSendBack}</h2>
          <ul class="check-list">
            {t.sendBack.map((s) => <li>{s}</li>)}
          </ul>
        </div>

        <div class="card info-card">
          <h2>{t.contactHeading}</h2>
          {business.phoneLive && (
            <p class="contact-method">
              <span class="cm-ico"><Icon name="phone" size={18} /></span>
              <span><strong><a href={`tel:${business.phoneHref}`}>{business.phone}</a></strong><br />{t.contactSevenDays}</span>
            </p>
          )}
          {business.emailLive && (
            <>
              <p class="contact-method">
                <span class="cm-ico"><Icon name="quote" size={18} /></span>
                <span>
                  <a href={`mailto:${business.email}`}><strong>{business.email}</strong></a><br />
                  {t.contactEmailNote}
                </span>
              </p>
              <p class="contact-method">
                <span class="cm-ico"><Icon name="quote" size={18} /></span>
                <span>
                  <a href={`mailto:${business.emailSupport}`}><strong>{business.emailSupport}</strong></a><br />
                  {t.contactSupportNote}
                </span>
              </p>
            </>
          )}
          <p class="contact-method">
            <span class="cm-ico"><Icon name="pin" size={18} /></span>
            <span>
              <strong>{lang === 'es' ? 'Florida' : business.serviceArea}</strong><br />
              {t.contactAreaNote}
            </span>
          </p>
        </div>

        <div class="card info-card">
          <h2>{t.hoursHeading}</h2>
          <ul class="hours">
            {business.hours.map((h) => (
              <li><span>{h.days}</span><span>{h.opens} {lang === 'es' ? 'a' : 'to'} {h.closes}</span></li>
            ))}
          </ul>
          <p class="hours-note">{t.hoursNote}</p>
        </div>

        <PriceDisclaimer lang={lang} />
      </aside>
    </div>

    <div class="container narrow">
      <FAQ items={c.faq} title={t.aboutGettingQuote} lang={lang} />
    </div>
  </section>

  <script is:inline define:vars={{ msgFill: t.errFill('%s'), msgFormat: t.errFormat, msgFast: t.errFast, msgZip: t.errZip, msgPitch: t.errPitch, requiredField: t.requiredField, msgPickJob: t.wizPickJob, lang }}>
    (function () {
      var form = document.querySelector('form[name="quote"]');
      if (!form) return;

      /* quote_start fires once, the first time anyone touches the form.
         Paired with generate_lead on the thank-you page this gives a real
         funnel: how many people start against how many finish. */
      var fired = false;
      form.addEventListener('focusin', function () {
        if (fired || typeof window.gtag !== 'function') return;
        fired = true;
        window.gtag('event', 'quote_start', { page_path: location.pathname, site_language: lang });
      });

      /* The browser blocks submit on an invalid required field and focuses
         it. On a form this long the offending field is usually scrolled off
         screen, so from the visitor's position the button appears to do
         nothing at all. On a lead form that is the worst possible failure.

         The hook is the "invalid" event, not "submit". The browser runs
         constraint validation BEFORE dispatching submit, and when it fails
         it never dispatches submit at all. invalid does not bubble either,
         hence the capture phase. */
      var box = document.getElementById('form-error');
      var reporting = false;

      form.addEventListener(
        'invalid',
        function (e) {
          if (reporting) return;
          reporting = true;
          setTimeout(function () { reporting = false; }, 0);

          var bad = e.target;
          var label = form.querySelector('label[for="' + bad.id + '"]');
          var name = label ? label.textContent.replace('*', '').trim() : requiredField;

          if (box) {
            box.textContent = bad.validity.patternMismatch
              ? name + ': ' + (bad.title || msgFormat)
              : msgFill.replace('%s', name);
            box.hidden = false;
          }

          bad.scrollIntoView({ block: 'center', behavior: 'smooth' });

          if (typeof window.gtag === 'function') {
            window.gtag('event', 'quote_blocked', { field: bad.name });
          }
        },
        true
      );

      form.addEventListener('submit', function () {
        if (box) box.hidden = true;
      });

      form.addEventListener('input', function () {
        if (box && !box.hidden && form.checkValidity()) box.hidden = true;
      });

      /* Spam guard. Three checks, none of which a real visitor can trip by
         accident. Everything here is client side, so it stops volume rather
         than a determined attacker. That is the right trade: it costs a real
         visitor nothing and removes the noise that makes a genuine lead easy
         to miss. */
      var loadedAt = document.getElementById('loaded-at');
      if (loadedAt) loadedAt.value = String(Date.now());

      /* Florida ZIP codes run 32000 to 34999, with 320 to 349 as the
         three digit prefixes. Nothing outside that is in our service area. */
      function zipInArea(zip) {
        var n = parseInt(String(zip).slice(0, 3), 10);
        if (isNaN(n)) return false;
        return n >= 320 && n <= 349;
      }

      /* Two or more of these in the free text field means a sales pitch, not
         a garage door. One alone is allowed, so a customer who happens to
         write "audit" or "call" is never blocked. */
      var PITCH = [
        'seo', 'backlink', 'ranking', 'rankings', 'digital marketing',
        'web design', 'website design', 'audit', 'visibility', 'leads for',
        'crypto', 'guest post', 'link building', 'outreach',
        'partnership opportunity', 'increase your sales', 'grow your business',
        'quick call', 'minute call', 'chatgpt', 'ai seo',
        'posicionamiento', 'marketing digital', 'diseno web', 'diseño web'
      ];

      function pitchScore(text) {
        var t = (text || '').toLowerCase();
        var hits = 0;
        for (var i = 0; i < PITCH.length; i++) {
          if (t.indexOf(PITCH[i]) !== -1) hits++;
        }
        return hits;
      }

      function reject(message, field) {
        if (box) {
          box.textContent = message;
          box.hidden = false;
          box.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }
        if (field) field.focus({ preventScroll: true });
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'quote_blocked_spam', { reason: message.slice(0, 60) });
        }
      }

      form.addEventListener('submit', function (e) {
        var zip = form.querySelector('[name="zip"]');
        var msg = form.querySelector('[name="message"]');
        var elapsed = loadedAt && loadedAt.value ? Date.now() - parseInt(loadedAt.value, 10) : 99999;

        if (elapsed < 4000) {
          e.preventDefault();
          reject(msgFast, null);
          return;
        }

        if (zip && zip.value && !zipInArea(zip.value)) {
          e.preventDefault();
          reject(msgZip, zip);
          return;
        }

        if (msg && pitchScore(msg.value) >= 2) {
          e.preventDefault();
          reject(msgPitch, msg);
          return;
        }
      });

      /* ------------------------------------------------------------------
         Three steps instead of one long form.

         This is progressive enhancement, not a rewrite. Everything above
         still runs; the markup below it is the same form with the same
         field names, the same Netlify definition and the same guards. If
         this block never executes, every step stays open and the page
         behaves exactly as it did before.

         Why not copy Precision Door's four steps with real bookable time
         slots: their widget is the front end of a franchise dispatch desk
         staffed around the clock, so a slot it offers is a slot somebody
         can honour. Ours routes to partner crews and is confirmed by
         phone. Showing "Today, 2PM to 4PM" as bookable would be a promise
         the phone call then has to take back, which costs more trust than
         the extra conversion is worth. We ask which part of the day suits
         and say so in as many words on step two.
         ------------------------------------------------------------------ */
      var steps = [].slice.call(form.querySelectorAll('.wz-step'));
      var rail = document.getElementById('wz-rail');
      var nav = document.getElementById('wz-nav');

      if (steps.length === 3 && rail && nav) {
        var at = 0;
        var railItems = [].slice.call(rail.children);
        var backBtn = nav.querySelector('[data-wz="back"]');
        var nextBtn = nav.querySelector('[data-wz="next"]');
        var review = document.getElementById('wz-review');
        var reviewList = document.getElementById('wz-review-list');

        rail.hidden = false;
        nav.hidden = false;

        function labelFor(el) {
          var l = el.id ? form.querySelector('label[for="' + el.id + '"]') : null;
          return l ? l.textContent.replace('*', '').trim() : el.name;
        }

        function fillReview() {
          if (!review || !reviewList) return;
          reviewList.textContent = '';
          var picked = form.querySelector('input[name="job_type"]:checked');
          var rows = [];
          if (picked) {
            var title = picked.parentNode.querySelector('.wz-job-title');
            rows.push([document.getElementById('wz-job-legend').textContent.replace('*', '').trim(),
                       title ? title.textContent : picked.value]);
          }
          ['zip', 'symptom', 'urgency', 'window'].forEach(function (n) {
            var el = form.querySelector('[name="' + n + '"]');
            if (el && el.value) rows.push([labelFor(el), el.value]);
          });
          rows.forEach(function (r) {
            var dt = document.createElement('dt');
            dt.textContent = r[0];
            var dd = document.createElement('dd');
            dd.textContent = r[1];
            reviewList.appendChild(dt);
            reviewList.appendChild(dd);
          });
          review.hidden = rows.length === 0;
        }

        function render() {
          for (var i = 0; i < steps.length; i++) steps[i].hidden = i !== at;
          for (var j = 0; j < railItems.length; j++) {
            railItems[j].className =
              j === at ? 'is-at' : j < at ? 'is-done' : '';
            if (j === at) railItems[j].setAttribute('aria-current', 'step');
            else railItems[j].removeAttribute('aria-current');
          }
          backBtn.hidden = at === 0;
          nextBtn.hidden = at === steps.length - 1;
          if (at === steps.length - 1) fillReview();
        }

        /* checkValidity fires the invalid event, so the message box above
           fills itself. The one case it cannot label is the radio group,
           which has no `for` label to read a name from. */
        function stepValid() {
          var fields = [].slice.call(
            steps[at].querySelectorAll('input, select, textarea')
          );
          for (var i = 0; i < fields.length; i++) {
            if (fields[i].checkValidity()) continue;
            if (fields[i].name === 'job_type' && box) {
              box.textContent = msgPickJob;
              box.hidden = false;
            }
            fields[i].focus({ preventScroll: true });
            return false;
          }
          return true;
        }

        function go(to) {
          at = Math.max(0, Math.min(steps.length - 1, to));
          if (box) box.hidden = true;
          render();
          form.scrollIntoView({ block: 'start' });
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'quote_step', { step: at + 1, site_language: lang });
          }
        }

        nextBtn.addEventListener('click', function () {
          if (stepValid()) go(at + 1);
        });
        backBtn.addEventListener('click', function () { go(at - 1); });

        /* Picking a card is an unambiguous answer to the only question on
           step one, so clear a stale error the moment one is chosen. */
        form.addEventListener('change', function (e) {
          if (e.target && e.target.name === 'job_type' && box) box.hidden = true;
        });

        /* Enter inside a text field would otherwise submit a form whose
           later steps are still empty, and the browser would report the
           first missing field on a step nobody can see. */
        form.addEventListener('keydown', function (e) {
          if (e.key !== 'Enter') return;
          var tag = e.target.tagName;
          if (tag === 'TEXTAREA' || e.target.type === 'submit') return;
          if (at < steps.length - 1) {
            e.preventDefault();
            if (stepValid()) go(at + 1);
          }
        });

        render();
      }
    })();
  </script>
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr); gap: 2.5rem; align-items: start; }
  .narrow { max-width: var(--maxw-narrow); }

  .quote-form { margin-top: 1.5rem; }

  /* Booking steps. Every rule here is additive: with the script off none of
     these elements is rendered except .wz-step, which styles as a plain
     block, and .wz-jobs, which is a useful layout either way. */
  /* The UA rule for [hidden] is display:none, and any author display rule
     beats it. Everything below that both sets display and gets toggled by
     the script needs this or it stays on screen with hidden set: the rail
     and the nav when the script never runs, Back on step one, Next on the
     last step beside the submit button. */
  .wz-rail[hidden], .wz-nav[hidden], .wz-nav button[hidden] { display: none; }

  .wz-rail {
    display: grid; grid-template-columns: repeat(3, 1fr);
    list-style: none; padding: 0; margin: 0 0 1.4rem;
    counter-reset: none;
  }
  .wz-rail li {
    display: flex; flex-direction: column; align-items: center; gap: 0.35rem;
    position: relative; text-align: center;
    font-size: 0.78rem; color: var(--c-muted);
  }
  /* The connector sits behind the numbers rather than between them, so it
     does not shift when a label wraps to two lines. */
  .wz-rail li::before {
    content: ''; position: absolute; top: 0.9rem; right: 50%; left: -50%;
    height: 2px; background: var(--c-line);
  }
  .wz-rail li:first-child::before { display: none; }
  .wz-num {
    display: grid; place-items: center; position: relative;
    width: 1.8rem; height: 1.8rem; border-radius: 50%;
    background: #fff; border: 2px solid var(--c-line);
    font-weight: 800; font-size: 0.85rem; color: var(--c-muted);
  }
  .wz-rail li.is-at { color: var(--c-ink); font-weight: 700; }
  .wz-rail li.is-at .wz-num { border-color: var(--c-primary); color: var(--c-primary); }
  .wz-rail li.is-done .wz-num { background: var(--c-primary); border-color: var(--c-primary); color: #fff; }
  .wz-rail li.is-done::before { background: var(--c-primary); }

  .wz-legend { font-size: 0.95rem; font-weight: 800; color: var(--c-ink); margin: 0 0 0.7rem; }
  .wz-legend span { color: var(--c-accent); }

  .wz-jobs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; margin-bottom: 1.3rem; }
  .wz-job {
    display: block; cursor: pointer; overflow: hidden; text-align: center;
    border: 2px solid var(--c-line); border-radius: var(--radius);
    background: #fff; padding-bottom: 0.8rem;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .wz-job:hover { border-color: #c8cfd8; }
  .wz-job img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  /* Visually hidden, not display:none: a removed radio is not focusable and
     cannot be reached by keyboard or reported as invalid. */
  .wz-job input {
    position: absolute; width: 1px; height: 1px;
    margin: -1px; padding: 0; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }
  .wz-job-title { display: block; margin: 0.6rem 0.6rem 0.15rem; font-weight: 800; font-size: 0.92rem; color: var(--c-ink); }
  .wz-job-note { display: block; margin: 0 0.6rem; font-size: 0.78rem; color: var(--c-muted); line-height: 1.35; }
