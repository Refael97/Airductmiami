---
/**
 * One service page, either language. The route files under src/pages and
 * src/pages/es pass the base service and the locale; everything else is
 * derived here so the two languages cannot drift structurally.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import AnswerBox from '../AnswerBox.astro';
import QuickFacts from '../QuickFacts.astro';
import PriceDisclaimer from '../PriceDisclaimer.astro';
import CtaBand from '../CtaBand.astro';
import FAQ from '../FAQ.astro';
import Icon from '../Icon.astro';
import { getService } from '../../data/services';
import type { Service } from '../../data/types';
import { iconFor } from '../../data/serviceIcons';
import { citiesByPotential } from '../../data/cities';
import { serviceSchema } from '../../lib/schema';
import { guidesForService } from '../../lib/relatedContent';
import { serviceImages, hasImage, altFor } from '../../data/pageImages';
import { ui, paths, serviceHref, areaHref, blogHref, money, otherLocale, type Locale } from '../../data/ui';
import { svc, city as cityOf } from '../../lib/i18n';

interface Props { lang: Locale; base: Service }
const { lang, base } = Astro.props;
const t = ui[lang];
const p = paths[lang];
const service = svc(lang, base);

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const href = serviceHref(lang, service.slug);
const url = `${site}${href}`;

const crumbs = [
  { name: t.breadcrumbHome, href: p.home },
  { name: t.breadcrumbServices, href: p.services },
  { name: service.shortName, href },
];

const related = service.related
  .map((slug) => getService(slug))
  .filter((s): s is Service => Boolean(s))
  .map((s) => svc(lang, s));

const topCities = citiesByPotential().slice(0, 12).map((c) => cityOf(lang, c));
const guides = await guidesForService(lang, service.slug);
const pageImg = serviceImages[service.slug];

const schema = serviceSchema(site, {
  name: service.name,
  description: service.metaDescription,
  url,
  slug: service.slug,
  priceLow: service.priceLow,
  priceHigh: service.priceHigh,
});
---
<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  schema={schema}
  lang={lang}
  altHref={serviceHref(otherLocale(lang), service.slug)}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="svc-hero">
    <div class="container svc-hero-inner">
      <div>
        <span class="eyebrow">{t.eyebrowService}</span>
        <div class="stripe-rule" aria-hidden="true"></div>
        <h1>{service.name}</h1>
        <p class="lead">{service.metaDescription}</p>
        <div class="hero-actions">
          <a href={p.contact} class="btn btn-accent btn-lg">{t.getFreeQuote}</a>
          <a href={p.prices} class="btn btn-outline btn-lg">{t.fullPriceList}</a>
        </div>
      </div>
      <aside class="price-card" data-anim="fade-up">
        <span class="pc-icon"><Icon name={iconFor(service.slug)} size={34} /></span>
        <span class="pc-label">{t.startingPrice}</span>
        <span class="pc-price">{t.from} {money(service.priceLow)}</span>
        <span class="pc-range">{t.typicalRange(money(service.priceLow), money(service.priceHigh))}</span>
        <p class="pc-note">{service.priceNote}</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container svc-body">
      <article class="prose">
        <AnswerBox text={service.answer} lang={lang} />

        {hasImage(pageImg) && (
          <figure class="page-figure">
            <img
              src={`/images/${pageImg!.file}`}
              width="1200" height="900" loading="lazy" decoding="async"
              alt={altFor(lang, pageImg!)}
            />
            <figcaption>{t.illustrationNote}</figcaption>
          </figure>
        )}

        {service.intro.map((para) => <p>{para}</p>)}

        <h2>{t.whatMovesPrice}</h2>
        <p>{t.whatMovesPriceText}</p>
        <ul class="check-list">
          {service.priceFactors.map((f) => <li>{f}</li>)}
        </ul>

        <QuickFacts facts={service.quickFacts} />

        <h2>{t.whyPickUs}</h2>
        <div class="benefit-grid">
          {service.benefits.map((b) => (
            <div class="benefit">
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </div>
          ))}
        </div>

        <h2>{t.howJobRuns}</h2>
        <ol class="process">
          {service.process.map((step) => (
            <li>
              <strong>{step.title}.</strong> {step.text}
            </li>
          ))}
        </ol>

        <PriceDisclaimer variant="block" lang={lang} />

        <FAQ items={service.faq} title={t.serviceQuestions(service.shortName)} lang={lang} />
      </article>

      <aside class="svc-aside">
        <div class="card aside-card">
          <h3>{t.relatedServices}</h3>
          <ul class="plain">
            {related.map((r) => (
              <li>
                <a href={serviceHref(lang, r.slug)}>{r.name}</a>
                <span>{t.from} {money(r.priceLow)}</span>
              </li>
            ))}
          </ul>
        </div>
        {guides.length > 0 && (
          <div class="card aside-card">
            <h3>{t.guidesOnThis}</h3>
            <ul class="plain guide-links">
              {guides.map((g) => (
                <li><a href={blogHref(lang, g.id)}>{g.data.title}</a></li>
              ))}
            </ul>
            <a href={p.blog} class="aside-more">{t.allGuidesArrow}</a>
          </div>
        )}
        <div class="card aside-card">
          <h3>{t.whereWeWork}</h3>
          <p class="aside-note">{t.whereWeWorkNote}</p>
          <ul class="area-links">
            {topCities.map((c) => (
              <li><a href={areaHref(lang, c.slug)}>{c.name}</a></li>
            ))}
          </ul>
          <a href={p.serviceAreas} class="aside-more">{t.allAreasArrow}</a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .svc-hero { background: var(--grad-hero); padding-block: 2.4rem 2.8rem; }
  .svc-hero-inner { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 2.5rem; align-items: center; }
  .svc-hero h1 { margin-bottom: 0.8rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.4rem; }

  .price-card {
    background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius);
    box-shadow: var(--shadow-card); padding: 1.75rem; text-align: center;
    position: relative; overflow: hidden;
  }
  .price-card::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 5px;
    background: var(--stripe-brand);
  }
  .pc-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 3.6rem; height: 3.6rem; border-radius: 12px;
    background: var(--c-primary-light); color: var(--c-primary);
    margin-bottom: 0.8rem;
  }
  .pc-label {
    display: block; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--c-muted);
  }
  .pc-price {
    display: block; font-family: var(--font-display); font-weight: 400;
    font-size: 2.8rem; line-height: 1.05; color: var(--c-primary); margin: 0.2rem 0;
  }
  .pc-range { display: block; font-size: 0.88rem; font-weight: 700; color: var(--c-body); }
  .pc-note { font-size: 0.84rem; color: var(--c-muted); margin: 0.7rem 0 0; }

  .svc-body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 2.5rem; align-items: start; }
  .svc-body .prose { max-width: none; }

  .benefit-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.2rem; margin: 1.4rem 0 0; }
  .benefit h3 { font-size: 1rem; margin-bottom: 0.3rem; }
  .benefit p { font-size: 0.93rem; margin: 0; }

  .process { padding-left: 1.2rem; }
  .process li { margin-bottom: 0.7rem; }
  .process strong { color: var(--c-ink); }

  .svc-aside { position: sticky; top: 6.5rem; display: grid; gap: 1.2rem; }
  .aside-card h3 { font-size: 1rem; margin-bottom: 0.8rem; }
  .aside-note { font-size: 0.86rem; color: var(--c-muted); margin-bottom: 0.7rem; }
  .plain { list-style: none; padding: 0; margin: 0; }
  .plain li {
    display: flex; justify-content: space-between; gap: 0.6rem;
    padding: 0.45rem 0; border-bottom: 1px solid var(--c-line); font-size: 0.9rem;
  }
  .plain li:last-child { border-bottom: 0; }
  .plain span { color: var(--c-primary); font-weight: 700; white-space: nowrap; }
  .page-figure { margin: 1.6rem 0 1.8rem; }
  .page-figure img {
    width: 100%; height: auto; border-radius: 12px; display: block;
    border: 1px solid var(--c-line);
  }
  .page-figure figcaption {
    font-size: 0.8rem; color: var(--c-muted); margin-top: 0.55rem;
    line-height: 1.5;
  }
  .guide-links li { display: block; line-height: 1.4; }
  .area-links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 0.8rem; }
  .area-links a { font-size: 0.88rem; }
  .aside-more { display: inline-block; margin-top: 0.9rem; font-size: 0.88rem; font-weight: 700; }

  @media (max-width: 960px) {
    .svc-hero-inner { grid-template-columns: 1fr; gap: 1.8rem; }
    .svc-body { grid-template-columns: 1fr; }
    .svc-aside { position: static; }
  }
</style>
