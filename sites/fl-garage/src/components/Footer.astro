---
import { business } from '../data/business';
import { services } from '../data/services';
import { ui, paths, serviceHref, type Locale } from '../data/ui';
import { svc } from '../lib/i18n';

interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props;
const t = ui[lang];
const p = paths[lang];

const year = new Date().getFullYear();
const footerServices = services.slice(0, 6).map((s) => svc(lang, s));
const regionLabel = lang === 'es' ? 'Florida' : business.area.regionName;
---
<footer class="site-footer">
  <!-- A Florida horizon, drawn as a decorative band along the top of the
       footer: low flat-roofed houses, two palms, a water line. Purely
       graphic, so it is hidden from assistive tech. -->
  <svg class="skyline" viewBox="0 0 1200 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M0 90V70h40V52h12V44h6V52h60V58h8V46h40V58h50V50h14V42h6V50h44V60h30V48h48V60h20V52h60V44h10V52h50V60h24V50h14V40h6V50h40V60h60V46h50V60h30V52h56V44h8V52h58V60h26V48h44V60h48V54h62V46h12V54h50V60h30V50h60V40h6V50h44V62h20V54h64v36z"
    />
    <path
      fill="currentColor"
      d="M300 90V62h-6V90zm-3-30c-8-2-14-8-16-14 8 0 14 4 16 10-1-6 2-12 8-15 1 7-2 13-8 17 6-3 13-2 18 3-6 4-12 4-18 1 5 3 8 9 7 15-6-3-9-8-9-15-1 7-5 12-11 14 0-6 4-11 9-14zM880 90V60h-6V90zm-3-32c-9-2-15-9-17-16 9 0 16 5 17 12-1-7 3-14 9-17 1 8-2 15-9 19 7-3 15-2 20 4-7 4-14 4-20 1 5 4 9 10 8 17-7-3-10-9-10-17-1 8-5 13-12 16 0-7 4-12 10-16z"
    />
  </svg>

  <div class="container footer-grid">
    <div class="footer-col footer-about">
      <span class="footer-brand">
        <img src="/logo.svg" alt="" width="34" height="34" />
        {business.name}
      </span>
      <p>{business.tagline}</p>
      {/* Only channels that actually work are shown. See business.ts. */}
      <p class="footer-contact">
        {business.phoneLive && (
          <><a href={`tel:${business.phoneHref}`}>{business.phone}</a><br /></>
        )}
        {business.emailLive ? (
          <>
            <a href={`mailto:${business.email}`}>{business.email}</a>
            <span class="mail-note">{t.footerMailQuotes}</span>
            <a href={`mailto:${business.emailSupport}`}>{business.emailSupport}</a>
            <span class="mail-note">{t.footerMailSupport}</span>
          </>
        ) : (
          <a href={p.contact}>{t.footerRequestQuote}</a>
        )}
      </p>
      <span class="footer-badge">{t.footerLicensed}</span>

      {/* Locality block. A service area business publishes where it works,
          not a street address. No street line and no ZIP: inventing either
          is what gets a Business Profile suspended. */}
      <address class="footer-address">
        <strong>{business.name}</strong><br />
        {t.footerMobile(regionLabel)}<br />
        {t.footerBased(business.area.primaryCounty, business.area.region, business.area.country)}
      </address>
      <p class="footer-areas">
        {t.footerServing} {business.area.counties.join(' · ')}
      </p>
      <p class="footer-areas-note">{t.footerNoWalkIn}</p>
    </div>

    <div class="footer-col">
      <h3>{t.footerServices}</h3>
      <ul>
        {footerServices.map((s) => (<li><a href={serviceHref(lang, s.slug)}>{s.shortName}</a></li>))}
        <li><a href={p.services}>{t.allServicesArrow}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>{t.footerPricesGuides}</h3>
      <ul>
        <li><a href={p.prices}>{t.footerPriceList}</a></li>
        <li><a href={p.buyersGuide}>{t.footerDoorsGuide}</a></li>
        <li><a href={p.blog}>{t.footerGuides}</a></li>
        <li><a href={p.faq}>{t.footerFaq}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>{t.footerCompany}</h3>
      <ul>
        <li><a href={p.serviceAreas}>{t.footerAllAreas}</a></li>
        <li><a href={p.about}>{t.footerAbout}</a></li>
        <li><a href={p.contact}>{t.footerQuote}</a></li>
        <li><a href={p.privacy}>{t.footerPrivacy}</a></li>
        <li><a href={paths[lang === 'en' ? 'es' : 'en'].home} hreflang={lang === 'en' ? 'es' : 'en'} rel="alternate">{t.langSwitch}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {year} {business.legalName}. {t.footerRights} · {t.footerServingArea(regionLabel)}</p>
      <p class="agent-link"><a href="/agent.json">{t.footerAgent}</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-primary); color: #b8c4d2; margin-top: 4rem;
    position: relative; padding-top: 2.5rem; overflow: hidden;
  }
  .site-footer::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 4px;
    background: var(--stripe-brand);
  }
  /* Sits inside the footer so it never overlaps the section above. */
  .skyline {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 58px; display: block;
    color: rgba(255, 255, 255, 0.055);
  }
  .footer-grid {
    display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.2rem; padding-block: 1rem 2.2rem;
  }
  .footer-brand {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-display); font-weight: 400;
    text-transform: uppercase; letter-spacing: 0.015em;
    font-size: 1.55rem; line-height: 1; color: #fff; margin-bottom: 0.7rem;
  }
  .footer-about p { font-size: 0.9rem; margin-bottom: 0.7rem; }
  .footer-contact a { color: #d8e2ee; display: block; }
  /* Two mailboxes, split by what the message is about rather than by
     department. Saying which is which stops quote requests landing in the
     warranty queue and back again. */
  .mail-note {
    display: block; font-size: 0.76rem; color: #8c9aab;
    margin: 0.1rem 0 0.5rem;
  }
  .footer-badge {
    display: inline-block; font-size: 0.78rem; color: #ff9b9b;
    font-weight: 700; border: 1px solid rgba(214, 40, 40, 0.65);
    padding: 0.3rem 0.7rem; border-radius: 999px;
  }
  /* Locality block. Reads as an address without pretending to be a postal
     one, which is exactly what a service area business should publish. */
  .footer-address {
    font-style: normal; font-size: 0.88rem; line-height: 1.6;
    color: #c3cedb; margin-top: 1.1rem;
  }
  .footer-address strong { color: #fff; font-weight: 700; }
  .footer-areas { font-size: 0.84rem; color: #a9b6c6; margin-top: 0.7rem; }
  .footer-areas-note {
    font-size: 0.8rem; color: #8c9aab; margin-top: 0.35rem; font-style: italic;
  }
  .footer-col h3 { color: #fff; font-size: 0.98rem; margin-bottom: 0.8rem; }
  .footer-col ul { list-style: none; padding: 0; margin: 0; }
  .footer-col li { margin-bottom: 0.45rem; }
  .footer-col a { color: #a9b6c6; font-size: 0.9rem; text-decoration: none; }
  .footer-col a:hover { color: #fff; text-decoration: underline; }
  .footer-bottom { border-top: 1px solid rgba(255, 255, 255, 0.08); padding-block: 1.2rem; }
  .footer-bottom p { margin: 0; font-size: 0.82rem; color: #7e8b9b; }
  .agent-link { margin-top: 0.4rem; }
  .agent-link a { color: #7e8b9b; font-size: 0.78rem; text-decoration: none; }
  .agent-link a:hover { color: #a9b6c6; text-decoration: underline; }

  @media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 1.6rem; } }
  @media (max-width: 480px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
