---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guidesForCity } from '../../lib/relatedContent';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import CTABand from '../../components/CTABand.astro';
import { cities, getCity } from '../../data/cities';
import { services } from '../../data/services';
import { business } from '../../data/business';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { serviceSchema } from '../../lib/schema';
import { cityMeta, PRICES } from '../../lib/meta';
import { cityDetail } from '../../data/cityDetail';

export const getStaticPaths = (() => {
  return cities.map((c) => ({ params: { city: c.slug } }));
}) satisfies GetStaticPaths;

const { city: slug } = Astro.params;
const city = getCity(slug!)!;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = `${site}/service-areas/${city.slug}`;

const { title: metaTitle, description: metaDescription } = cityMeta(city);

const schema = serviceSchema(site, {
  name: `Air Duct Cleaning in ${city.name}, FL`,
  description: metaDescription,
  url: pageUrl,
  slug: city.slug,
});

const cityFaq = [
  { question: `How much does air duct cleaning cost in ${city.name}?`, answer: `In ${city.name}, a complete single-system air duct cleaning typically costs $300 to $600, and dryer vent cleaning runs $100 to $200. We provide free, upfront quotes with no hidden fees.` },
  { question: `How often should ${city.name} homeowners clean their air ducts?`, answer: `Every 3 to 5 years for most ${city.name} homes, and more often with pets, allergies, or a history of mold. ${city.local}` },
  { question: `Do you offer same-week appointments in ${city.name}?`, answer: `Yes. We offer fast, often same-week scheduling for ${city.name} and the surrounding ${city.county} area. Call ${business.phone} to book.` },
  { question: `Are your ${city.name} technicians licensed and insured?`, answer: `Yes. Every technician serving ${city.name} is licensed and insured, and we follow NADCA source-removal standards for safe, thorough duct cleaning.` },
];

const nearby = city.nearby
  .map((n) => getCity(n))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const detail = cityDetail[city.slug] ?? { neighborhoods: [] };
const hasDryerVentPage = Boolean(detail.dryerVent);
const hasRepairPage = Boolean(detail.ductRepair);

const topServices = services.slice(0, 6);
const altHref = `/es/areas-de-servicio/${city.slug}/`;
const guides = await guidesForCity();
---
<BaseLayout title={metaTitle} description={metaDescription} schema={schema} altHref={altHref}>
  <Breadcrumbs
    crumbs={[
      { name: 'Home', href: '/' },
      { name: 'Service Areas', href: '/service-areas/' },
      { name: city.name, href: `/service-areas/${city.slug}/` },
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{city.county} · Florida</span>
        <h1>Air Duct Cleaning in {city.name}, FL</h1>
      </div>

      <div class="answer-box">
        <span class="answer-label">Serving {city.name}</span>
        <p>{business.name} provides professional air duct cleaning, dryer vent cleaning, and indoor air quality services throughout {city.name} and {city.county}. {city.intro}</p>
      </div>

      <div class="prose">
        <p>{city.local}</p>
        <p>Our licensed, insured technicians bring NADCA source-removal equipment to every {city.name} job, placing your entire HVAC system under suction so dust, pollen, and mold are captured, not scattered through your home. Whether you're dealing with a musty AC smell, high energy bills, allergy flare-ups, or simply overdue maintenance, we help {city.name} homeowners breathe cleaner air.</p>

        {(detail.depth ?? []).map((block) => (
          <>
            <h2>{block.heading}</h2>
            {block.body.map((para) => (<p>{para}</p>))}
          </>
        ))}

        <h2>What Air Duct Cleaning Costs in {city.name}</h2>
        <table class="price-table">
          <thead>
            <tr><th>Job</th><th>Typical {city.name} price</th></tr>
          </thead>
          <tbody>
            <tr><td>Air duct cleaning, single system</td><td>From ${PRICES.ductLow}*</td></tr>
            <tr><td>Air duct cleaning, larger or multi system home</td><td>${PRICES.ductLow} to ${PRICES.ductHigh}*</td></tr>
            <tr><td>Dryer vent cleaning</td><td>${PRICES.ventLow} to ${PRICES.ventHigh}*</td></tr>
            <tr><td>Air handler and coil cleaning</td><td>Quoted with the duct work</td></tr>
          </tbody>
        </table>
        <p class="footnote">
          * A starting point, not a flat rate. The number moves with the size of the home, the number of systems
          and what we find when we look. You get the actual figure before we book, not after the van arrives.
        </p>

        {detail.neighborhoods.length > 0 && (
          <>
            <h2>Neighborhoods We Cover in {city.name}</h2>
            <p>
              We work across {city.name} and the wider {city.county} area, including
              {' '}{detail.neighborhoods.slice(0, -1).join(', ')} and {detail.neighborhoods.slice(-1)[0]}.
              If your street is not on that list it does not mean we do not come to it. Call {business.phone}
              and we will tell you either way, along with the price, before anything is booked.
            </p>
          </>
        )}

        <h2>Air Duct &amp; HVAC Services in {city.name}</h2>
        <p>Every service below is available to {city.name} residents and businesses:</p>
      </div>

      <div class="grid grid-3">
        {topServices.map((s) => (
          <a href={`/services/${s.slug}/`} class="card service-card">
            <span class="icon" aria-hidden="true"><ServiceIcon slug={s.slug} /></span>
            <h3>{s.shortName}</h3>
            <p>{s.answer.split('. ')[0]}.</p>
          </a>
        ))}
      </div>
      <p style="margin-top:1rem;"><a href="/services/" class="btn btn-outline">See all services →</a></p>

      {hasDryerVentPage && (
        <div class="cross-service">
          <h2>Here for the dryer, not the ducts?</h2>
          <p>
            Dryer vent cleaning in {city.name} is a different job with a different price, and we have written it
            up separately: what the vent runs are actually like here, the four signs worth acting on, and what it
            costs.
          </p>
          <p>
            <a href={`/service-areas/${city.slug}/dryer-vent-cleaning/`} class="btn btn-outline">
              Dryer vent cleaning in {city.name} &rarr;
            </a>
          </p>
        </div>
      )}

      {hasRepairPage && (
        <div class="cross-service">
          <h2>Is it dirty, or is it broken?</h2>
          <p>
            Cleaning solves restriction. Repair solves loss. If one room in your {city.name} home never reaches
            temperature, or the bill has climbed without your habits changing, air is escaping before it arrives
            and no cleaning changes that. We have written the repair side up separately.
          </p>
          <p>
            <a href={`/service-areas/${city.slug}/air-duct-repair/`} class="btn btn-outline">
              Air duct repair in {city.name} &rarr;
            </a>
          </p>
        </div>
      )}

      <FAQ items={cityFaq} title={`Air Duct Cleaning in ${city.name}: FAQs`} />

      {guides.length > 0 && (
        <div class="city-guides">
          <h2>Before You Book Anyone</h2>
          <p>What the work costs, how often it is actually needed, and how to spot a bait price.</p>
          <ul>
            {guides.map((g) => (<li><a href={`/blog/${g.id.replace(/\.md$/, '')}/`}>{g.data.title}</a></li>))}
          </ul>
        </div>
      )}

      {nearby.length > 0 && (
        <div class="nearby">
          <h2>Nearby Areas We Serve</h2>
          <div class="city-chips">
            {nearby.map((n) => (<a href={`/service-areas/${n.slug}/`} class="chip">{n.name}</a>))}
          </div>
        </div>
      )}
    </div>
  </section>

  <CTABand heading={`Air duct cleaning in ${city.name}? We're ready to help.`} />
</BaseLayout>

<style>
  .service-card { display: block; text-decoration: none; }
  .service-card:hover { text-decoration: none; }
  .service-card h3 { color: var(--c-ink); font-size: 1.1rem; }
  .service-card p { color: var(--c-body); font-size: 0.9rem; margin: 0; }
  .price-table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  .price-table th, .price-table td { text-align: left; padding: 0.7rem 0.6rem; border-bottom: 1px solid var(--c-line); }
  .price-table th { font-weight: 700; }
  .footnote { font-size: 0.85rem; color: var(--c-muted); }
  .cross-service {
    margin-top: 2.5rem; background: var(--c-bg-alt); border: 1px solid var(--c-line);
    border-radius: var(--radius); padding: 1.4rem 1.5rem;
  }
  .cross-service h2 { margin-top: 0; }
  .city-guides { margin-top: 2.5rem; }
  .city-guides ul { list-style: none; padding: 0; margin: 0.8rem 0 0; display: grid; gap: 0.5rem; }
  .city-guides li { padding-bottom: 0.5rem; border-bottom: 1px solid var(--c-border, #e5e7eb); line-height: 1.45; }
  .city-guides li:last-child { border-bottom: 0; }
  .nearby { margin-top: 2.5rem; }
  .city-chips { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .chip {
    background: #fff; border: 1px solid var(--c-line); border-radius: 999px;
    padding: 0.5rem 1rem; font-size: 0.9rem; font-weight: 600; color: var(--c-body); text-decoration: none;
  }
  .chip:hover { border-color: var(--c-primary); color: var(--c-primary); text-decoration: none; }
</style>
