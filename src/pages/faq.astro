---
/**
 * The FAQ page, rebuilt on 28 August 2026 around src/data/facts.ts.
 *
 * Two reasons it changed.
 *
 * First, it was 521 words of hand written answers that overlapped with, and
 * in two places contradicted, what the service pages and the guides said. A
 * site that gives two different answers to "how often should ducts be
 * cleaned" gets dropped as a source by an answer engine, because there is no
 * basis for it to pick one.
 *
 * Second, this is the page most likely to be quoted. Answer engines lift
 * self-contained answers with numbers in them, and this page is where the
 * numbers should live in their most quotable form.
 *
 * So the canonical answers come from facts.ts, which also feeds /llms.txt
 * and /agent.json. The extra questions below are the ones specific to this
 * business rather than to the trade, and they are the only ones written
 * here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import { business } from '../data/business';
import { cities } from '../data/cities';
import { facts } from '../data/facts';

const title = 'Air Duct Cleaning FAQ: Florida Prices and Answers';
const description =
  'Direct answers with real numbers: what it costs, how often, how long it takes, and when it is not worth doing. No call for pricing.';

const canonical = facts.map((f) => ({ question: f.q, answer: f.a }));

/* Questions about this business rather than about the trade. These have no
   place in facts.ts, which is the shared numeric layer. */
const aboutUs = [
  {
    question: 'Are you licensed and insured?',
    answer: `Yes. Every technician is licensed and insured, and the work follows the NADCA ACR source removal standard. We will send proof of both before an appointment if you ask, and you should ask any contractor for it.`,
  },
  {
    question: 'What areas of Florida do you serve?',
    answer: `${cities.length} cities across the state, from Miami, Fort Lauderdale and West Palm Beach through Orlando, Tampa, Clearwater and St Petersburg to Fort Myers, Naples, Sarasota, Bradenton and Jacksonville. We are a service area business, so we come to you rather than operating a walk-in location. Call ${business.phone} to confirm your address.`,
  },
  {
    question: 'Do you offer commercial air duct cleaning?',
    answer: 'Yes. Offices, retail, restaurants, medical facilities and multi-unit properties, scheduled after hours where operations require it, with photo documentation and a written scope for compliance records. Commercial work is priced per project after a site walkthrough, because square footage alone does not describe a commercial system.',
  },
  {
    question: 'Why do you publish prices when almost nobody in this trade does?',
    answer: 'Because the alternative is what the first page of results already looks like: a row of results that all say "free estimate", and a handful of $49 and $99 offers that are not real prices. Publishing a range means we have to stand behind it, which is the point. Where the honest range is genuinely wide, such as duct repair or mold remediation, we publish the range rather than a low anchor.',
  },
  {
    question: 'Do you have customer reviews or a star rating?',
    answer: 'Not yet, and we do not display one. This business is new enough that any rating shown would be invented, and an invented rating is the single most common thing wrong with sites in this trade. When there are real reviews from real customers, they will appear here.',
  },
  {
    question: 'Will you tell me if I do not need the work?',
    answer: 'Yes, and it happens regularly. Duct cleaning is not useful on a three year old system with no pets, no renovation history and no symptoms, and we would rather say so than sell it. The same applies to UV lights on a dry, problem free system, and to full duct replacement where sealing and replacing two runs would do.',
  },
];

const faqs = [...canonical, ...aboutUs];
---
<BaseLayout title={title} description={description} altHref="/es/preguntas-frecuentes/">
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'FAQ', href: '/faq/' }]} />
  <section class="section">
    <div class="container container-narrow">
      <div class="section-head">
        <span class="eyebrow">Answers</span>
        <h1>Air Duct Cleaning in Florida: Straight Answers</h1>
        <p class="lead">
          Every answer here has a number in it wherever a number exists. Prices are what we charge, not a
          starting point designed to get a technician through the door.
        </p>
      </div>

      <div class="answer-box">
        <span class="answer-label">The four numbers people ask for most</span>
        <ul class="quick-facts">
          <li><strong>Air duct cleaning:</strong> $300 to $600 per system</li>
          <li><strong>Dryer vent cleaning:</strong> $100 to $200</li>
          <li><strong>How often, ducts:</strong> every 3 to 5 years in Florida</li>
          <li><strong>How often, dryer vent:</strong> at least once a year</li>
        </ul>
      </div>

      <FAQ items={faqs} title="" />

      <div class="faq-more">
        <h2>Still looking for something?</h2>
        <p>
          The guides go deeper than this page does, particularly on cost and on how to tell a real quote from
          a bait price.
        </p>
        <ul>
          <li><a href="/blog/air-duct-cleaning-cost-florida/">What air duct cleaning costs in Florida, in detail</a></li>
          <li><a href="/blog/air-duct-cleaning-scams/">The duct cleaning scams, and how each one works</a></li>
          <li><a href="/blog/is-air-duct-cleaning-worth-it/">When it is worth it, and when it is not</a></li>
          <li><a href="/blog/questions-to-ask-duct-cleaner/">Ten questions to ask before hiring anyone</a></li>
          <li><a href="/blog/nadca-standards-explained/">What the NADCA standard actually requires</a></li>
          <li><a href="/service-areas/">Your city, with local detail and pricing</a></li>
        </ul>
      </div>
    </div>
  </section>
  <CTABand />
</BaseLayout>

<style>
  .quick-facts { list-style: none; padding: 0; margin: 0.6rem 0 0; display: grid; gap: 0.4rem; }
  .faq-more { margin-top: 2.5rem; }
  .faq-more ul { list-style: none; padding: 0; margin: 0.8rem 0 0; display: grid; gap: 0.5rem; }
  .faq-more li { padding-bottom: 0.5rem; border-bottom: 1px solid var(--c-line); }
  .faq-more li:last-child { border-bottom: 0; }
</style>
