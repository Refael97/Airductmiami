---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business } from '../data/business';

const title = `Privacy Policy | ${business.name}`;
const description = `Privacy policy for ${business.name}. How we collect, use, and protect the information you share with us.`;
---
<BaseLayout title={title} description={description} noindex={true} altHref="/es/privacidad">
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Privacy Policy', href: '/privacy' }]} />
  <section class="section">
    <div class="container container-narrow prose">
      <h1>Privacy Policy</h1>
      <p><em>Last updated: 2025. This is a general template, have it reviewed by a professional before launch.</em></p>

      <p>{business.legalName} ("we," "us," or "our") respects your privacy. This policy explains what information we collect through {business.name} and how we use it.</p>

      <h2>Information we collect</h2>
      <p>When you contact us or request a quote, we may collect your name, phone number, email address, service address, and the details of your request. We also collect standard analytics data (such as pages visited) to improve our website.</p>

      <h2>How we use your information</h2>
      <ul>
        <li>To respond to your inquiries and provide quotes and services.</li>
        <li>To schedule and perform requested work.</li>
        <li>To follow up about your service and send relevant offers, where permitted.</li>
        <li>To improve our website and customer experience.</li>
      </ul>

      <h2>Sharing your information</h2>
      <p>We do not sell your personal information. We share it only with service providers who help us operate our business (such as scheduling or communication tools) and when required by law.</p>

      <h2>Your choices</h2>
      <p>You may opt out of marketing communications at any time by contacting us. You may also request access to, correction of, or deletion of your personal information.</p>

      <h2>Contact us</h2>
      <p>Questions about this policy? Email <a href={`mailto:${business.email}`}>{business.email}</a> or call <a href={`tel:${business.phoneHref}`}>{business.phone}</a>.</p>
    </div>
  </section>
</BaseLayout>
