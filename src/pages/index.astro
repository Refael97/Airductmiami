---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import FAQ from '../components/FAQ.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { business } from '../data/business';
import { services } from '../data/services';
import { cities, citiesByRegion } from '../data/cities';

const title = `${business.name} | Air Duct & Dryer Vent Cleaning Across Florida`;
const description = business.description;

const homeFaq = [
  { question: 'How often should I clean my air ducts in Florida?', answer: 'Most Florida homes should have their air ducts cleaned every 3 to 5 years, and more often with pets, allergies, recent renovations, or a history of mold. Florida’s humidity accelerates dust and mold buildup compared with drier climates.' },
  { question: 'Do you serve my area?', answer: `Yes, we provide air duct and dryer vent services across all of Florida, including Miami, Fort Lauderdale, Orlando, Tampa, Jacksonville, Fort Myers, Naples, Sarasota, and dozens more cities. Call ${business.phone} to confirm availability in your zip code.` },
  { question: 'Are you licensed and insured?', answer: 'Yes. Our technicians are licensed and insured, and we follow NADCA source-removal standards for air duct cleaning so the work is done safely and to industry best practices.' },
  { question: 'How much does air duct cleaning cost?', answer: 'A typical single-system Florida home costs $300 to $600 for a complete air duct cleaning. Dryer vent cleaning runs $100 to $200. We provide free, upfront quotes with no hidden fees.' },
];

const regions = citiesByRegion();
const stats = [
  { value: '4.9★', label: `${business.reviewCount}+ reviews` },
  { value: '10,000+', label: 'Florida homes served' },
  { value: 'NADCA', label: 'Source-removal standard' },
  { value: 'Same-week', label: 'Appointments statewide' },
];
---
<BaseLayout title={title} description={description} altHref="/es/">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Serving all of Florida</span>
        <h1>Breathe Cleaner Air with Florida's Trusted Air Duct Experts</h1>
        <p class="lead">
          Professional air duct cleaning, dryer vent cleaning, and mold prevention, 
          done to NADCA standards by licensed, insured technicians. Lower your energy
          bills, protect your family's health, and eliminate that musty AC smell.
        </p>
        <div class="hero-actions">
          <a href={`tel:${business.phoneHref}`} class="btn btn-accent btn-lg">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3A19.5 19.5 0 0 1 5.2 13 19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0 1 22 16.9Z"/></svg>
            Call {business.phone}</a>
          <a href="/contact" class="btn btn-outline btn-lg">Get a Free Quote</a>
        </div>
        <ul class="hero-trust check-list">
          <li>Licensed &amp; insured Florida technicians</li>
          <li>Upfront pricing, no hidden fees</li>
          <li>Same-week appointments statewide</li>
        </ul>
      </div>
      <div class="hero-visual">
        <img class="hero-img" src="/images/hero-home.svg" alt="Bright Florida living room with clean, fresh air" width="800" height="620" fetchpriority="high" />
        <div class="hero-card-inner">
          <p class="hero-card-title">Florida's humidity is hard on your air.</p>
          <p class="hero-card-text">Dust, pollen, and mold build up fast in Florida ductwork. We remove it at the source and keep it from coming back.</p>
          <a href="/services/air-duct-cleaning" class="btn btn-primary">See how it works →</a>
        </div>
      </div>
    </div>
  </section>

  <div class="wave-divider" aria-hidden="true">
    <svg viewBox="0 0 1440 44" preserveAspectRatio="none"><path fill="#0b2740" d="M0,44 L0,20 C240,44 480,4 720,10 C960,16 1200,44 1440,18 L1440,44 Z"></path></svg>
  </div>

  <!-- Stats -->
  <section class="stats-band">
    <div class="container stats-grid">
      {stats.map((s) => (
        <div class="stat"><span class="stat-value">{s.value}</span><span class="stat-label">{s.label}</span></div>
      ))}
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">What we do</span>
        <h2>Complete Air Duct &amp; Indoor Air Quality Services</h2>
        <p class="lead">From routine duct cleaning to mold remediation and dryer vent safety, we handle every part of your home's air system.</p>
      </div>
      <div class="grid grid-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}`} class="card service-card">
            <span class="icon" aria-hidden="true"><ServiceIcon slug={s.slug} /></span>
            <h3>{s.name}</h3>
            <p>{s.answer.split('. ')[0]}.</p>
            <span class="card-link">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="section section-alt">
    <div class="container why-grid">
      <div>
        <span class="eyebrow">Why Florida homeowners choose us</span>
        <h2>Done right, at the source, not just blown around</h2>
        <p>Cut-rate "$49 duct cleaning" deals often just push dust around with a shop vac. We use professional negative-air, source-removal equipment that places your entire system under suction and captures every particle into a sealed HEPA unit.</p>
        <ul class="check-list">
          <li><strong>NADCA source-removal standard</strong>, the method the industry recognizes as done correctly.</li>
          <li><strong>Before &amp; after photos</strong>, you see exactly what we removed.</li>
          <li><strong>Florida-specific expertise</strong>, we know how humidity drives coil mold and duct dust here.</li>
          <li><strong>Transparent, upfront quotes</strong>, the price we quote is the price you pay.</li>
        </ul>
        <a href="/about" class="btn btn-primary">More about our approach</a>
      </div>
      <div class="why-facts">
        <div class="why-fact"><span class="wf-num">20 to 30%</span><span>of conditioned air is lost to leaky ducts in a typical home</span></div>
        <div class="why-fact"><span class="wf-num">5 to 7×</span><span>your home's air recirculates through the ducts every day</span></div>
        <div class="why-fact"><span class="wf-num">#1</span><span>cause of dryer fires is lint buildup in the vent</span></div>
      </div>
    </div>
  </section>

  <!-- Before & After -->
  <section class="section section-ba">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">See the difference</span>
        <h2>Before &amp; After</h2>
        <p class="lead">Drag the slider to see exactly what a professional cleaning removes. We document real results on every Florida Breeze job.</p>
      </div>
      <div class="ba-grid">
        <div>
          <BeforeAfter
            beforeSrc="/images/before-1.webp"
            afterSrc="/images/after-1.webp"
            beforeAlt="AC coil chamber packed with dust before cleaning"
            afterAlt="AC coil chamber cleaned to bare metal after service"
          />
          <p class="ba-cap">AC coil chamber</p>
        </div>
        <div>
          <BeforeAfter
            beforeSrc="/images/before-2.webp"
            afterSrc="/images/after-2.webp"
            beforeAlt="Dryer vent duct clogged with lint and mildew before cleaning"
            afterAlt="Dryer vent duct clear and clean after service"
          />
          <p class="ba-cap">Dryer vent duct</p>
        </div>
        <div>
          <BeforeAfter
            beforeSrc="/images/before-3.webp"
            afterSrc="/images/after-3.webp"
            beforeAlt="Main supply duct coated in black debris before cleaning"
            afterAlt="Main supply duct cleaned after service"
          />
          <p class="ba-cap">Main supply duct</p>
        </div>
        <div>
          <BeforeAfter
            beforeSrc="/images/before-4.webp"
            afterSrc="/images/after-4.webp"
            beforeAlt="Wall supply vent grimy before cleaning"
            afterAlt="Wall supply vent clean after service"
          />
          <p class="ba-cap">Wall supply vent</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service areas -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Statewide coverage</span>
        <h2>Air Duct Cleaning Across Florida</h2>
        <p class="lead">We serve homeowners and businesses in {cities.length}+ Florida cities. Find yours:</p>
      </div>
      <div class="areas-grid">
        {Object.entries(regions).map(([region, list]) => (
          <div class="area-col">
            <h3>{region}</h3>
            <ul>
              {list.map((c) => (<li><a href={`/service-areas/${c.slug}`}>{c.name}</a></li>))}
            </ul>
          </div>
        ))}
      </div>
      <p class="text-center" style="margin-top:1.5rem;"><a href="/service-areas" class="btn btn-outline">View all service areas →</a></p>
    </div>
  </section>

  <CTABand />

  <!-- FAQ -->
  <section class="section section-alt">
    <div class="container container-narrow">
      <div class="section-head center"><span class="eyebrow">Good to know</span><h2>Frequently Asked Questions</h2></div>
      <FAQ items={homeFaq} title="" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero { background: var(--grad-hero); padding-block: clamp(2.5rem, 6vw, 4.5rem); position: relative; }
  .wave-divider { margin-top: -1px; background: #fff; }
  .ba-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .ba-cap { text-align: center; margin: 0.7rem 0 0; font-weight: 700; color: var(--c-ink); }
  @media (max-width: 760px) { .ba-grid { grid-template-columns: 1fr; } }
  .hero-inner { display: grid; grid-template-columns: 1.35fr 1fr; gap: 2.5rem; align-items: center; }
  .hero-copy h1 { margin-bottom: 0.6rem; }
  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin: 1.4rem 0; }
  .hero-trust { margin-top: 1rem; }
  .hero-trust li { font-weight: 600; color: var(--c-ink); }
  .hero-visual { position: relative; }
  .hero-img {
    width: 100%; height: auto; border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg); display: block;
  }
  .hero-card-inner {
    position: absolute; left: 1rem; right: 1rem; bottom: -1.2rem;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(6px);
    border: 1px solid var(--c-line); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 1.1rem 1.3rem;
  }
  .hero-card-title { font-weight: 800; color: var(--c-ink); font-size: 1.05rem; margin-bottom: 0.3rem; }
  .hero-card-text { color: var(--c-body); font-size: 0.92rem; margin-bottom: 0.8rem; }
  .hero-card-inner .btn { padding: 0.6rem 1.2rem; font-size: 0.9rem; }

  .stats-band { background: var(--c-bg-deep); }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding-block: 1.6rem; }
  .stat { text-align: center; color: #cfe0ec; }
  .stat-value { display: block; font-size: 1.7rem; font-weight: 800; color: #fff; }
  .stat-label { font-size: 0.85rem; }

  .service-card { display: block; text-decoration: none; }
  .service-card:hover { text-decoration: none; }
  .service-card h3 { color: var(--c-ink); }
  .service-card p { color: var(--c-body); font-size: 0.95rem; }
  .card-link { color: var(--c-primary); font-weight: 700; font-size: 0.9rem; }

  .why-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; align-items: center; }
  .why-facts { display: grid; gap: 1rem; }
  .why-fact {
    background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius);
    padding: 1.2rem 1.4rem; box-shadow: var(--shadow-sm);
    display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center;
  }
  .wf-num { font-size: 1.8rem; font-weight: 800; color: var(--c-primary); }

  .areas-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; }
  .area-col h3 { font-size: 1.05rem; color: var(--c-primary-dark); border-bottom: 2px solid var(--c-line); padding-bottom: 0.4rem; margin-bottom: 0.7rem; }
  .area-col ul { list-style: none; padding: 0; margin: 0; }
  .area-col li { margin-bottom: 0.35rem; }
  .area-col a { font-size: 0.92rem; color: var(--c-body); }

  @media (max-width: 860px) {
    .hero-inner, .why-grid { grid-template-columns: 1fr; }
    .hero-card-inner { position: static; margin-top: 0.9rem; }

    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
