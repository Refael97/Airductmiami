---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import { services } from '../../data/services';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { business } from '../../data/business';

const title = `Air Duct & HVAC Services in Florida | From $100`;
const description = 'Every Florida service we offer with its starting price: duct cleaning from $300, dryer vents from $100, plus mold, coils, UV and insulation.';
---
<BaseLayout title={title} description={description} altHref="/es/servicios/">
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }]} />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our services</span>
        <h1>Air Duct &amp; Indoor Air Quality Services in Florida</h1>
        <p class="lead">Whatever your home's air needs, routine cleaning, mold removal, dryer vent safety, or efficiency upgrades, we have a Florida-experienced crew for it. Every service is performed by licensed, insured technicians.</p>
      </div>
      <div class="grid grid-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}/`} class="card service-card">
            <span class="icon" aria-hidden="true"><ServiceIcon slug={s.slug} /></span>
            <h3>{s.name}</h3>
            <p>{s.answer.split('. ')[0]}.</p>
            <span class="card-link">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CTABand />
</BaseLayout>

<style>
  .service-card { display: block; text-decoration: none; }
  .service-card:hover { text-decoration: none; }
  .service-card h3 { color: var(--c-ink); }
  .service-card p { color: var(--c-body); font-size: 0.95rem; }
  .card-link { color: var(--c-primary); font-weight: 700; font-size: 0.9rem; }
</style>
