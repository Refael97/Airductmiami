---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FAQ from '../../../components/FAQ.astro';
import CTABand from '../../../components/CTABand.astro';
import { articleSchema } from '../../../lib/schema';
import { ui, blogHref } from '../../../data/ui';

const lang = 'es' as const;
const t = ui[lang];

export const getStaticPaths = (async () => {
 const posts = await getCollection('blogEs');
 return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = `${site}${blogHref(lang, post.id)}`;

const schema: Record<string, unknown>[] = [
 articleSchema(site, {
 headline: d.title,
 description: d.description,
 url: pageUrl,
 datePublished: d.pubDate.toISOString(),
 dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
 }),
];

const fmt = (date: Date) => date.toLocaleDateString('es-US', { year: 'numeric', month: 'long', day: 'numeric' });

const related = (await getCollection('blogEs'))
 .filter((p) => p.data.category === d.category && p.id !== post.id)
 .slice(0, 3);

/* Google renders about 60 characters and appends the site name on its own,
   so a hard coded brand suffix on an already long headline only buys a
   truncation. Add it when it fits, drop it when it does not. */
const brandedTitle =
  d.title.length + 26 <= 60 ? `${d.title} | Florida Breeze Air Duct` : d.title;
---
<BaseLayout title={brandedTitle} description={d.description} schema={schema} ogType="article" lang={lang}>
 <Breadcrumbs
 crumbs={[
 { name: t.breadcrumbHome, href: t.home },
 { name: t.nav[2].label, href: t.blog },
 { name: d.title, href: blogHref(lang, post.id) },
 ]}
 />

 <article class="section">
 <div class="container container-narrow">
 <header class="post-header">
 <span class="pill">{d.category}</span>
 <h1>{d.title}</h1>
 <p class="post-byline">
 Publicado el {fmt(d.pubDate)}
 {d.updatedDate && <> · Actualizado el {fmt(d.updatedDate)}</>}
 </p>
 </header>

 <div class="answer-box">
 <span class="answer-label">{t.quickAnswer}</span>
 <p>{d.answer}</p>
 </div>

 <div class="prose post-content">
 <Content />
 </div>

 {d.faq.length > 0 && <FAQ items={d.faq} title="Preguntas frecuentes" />}

 {d.tags.length > 0 && (
 <div class="tags">
 {d.tags.map((tag) => (<span class="tag">#{tag}</span>))}
 </div>
 )}

 {related.length > 0 && (
 <div class="related-posts">
 <h2>Guías relacionadas</h2>
 <ul>
 {related.map((r) => (<li><a href={blogHref(lang, r.id)}>{r.data.title}</a></li>))}
 </ul>
 </div>
 )}
 </div>
 </article>

 <CTABand lang={lang} />
</BaseLayout>

<style>
  .post-header { margin-bottom: 1.5rem; }
  .post-header h1 { margin: 0.6rem 0 0.4rem; }
  .post-byline { color: var(--c-muted); font-size: 0.9rem; margin: 0; }
  .post-content { font-size: 1.075rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
  .tag { color: var(--c-primary); font-size: 0.85rem; font-weight: 600; }
  .related-posts { margin-top: 2.5rem; border-top: 1px solid var(--c-line); padding-top: 1.5rem; }
  .related-posts ul { list-style: none; padding: 0; }
  .related-posts li { margin-bottom: 0.5rem; }
</style>
