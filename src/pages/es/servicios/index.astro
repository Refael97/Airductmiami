---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABand from '../../../components/CTABand.astro';
import { services } from '../../../data/services';
import { serviceEsContent } from '../../../data/services.es';
import { business } from '../../../data/business';
import { ui, serviceHref } from '../../../data/ui';

const lang = 'es' as const;
const t = ui[lang];
const title = `Servicios de limpieza de ductos en Florida | ${business.name}`;
const description = 'Conozca nuestros servicios en Florida: limpieza de ductos de aire, limpieza de ventila del secador, limpieza del aire acondicionado, remediación de moho, desinfección, luz UV y más.';
---
<BaseLayout title={title} description={description} lang={lang} altHref="/services">
 <Breadcrumbs crumbs={[{ name: t.breadcrumbHome, href: t.home }, { name: t.nav[0].label, href: t.services }]} />
 <section class="section">
 <div class="container">
 <div class="section-head">
 <span class="eyebrow">Nuestros servicios</span>
 <h1>Servicios de ductos y calidad del aire en Florida</h1>
 <p class="lead">Sea limpieza de rutina, eliminación de moho, seguridad de la ventila del secador o mejoras de eficiencia, tenemos un equipo con experiencia en Florida para ayudarle. Todos nuestros técnicos cuentan con licencia y seguro.</p>
 </div>
 <div class="grid grid-3">
 {services.map((s) => {
 const es = serviceEsContent[s.slug];
 return (
 <a href={serviceHref(lang, s.slug)} class="card service-card">
 <span class="icon" aria-hidden="true">{s.icon}</span>
 <h3>{es.name}</h3>
 <p>{es.answer.split('. ')[0]}.</p>
 <span class="card-link">{t.learnMore} →</span>
 </a>
 );
 })}
 </div>
 </div>
 </section>
 <CTABand lang={lang} />
</BaseLayout>

<style>
  .service-card { display: block; text-decoration: none; }
  .service-card:hover { text-decoration: none; }
  .service-card h3 { color: var(--c-ink); }
  .service-card p { color: var(--c-body); font-size: 0.95rem; }
  .card-link { color: var(--c-primary); font-weight: 700; font-size: 0.9rem; }
</style>
