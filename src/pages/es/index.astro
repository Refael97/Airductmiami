---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import FAQ from '../../components/FAQ.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import { business } from '../../data/business';
import { services } from '../../data/services';
import { serviceEsContent } from '../../data/services.es';
import { cities } from '../../data/cities';
import { cityEsContent } from '../../data/cities.es';
import { ui, serviceHref, cityHref } from '../../data/ui';

const lang = 'es' as const;
const t = ui[lang];
const title = `${business.name} | Limpieza de ductos y ventila del secador en Florida`;
const description = 'Limpieza profesional de ductos de aire, ventila del secador y prevención de moho en toda Florida. Técnicos con licencia y seguro, estándares NADCA. Cotización gratis.';

const homeFaq = [
 { question: '¿Cada cuánto debo limpiar los ductos de aire en Florida?', answer: 'La mayoría de los hogares en Florida deben limpiar los ductos cada 3 a 5 años, y con más frecuencia si hay mascotas, alergias, remodelaciones recientes o antecedentes de moho. La humedad de Florida acelera la acumulación de polvo y moho.' },
 { question: '¿Atienden mi zona?', answer: `Sí. Ofrecemos servicios de ductos y ventila del secador en toda Florida, incluyendo Miami, Fort Lauderdale, Orlando, Tampa, Jacksonville, Fort Myers, Naples, Sarasota y muchas ciudades más. Llame al ${business.phone} para confirmar disponibilidad en su código postal.` },
 { question: '¿Tienen licencia y seguro?', answer: 'Sí. Nuestros técnicos cuentan con licencia y seguro, y seguimos los estándares NADCA de extracción por fuente para que el trabajo se haga de forma segura y correcta.' },
 { question: '¿Cuánto cuesta la limpieza de ductos?', answer: 'Un hogar típico de un solo sistema en Florida cuesta entre 300 y 600 dólares por una limpieza completa. La limpieza de la ventila del secador va de 100 a 200 dólares. Damos cotizaciones claras y sin cargos ocultos.' },
];

const regions: Record<string, typeof cities> = {};
for (const c of cities) {
 const r = cityEsContent[c.slug]?.region ?? 'Florida';
 (regions[r] ??= []).push(c);
}

const stats = [
 { value: '4.9★', label: `${business.reviewCount}+ reseñas` },
 { value: '10,000+', label: 'Hogares en Florida' },
 { value: 'NADCA', label: 'Extracción por fuente' },
 { value: 'Rápido', label: 'Citas la misma semana' },
];
---
<BaseLayout title={title} description={description} lang={lang} altHref="/">
 <section class="hero">
 <div class="container hero-inner">
 <div class="hero-copy">
 <span class="eyebrow">Servicio en toda Florida</span>
 <h1>Respire un aire más limpio con los expertos en ductos de confianza en Florida</h1>
 <p class="lead">
 Limpieza profesional de ductos de aire, limpieza de la ventila del secador y prevención de moho,
 con estándares NADCA y técnicos con licencia y seguro. Baje su factura de electricidad,
 proteja la salud de su familia y elimine ese olor a humedad del aire acondicionado.
 </p>
 <div class="hero-actions">
 <a href={`tel:${business.phoneHref}`} class="btn btn-accent btn-lg">📞 Llame al {business.phone}</a>
 <a href={t.contact} class="btn btn-outline btn-lg">{t.quoteLabel}</a>
 </div>
 <ul class="hero-trust check-list">
 <li>Técnicos en Florida con licencia y seguro</li>
 <li>Precios claros, sin cargos ocultos</li>
 <li>Citas la misma semana en todo el estado</li>
 </ul>
 </div>
 <div class="hero-card">
 <div class="hero-card-inner">
 <span class="hero-card-icon">🌬️</span>
 <p class="hero-card-title">La humedad de Florida es dura con su aire.</p>
 <p class="hero-card-text">El polvo, el polen y el moho se acumulan rápido en los ductos de Florida. Los quitamos desde la fuente y evitamos que regresen.</p>
 <a href={serviceHref(lang, 'air-duct-cleaning')} class="btn btn-primary">Vea cómo funciona →</a>
 </div>
 </div>
 </div>
 </section>

  <div class="wave-divider" aria-hidden="true">
    <svg viewBox="0 0 1440 44" preserveAspectRatio="none"><path fill="#0c1f30" d="M0,44 L0,20 C240,44 480,4 720,10 C960,16 1200,44 1440,18 L1440,44 Z"></path></svg>
  </div>

 <section class="stats-band">
 <div class="container stats-grid">
 {stats.map((s) => (
 <div class="stat"><span class="stat-value">{s.value}</span><span class="stat-label">{s.label}</span></div>
 ))}
 </div>
 </section>

 <section class="section">
 <div class="container">
 <div class="section-head center">
 <span class="eyebrow">Lo que hacemos</span>
 <h2>Servicios completos de ductos y calidad del aire</h2>
 <p class="lead">Desde la limpieza de rutina hasta la eliminación de moho y la seguridad de la ventila del secador, cuidamos cada parte del sistema de aire de su casa.</p>
 </div>
 <div class="grid grid-3">
 {services.map((s) => {
 const es = serviceEsContent[s.slug];
 return (
 <a href={serviceHref(lang, s.slug)} class="card service-card">
 <span class="icon" aria-hidden="true">{s.icon}</span>
 <h3>{es.name}</h3>
 <p>{es.answer.split('. ')[0]}.</p>
 <span class="card-link">{t.learnMore} →</span>
 </a>
 );
 })}
 </div>
 </div>
 </section>

 <section class="section section-alt">
 <div class="container why-grid">
 <div>
 <span class="eyebrow">Por qué nos eligen en Florida</span>
 <h2>Bien hecho, desde la fuente, no solo movido de un lado a otro</h2>
 <p>Las ofertas baratas de "limpieza de ductos por 49 dólares" muchas veces solo mueven el polvo con una aspiradora. Nosotros usamos equipo profesional de presión negativa que pone todo su sistema bajo succión y captura cada partícula en una unidad sellada con filtro HEPA.</p>
 <ul class="check-list">
 <li><strong>Estándar NADCA de extracción por fuente</strong>, el método que la industria reconoce como el correcto.</li>
 <li><strong>Fotos de antes y después</strong>, para que vea exactamente lo que sacamos.</li>
 <li><strong>Experiencia local en Florida</strong>, sabemos cómo la humedad causa moho en la serpentina y polvo en los ductos.</li>
 <li><strong>Cotizaciones claras</strong>, el precio que le damos es el que paga.</li>
 </ul>
 <a href={t.about} class="btn btn-primary">Más sobre nuestro método</a>
 </div>
 <div class="why-facts">
 <div class="why-fact"><span class="wf-num">20 a 30%</span><span>del aire acondicionado se pierde por fugas en los ductos de un hogar típico</span></div>
 <div class="why-fact"><span class="wf-num">5 a 7×</span><span>circula el aire de su casa por los ductos cada día</span></div>
 <div class="why-fact"><span class="wf-num">#1</span><span>causa de incendios de secadora es la acumulación de pelusa</span></div>
 </div>
 </div>
 </section>

 <section class="section section-ba">
 <div class="container">
 <div class="section-head center">
 <span class="eyebrow">Vea la diferencia</span>
 <h2>Antes y Después</h2>
 <p class="lead">Deslice el control para ver exactamente lo que quita una limpieza profesional. Documentamos resultados reales en cada trabajo de Florida Breeze.</p>
 </div>
 <div class="ba-grid">
 <div>
 <BeforeAfter
 beforeSrc="/images/ba-vent-before.svg"
 afterSrc="/images/ba-vent-after.svg"
 beforeAlt="Rejilla de ventilación antes de la limpieza"
 afterAlt="Rejilla de ventilación después de la limpieza"
 beforeLabel="Antes"
 afterLabel="Después"
 />
 <p class="ba-cap">Rejilla de techo</p>
 </div>
 <div>
 <BeforeAfter
 beforeSrc="/images/ba-duct-before.svg"
 afterSrc="/images/ba-duct-after.svg"
 beforeAlt="Interior del ducto antes de la limpieza"
 afterAlt="Interior del ducto después de la limpieza"
 beforeLabel="Antes"
 afterLabel="Después"
 />
 <p class="ba-cap">Interior del ducto</p>
 </div>
 </div>
 </div>
 </section>

 <section class="section section-alt">
 <div class="container">
 <div class="section-head center">
 <span class="eyebrow">Cobertura estatal</span>
 <h2>Limpieza de ductos en toda Florida</h2>
 <p class="lead">Atendemos a familias y negocios en más de {cities.length} ciudades de Florida. Encuentre la suya:</p>
 </div>
 <div class="areas-grid">
 {Object.entries(regions).map(([region, list]) => (
 <div class="area-col">
 <h3>{region}</h3>
 <ul>
 {list.map((c) => (<li><a href={cityHref(lang, c.slug)}>{c.name}</a></li>))}
 </ul>
 </div>
 ))}
 </div>
 <p class="text-center" style="margin-top:1.5rem;"><a href={t.serviceAreas} class="btn btn-outline">Ver todas las áreas →</a></p>
 </div>
 </section>

 <CTABand lang={lang} />

 <section class="section section-alt">
 <div class="container container-narrow">
 <div class="section-head center"><span class="eyebrow">Bueno saber</span><h2>{t.faqTitle}</h2></div>
 <FAQ items={homeFaq} title="" />
 </div>
 </section>
</BaseLayout>

<style>
  .hero { background: var(--grad-hero); padding-block: clamp(2.5rem, 6vw, 4.5rem); position: relative; }
  .wave-divider { margin-top: -1px; background: #fff; }
  .ba-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .ba-cap { text-align: center; margin: 0.7rem 0 0; font-weight: 700; color: var(--c-ink); }
  @media (max-width: 760px) { .ba-grid { grid-template-columns: 1fr; } }
  .hero-inner { display: grid; grid-template-columns: 1.35fr 1fr; gap: 2.5rem; align-items: center; }
  .hero-copy h1 { margin-bottom: 0.6rem; }
  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin: 1.4rem 0; }
  .hero-trust { margin-top: 1rem; }
  .hero-trust li { font-weight: 600; color: var(--c-ink); }
  .hero-card { display: flex; }
  .hero-card-inner {
    background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius);
    box-shadow: var(--shadow-lg); padding: 2rem; text-align: center;
  }
  .hero-card-icon { font-size: 3rem; display: block; margin-bottom: 0.6rem; }
  .hero-card-title { font-weight: 800; color: var(--c-ink); font-size: 1.2rem; margin-bottom: 0.5rem; }
  .hero-card-text { color: var(--c-body); margin-bottom: 1.2rem; }

  .stats-band { background: var(--c-bg-deep); }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding-block: 1.6rem; }
  .stat { text-align: center; color: #cfe0ec; }
  .stat-value { display: block; font-size: 1.7rem; font-weight: 800; color: #fff; }
  .stat-label { font-size: 0.85rem; }

  .service-card { display: block; text-decoration: none; }
  .service-card:hover { text-decoration: none; }
  .service-card h3 { color: var(--c-ink); }
  .service-card p { color: var(--c-body); font-size: 0.95rem; }
  .card-link { color: var(--c-primary); font-weight: 700; font-size: 0.9rem; }

  .why-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; align-items: center; }
  .why-facts { display: grid; gap: 1rem; }
  .why-fact {
    background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius);
    padding: 1.2rem 1.4rem; box-shadow: var(--shadow-sm);
    display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center;
  }
  .wf-num { font-size: 1.8rem; font-weight: 800; color: var(--c-primary); }

  .areas-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; }
  .area-col h3 { font-size: 1.05rem; color: var(--c-primary-dark); border-bottom: 2px solid var(--c-line); padding-bottom: 0.4rem; margin-bottom: 0.7rem; }
  .area-col ul { list-style: none; padding: 0; margin: 0; }
  .area-col li { margin-bottom: 0.35rem; }
  .area-col a { font-size: 0.92rem; color: var(--c-body); }

  @media (max-width: 860px) {
    .hero-inner, .why-grid { grid-template-columns: 1fr; }
    .hero-card { order: -1; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
