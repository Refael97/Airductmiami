---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';

const title = `Thank You | ${business.name}`;
const description = 'Thank you for contacting Air Duct Florida. We will get back to you shortly.';
---
<BaseLayout title={title} description={description} noindex={true} altHref="/es/gracias">
  <section class="section">
    <div class="container container-narrow text-center" style="padding-block: 3rem;">
      <div style="font-size:3.5rem;">✅</div>
      <h1>Thank you! Your request is on its way.</h1>
      <p class="lead">We received your message and a member of our Florida team will reach out shortly, usually within one business day.</p>
      <p>Need help sooner? Call us now at <a href={`tel:${business.phoneHref}`}><strong>{business.phone}</strong></a>.</p>
      <p style="margin-top:2rem;"><a href="/" class="btn btn-primary">Back to home</a></p>
    </div>
  </section>
</BaseLayout>
