---
import '@fontsource-variable/inter';
import '@fontsource/playfair-display/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PromoPopup from '../components/PromoPopup.astro';
import StickyQuoteBar from '../components/StickyQuoteBar.astro';
import JsonLd from '../components/JsonLd.astro';
import { localBusinessSchema, websiteSchema } from '../lib/schema';
import { business } from '../data/business';
import { ui, type Locale } from '../data/ui';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  noindex?: boolean;
  lang?: Locale;
  /** Path (no origin) of this same page in the other language, for hreflang + switcher. */
  altHref?: string;
}

const {
  title,
  description,
  canonical,
  schema,
  ogType = 'website',
  noindex = false,
  lang = 'en',
  altHref,
} = Astro.props;

const t = ui[lang];
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
/** Normalize to a trailing-slash URL so canonical, hreflang, and the sitemap
 *  all agree on one URL form (Netlify serves directory-style pretty URLs). */
const withSlash = (p: string) => (p.endsWith('/') || /\.\w+$/.test(p) ? p : `${p}/`);
const canonicalURL = `${site}${withSlash(canonical ?? Astro.url.pathname)}`;
const ogImage = `${site}/og-image.png`;

const currentPath = withSlash(Astro.url.pathname);
const enHref = lang === 'en' ? currentPath : altHref && withSlash(altHref);
const esHref = lang === 'es' ? currentPath : altHref && withSlash(altHref);

const siteSchema = [localBusinessSchema(site), websiteSchema(site)];
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {enHref && <link rel="alternate" hreflang="en" href={`${site}${enHref}`} />}
    {esHref && <link rel="alternate" hreflang="es" href={`${site}${esHref}`} />}
    {enHref && <link rel="alternate" hreflang="x-default" href={`${site}${enHref}`} />}

    <meta name="generator" content={Astro.generator} />
    <meta name="geo.region" content="US-FL" />
    <meta name="geo.placename" content="Florida" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content={t.ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <JsonLd schema={siteSchema} />
    {schema && <JsonLd schema={schema} />}

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-EK5SGJE8MP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-EK5SGJE8MP');

      // Lead events. phone_call fires on any tel: link click site-wide;
      // generate_lead fires once on the form thank-you pages.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
        if (a) gtag('event', 'phone_call', { page_path: location.pathname });
      }, true);
      if (/^\/(thank-you|es\/gracias)\/?$/.test(location.pathname)) {
        gtag('event', 'generate_lead', {
          form_type: location.pathname.indexOf('/es/') === 0 ? 'quote_es' : 'quote',
        });
      }
    </script>
  </head>
  <body>
    <a href="#main" class="visually-hidden">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header lang={lang} switchHref={altHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <PromoPopup lang={lang} />
    <StickyQuoteBar lang={lang} />
  </body>
</html>
