---
import '@fontsource-variable/inter';
import '@fontsource/playfair-display/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PromoPopup from '../components/PromoPopup.astro';
import ReviewTicker from '../components/ReviewTicker.astro';
import StickyQuoteBar from '../components/StickyQuoteBar.astro';
import JsonLd from '../components/JsonLd.astro';
import { localBusinessSchema, websiteSchema } from '../lib/schema';
import { business } from '../data/business';
import { ui, type Locale } from '../data/ui';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  noindex?: boolean;
  lang?: Locale;
  /** Path (no origin) of this same page in the other language, for hreflang + switcher. */
  altHref?: string;
}

const {
  title,
  description,
  canonical,
  schema,
  ogType = 'website',
  noindex = false,
  lang = 'en',
  altHref,
} = Astro.props;

const t = ui[lang];
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
/** Normalize to a trailing-slash URL so canonical, hreflang, and the sitemap
 *  all agree on one URL form (Netlify serves directory-style pretty URLs). */
const withSlash = (p: string) => (p.endsWith('/') || /\.\w+$/.test(p) ? p : `${p}/`);
const canonicalURL = `${site}${withSlash(canonical ?? Astro.url.pathname)}`;
const ogImage = `${site}/og-image.png`;

const currentPath = withSlash(Astro.url.pathname);
/* The header language switcher was being handed the raw altHref while
   hreflang and the canonical got the normalised one, so every city and
   region page shipped a slashless link to its own translation. Each one is
   a 301 hop the crawler has to take and a second URL form for Google to
   consider, which is exactly the duplication the edge function was added to
   stop. Normalise once, here, and pass that everywhere. */
const altPath = altHref ? withSlash(altHref) : undefined;
/* A noindexed page has no business declaring hreflang. The 404 was pointing
   at /404/, which is not a URL that exists, so Search Console had a broken
   alternate to complain about on a page nobody should be indexing anyway. */
const emitHreflang = !noindex;
const enHref = lang === 'en' ? currentPath : altPath;
const esHref = lang === 'es' ? currentPath : altPath;

const siteSchema = [localBusinessSchema(site), websiteSchema(site)];
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {emitHreflang && enHref && <link rel="alternate" hreflang="en" href={`${site}${enHref}`} />}
    {emitHreflang && esHref && <link rel="alternate" hreflang="es" href={`${site}${esHref}`} />}
    {emitHreflang && enHref && <link rel="alternate" hreflang="x-default" href={`${site}${enHref}`} />}

    <meta name="generator" content={Astro.generator} />
    <meta name="geo.region" content="US-FL" />
    <meta name="geo.placename" content="Florida" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content={t.ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <JsonLd schema={siteSchema} />
    {schema && <JsonLd schema={schema} />}

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-EK5SGJE8MP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-EK5SGJE8MP');

      // Lead events.
      //
      // phone_call fires on any tel: link click site-wide, and carries where
      // on the page the tap happened, because "eleven calls" and "eleven
      // calls, nine of them from the sticky bar" are different facts.
      function placementOf(a) {
        if (a.closest('#promo-overlay')) return 'promo_popup';
        if (a.closest('header')) return 'header';
        if (a.closest('footer')) return 'footer';
        if (a.closest('aside')) return 'sidebar';
        return 'page_body';
      }
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
        if (!a) return;
        gtag('event', 'phone_call', {
          page_path: location.pathname,
          placement: placementOf(a),
          phone_number: a.getAttribute('href').replace('tel:', ''),
          site_language: location.pathname.indexOf('/es/') === 0 ? 'es' : 'en',
        });
      }, true);

      // generate_lead used to fire on every load of a thank-you page, which
      // counted refreshes, back-button returns and anyone who bookmarked it.
      // Over the last 30 days that was 26 events from 13 users: exactly the
      // doubling you would expect, on the one number the business steers by.
      //
      // So the form now leaves a note on its way out and the thank-you page
      // fires only if it finds one, then eats it. No note, no conversion.
      // The popup is excluded because it submits over fetch, stays on the
      // page and reports its own generate_lead; without this its note would
      // sit in storage and fire on some unrelated visit to /thank-you/ later.
      var LEAD_KEY = 'fbLeadPending';
      document.addEventListener('submit', function (e) {
        var f = e.target;
        if (!f || f.id === 'promo-form' || !f.hasAttribute('data-netlify')) return;
        function val(name) {
          var el = f.querySelector('[name="' + name + '"]');
          return el && el.value ? String(el.value).slice(0, 60) : '';
        }
        try {
          sessionStorage.setItem(LEAD_KEY, JSON.stringify({
            t: Date.now(),
            form_type: val('form-name') || 'quote',
            service: val('service'),
            lead_city: val('city') || val('zip_city'),
            source: val('source'),
            site_language: val('locale') || 'en',
            page_path: val('page') || location.pathname,
          }));
        } catch (err) {
          /* private mode: the lead still sends, it just goes uncounted */
        }
      }, true);

      if (/^\/(thank-you|es\/gracias)\/?$/.test(location.pathname)) {
        try {
          var raw = sessionStorage.getItem(LEAD_KEY);
          if (raw) {
            sessionStorage.removeItem(LEAD_KEY);
            var lead = JSON.parse(raw);
            // A note older than ten minutes is not this visit's lead.
            if (Date.now() - lead.t < 600000) {
              delete lead.t;
              gtag('event', 'generate_lead', lead);
            }
          }
        } catch (err) {
          /* unreadable note: better to miss one than to invent one */
        }
      }
    </script>
  </head>
  <body>
    <a href="#main" class="visually-hidden">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header lang={lang} switchHref={altPath} />
    <main id="main">
      <slot />
    </main>
    {/* Real customer reviews, verbatim and untranslated, on every page.
        Sits between the content and the footer so it is the last thing
        read before the contact links. See src/data/reviews.ts. */}
    <ReviewTicker lang={lang} />
    <Footer lang={lang} />
    <PromoPopup lang={lang} />
    <StickyQuoteBar lang={lang} />
  </body>
</html>
