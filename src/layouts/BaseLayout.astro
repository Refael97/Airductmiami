---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { localBusinessSchema, websiteSchema } from '../lib/schema';
import { business } from '../data/business';
import { ui, type Locale } from '../data/ui';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  noindex?: boolean;
  lang?: Locale;
  /** Path (no origin) of this same page in the other language, for hreflang + switcher. */
  altHref?: string;
}

const {
  title,
  description,
  canonical,
  schema,
  ogType = 'website',
  noindex = false,
  lang = 'en',
  altHref,
} = Astro.props;

const t = ui[lang];
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalURL = canonical
  ? `${site}${canonical}`
  : new URL(Astro.url.pathname, Astro.site).toString().replace(/\/$/, '') || site;
const ogImage = `${site}/og-image.svg`;

const currentPath = Astro.url.pathname;
const enHref = lang === 'en' ? currentPath : altHref;
const esHref = lang === 'es' ? currentPath : altHref;

const siteSchema = [localBusinessSchema(site), websiteSchema(site)];
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {enHref && <link rel="alternate" hreflang="en" href={`${site}${enHref}`} />}
    {esHref && <link rel="alternate" hreflang="es" href={`${site}${esHref}`} />}
    {enHref && <link rel="alternate" hreflang="x-default" href={`${site}${enHref}`} />}

    <meta name="generator" content={Astro.generator} />
    <meta name="geo.region" content="US-FL" />
    <meta name="geo.placename" content="Florida" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content={t.ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <JsonLd schema={siteSchema} />
    {schema && <JsonLd schema={schema} />}
  </head>
  <body>
    <a href="#main" class="visually-hidden">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header lang={lang} switchHref={altHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
