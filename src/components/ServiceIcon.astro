---
/**
 * Professional line icons for each service, drawn in the brand's thin-stroke
 * style (like the brand board). Renders inline SVG in currentColor so the
 * surrounding tile controls the color.
 */
interface Props {
  slug: string;
  size?: number;
}
const { slug, size = 26 } = Astro.props;

const icons: Record<string, string> = {
  // flowing wind lines with a curl
  'air-duct-cleaning': `
    <path d="M3 8h9a3 3 0 1 0-3-3"/>
    <path d="M3 13h13a3 3 0 1 1-3 3"/>
    <path d="M3 18h7"/>`,
  // washer/dryer drum
  'dryer-vent-cleaning': `
    <rect x="4" y="3" width="16" height="18" rx="2.5"/>
    <circle cx="12" cy="13" r="4.5"/>
    <path d="M8.5 13a3.5 3.5 0 0 0 7 0"/>
    <path d="M7 6.2h.01M10 6.2h.01"/>`,
  // fan / AC blades
  'hvac-cleaning': `
    <circle cx="12" cy="12" r="2.2"/>
    <path d="M12 9.8c0-3 -1.4-4.8 -3.4-4.8-1.7 0-2.6 1.3-2.6 2.6C6 9.6 8.6 10.6 12 9.8Z"/>
    <path d="M14.2 12c3 0 4.8-1.4 4.8-3.4 0-1.7-1.3-2.6-2.6-2.6-2 0-3 2.6-2.2 6Z"/>
    <path d="M12 14.2c0 3 1.4 4.8 3.4 4.8 1.7 0 2.6-1.3 2.6-2.6 0-2-2.6-3-6-2.2Z"/>
    <path d="M9.8 12c-3 0-4.8 1.4-4.8 3.4 0 1.7 1.3 2.6 2.6 2.6 2 0 3-2.6 2.2-6Z"/>`,
  // wrench
  'air-duct-repair': `
    <path d="M14.5 6.5a4 4 0 0 0-5.6 4.7L4 16.1a2 2 0 1 0 2.8 2.8l4.9-4.9a4 4 0 0 0 4.7-5.6l-2.7 2.7-2.3-.6-.6-2.3 2.7-2.7Z"/>`,
  // shield with spore dots
  'mold-remediation': `
    <path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3Z"/>
    <circle cx="9.5" cy="10" r="1"/>
    <circle cx="13.8" cy="8.8" r="0.8"/>
    <circle cx="12.4" cy="13.4" r="1.1"/>`,
  // sparkles
  'air-duct-sanitizing': `
    <path d="M12 4l1.5 4.2L18 9.7l-4.5 1.5L12 15.4l-1.5-4.2L6 9.7l4.5-1.5L12 4Z"/>
    <path d="M18.5 14.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2Z"/>
    <path d="M5.5 15.5l.6 1.7 1.7.6-1.7.6-.6 1.7-.6-1.7-1.7-.6 1.7-.6.6-1.7Z"/>`,
  // office buildings
  'commercial-air-duct-cleaning': `
    <path d="M3 21h18"/>
    <path d="M5 21V7l6-3v17"/>
    <path d="M13 21V11l6 2v8"/>
    <path d="M8 9.5h.01M8 13h.01M8 16.5h.01M16.5 15h.01M16.5 18h.01"/>`,
  // UV bulb with rays
  'uv-light-installation': `
    <path d="M12 3v1.6M6.3 5.6l1.1 1.1M17.7 5.6l-1.1 1.1"/>
    <path d="M12 7.5a4.5 4.5 0 0 1 2.6 8.2c-.6.4-1 1-1 1.8h-3.2c0-.8-.4-1.4-1-1.8A4.5 4.5 0 0 1 12 7.5Z"/>
    <path d="M10.5 20h3M11 22h2"/>`,
  // gauge / air quality meter
  'indoor-air-quality-testing': `
    <path d="M4.5 17a8 8 0 1 1 15 0"/>
    <path d="M12 14.8L15.5 10"/>
    <circle cx="12" cy="15.5" r="1.4"/>
    <path d="M3.5 20.5h17"/>`,
  // house with insulation layers
  'attic-insulation': `
    <path d="M3.5 11L12 4l8.5 7"/>
    <path d="M6 9.5V20h12V9.5"/>
    <path d="M8.5 13.5h7M8.5 16.5h7"/>`,
};

const paths = icons[slug] ?? icons['air-duct-cleaning'];
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths}
/>
