---
import { business } from '../data/business';
import { services } from '../data/services';
import { ui, serviceHref, type Locale } from '../data/ui';

interface Props {
  lang?: Locale;
  /** URL of the same page in the other language (for the switcher). */
  switchHref?: string;
}
const { lang = 'en', switchHref } = Astro.props;
const t = ui[lang];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === t.home ? path === t.home : path.startsWith(href);

const topServices = services.slice(0, 6);
const defaultSwitch = lang === 'es' ? '/' : '/es/';
---
<header class="site-header">
  <div class="container header-inner">
    <a href={t.home} class="brand" aria-label={business.name}>
      <span class="brand-mark" aria-hidden="true">🌬️</span>
      <span class="brand-text">{business.name}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        <li class="has-dropdown">
          <a href={t.services} class={isActive(t.services) ? 'active' : ''}>{t.nav[0].label} ▾</a>
          <ul class="dropdown">
            {topServices.map((s) => (
              <li><a href={serviceHref(lang, s.slug)}>{s.shortName}</a></li>
            ))}
            <li><a href={t.services} class="dropdown-all">{t.allServices} →</a></li>
          </ul>
        </li>
        <li><a href={t.serviceAreas} class={isActive(t.serviceAreas) ? 'active' : ''}>{t.nav[1].label}</a></li>
        <li><a href={t.blog} class={isActive(t.blog) ? 'active' : ''}>{t.nav[2].label}</a></li>
        <li><a href={t.about} class={isActive(t.about) ? 'active' : ''}>{t.nav[3].label}</a></li>
        <li><a href={t.faq} class={isActive(t.faq) ? 'active' : ''}>{t.nav[4].label}</a></li>
        <li><a href={t.contact} class={isActive(t.contact) ? 'active' : ''}>{t.nav[5].label}</a></li>
        <li class="lang-switch"><a href={switchHref ?? defaultSwitch} hreflang={lang === 'es' ? 'en' : 'es'} rel="alternate">🌐 {t.langSwitch}</a></li>
      </ul>
    </nav>

    <a href={`tel:${business.phoneHref}`} class="header-cta btn btn-primary">
      <span aria-hidden="true">📞</span> {business.phone}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--c-ink);
    text-decoration: none;
    margin-right: auto;
  }
  .brand-mark { font-size: 1.5rem; }
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    display: block;
    padding: 0.5rem 0.7rem;
    color: var(--c-body);
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 8px;
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a.active { color: var(--c-primary); background: var(--c-primary-light); }
  .lang-switch a { color: var(--c-primary); font-weight: 700; }

  .has-dropdown { position: relative; }
  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    display: block;
    flex-direction: column;
    min-width: 240px;
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    padding: 0.4rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown li { width: 100%; }
  .dropdown a { font-size: 0.9rem; }
  .dropdown-all { color: var(--c-primary); font-weight: 700; }

  .header-cta { white-space: nowrap; font-size: 0.9rem; padding: 0.6rem 1.1rem; }

  .nav-toggle, .nav-toggle-label { display: none; }

  @media (max-width: 1040px) {
    .header-cta { display: none; }
    .nav-toggle-label {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px; height: 44px;
      cursor: pointer;
      order: 3;
    }
    .nav-toggle-label span {
      display: block; height: 3px; width: 26px;
      background: var(--c-ink); border-radius: 2px;
    }
    .site-nav {
      order: 4;
      flex-basis: 100%;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }
    .nav-toggle:checked ~ .site-nav { max-height: 600px; }
    .site-nav ul { flex-direction: column; align-items: stretch; padding-bottom: 1rem; }
    .site-nav a { padding: 0.8rem 0.5rem; }
    .dropdown {
      position: static; opacity: 1; visibility: visible; transform: none;
      box-shadow: none; border: none; padding-left: 1rem; min-width: 0;
    }
  }
</style>
