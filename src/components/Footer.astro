---
import { business } from '../data/business';
import { services } from '../data/services';
import { cities } from '../data/cities';

const year = 2025; // static build — bump on redesign
const footerServices = services.slice(0, 8);
const footerCities = cities.slice(0, 12);
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand">
        <span aria-hidden="true">🌬️</span> {business.name}
      </a>
      <p>{business.tagline}</p>
      <p class="footer-contact">
        <a href={`tel:${business.phoneHref}`}>📞 {business.phone}</a><br />
        <a href={`mailto:${business.email}`}>✉️ {business.email}</a>
      </p>
      <p class="footer-badge">Licensed &amp; Insured · Serving all of Florida</p>
    </div>

    <div class="footer-col">
      <h3>Services</h3>
      <ul>
        {footerServices.map((s) => (
          <li><a href={`/services/${s.slug}`}>{s.shortName}</a></li>
        ))}
        <li><a href="/services">All services →</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Service Areas</h3>
      <ul>
        {footerCities.map((c) => (
          <li><a href={`/service-areas/${c.slug}`}>{c.name}</a></li>
        ))}
        <li><a href="/service-areas">All areas →</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Company</h3>
      <ul>
        <li><a href="/about">About Us</a></li>
        <li><a href="/blog">Blog &amp; Guides</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {year} {business.legalName}. All rights reserved. · Air duct &amp; dryer vent cleaning across Florida.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--c-bg-deep); color: #a9c2d4; margin-top: 2rem; }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-block: 3rem 2rem;
  }
  .footer-brand .brand {
    display: inline-flex; align-items: center; gap: 0.5rem;
    color: #fff; font-weight: 800; font-size: 1.2rem; text-decoration: none;
    margin-bottom: 0.6rem;
  }
  .footer-brand p { margin: 0 0 0.8rem; font-size: 0.92rem; }
  .footer-contact a { color: #cfe0ec; }
  .footer-badge {
    display: inline-block; font-size: 0.8rem; color: var(--c-accent);
    font-weight: 700; border: 1px solid rgba(20,184,166,0.4);
    padding: 0.3rem 0.7rem; border-radius: 999px;
  }
  .footer-col h3 { color: #fff; font-size: 1rem; margin-bottom: 0.8rem; }
  .footer-col ul { list-style: none; padding: 0; margin: 0; }
  .footer-col li { margin-bottom: 0.45rem; }
  .footer-col a { color: #a9c2d4; font-size: 0.9rem; text-decoration: none; }
  .footer-col a:hover { color: #fff; text-decoration: underline; }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,0.08); padding-block: 1.2rem; }
  .footer-bottom p { margin: 0; font-size: 0.82rem; color: #7c96a8; }
  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 1.6rem; }
  }
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
