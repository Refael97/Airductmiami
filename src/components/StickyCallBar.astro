---
/**
 * Mobile-only sticky call bar. 88% of clicks come from mobile, where a call
 * is the natural conversion, so the phone stays one thumb-tap away. Appears
 * after the visitor starts scrolling (300px) so it never covers the hero on
 * landing, and taps are already tracked as phone_call by the site-wide GA4
 * listener in BaseLayout.
 */
import { business } from '../data/business';
import type { Locale } from '../data/ui';

interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';

const path = Astro.url.pathname;
// Same exclusions as the popup: pages whose own goal is the form.
const excluded = ['/contact', '/es/contacto', '/thank-you', '/es/gracias', '/privacy', '/es/privacidad']
  .some((p) => path.startsWith(p));

const label = isEs ? 'Cotización gratis' : 'Call now, free quote';
---
{!excluded && (
<a href={`tel:${business.phoneHref}`} class="call-bar" id="call-bar" hidden>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M6 3h4l1.5 4.5L9 9.5c1 2.5 3 4.5 5.5 5.5l2-2.5L21 14v4a2 2 0 0 1-2 2C10.7 19.4 4.6 13.3 4 5a2 2 0 0 1 2-2Z"/>
  </svg>
  <span class="call-bar-text">{label}</span>
  <span class="call-bar-number">{business.phone}</span>
</a>
)}

<style>
  .call-bar {
    position: fixed;
    left: 0.7rem; right: 0.7rem;
    bottom: calc(0.7rem + env(safe-area-inset-bottom, 0px));
    z-index: 900;
    display: none;
    align-items: center; justify-content: center; gap: 0.55rem;
    padding: 0.9rem 1rem;
    background: var(--grad-cta);
    color: #fff; text-decoration: none;
    font-weight: 800; font-size: 1rem;
    border-radius: 14px;
    box-shadow: 0 10px 28px rgba(11, 39, 64, 0.35);
    animation: call-bar-in 0.3s ease;
  }
  .call-bar:hover { text-decoration: none; color: #fff; }
  .call-bar-number { font-weight: 800; opacity: 0.95; white-space: nowrap; }
  .call-bar-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @keyframes call-bar-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .call-bar { animation: none; }
  }

  @media (max-width: 760px) {
    .call-bar:not([hidden]) { display: flex; }
  }
  /* Small phones: the label plus number is too wide, keep the essentials. */
  @media (max-width: 380px) {
    .call-bar-text { display: none; }
  }
</style>

<script>
  const bar = document.getElementById('call-bar');
  if (bar) {
    const reveal = () => {
      if (scrollY > 300) {
        bar.hidden = false;
        removeEventListener('scroll', reveal);
      }
    };
    addEventListener('scroll', reveal, { passive: true });
    reveal();
  }
</script>
