---
import { business } from '../data/business';
import { ui, type Locale } from '../data/ui';

interface Props {
  heading?: string;
  text?: string;
  lang?: Locale;
}
const { lang = 'en', heading, text } = Astro.props;
const t = ui[lang];
const h = heading ?? t.ctaHeading;
const body = text ?? t.ctaText;
const callLabel = lang === 'es' ? `Llame al ${business.phone}` : `Call ${business.phone}`;
---
<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2>{h}</h2>
      <p>{body}</p>
    </div>
    <div class="cta-actions">
      <a href={`tel:${business.phoneHref}`} class="btn btn-accent btn-lg">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3A19.5 19.5 0 0 1 5.2 13 19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0 1 22 16.9Z"/></svg>
        {callLabel}
      </a>
      <a href={t.contact} class="btn btn-ghost-light btn-lg">{t.requestQuote}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: linear-gradient(135deg, var(--c-primary-dark), var(--c-primary));
    color: #fff;
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding-block: clamp(2rem, 5vw, 3.2rem);
  }
  .cta-inner h2 { color: #fff; margin-bottom: 0.3rem; }
  .cta-inner p { margin: 0; color: #dbeafe; max-width: 46ch; }
  .cta-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }
</style>
