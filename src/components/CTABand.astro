---
import { business } from '../data/business';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Ready for cleaner, healthier air?',
  text = 'Get a fast, no-obligation quote from Florida’s trusted air duct professionals.',
} = Astro.props;
---
<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a href={`tel:${business.phoneHref}`} class="btn btn-accent btn-lg">
        📞 Call {business.phone}
      </a>
      <a href="/contact" class="btn btn-ghost-light btn-lg">Request a Quote</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: linear-gradient(135deg, var(--c-primary-dark), var(--c-primary));
    color: #fff;
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding-block: clamp(2rem, 5vw, 3.2rem);
  }
  .cta-inner h2 { color: #fff; margin-bottom: 0.3rem; }
  .cta-inner p { margin: 0; color: #dbeafe; max-width: 46ch; }
  .cta-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }
</style>
