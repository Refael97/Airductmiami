---
import { business } from '../data/business';
import { ui, type Locale } from '../data/ui';

interface Props {
  heading?: string;
  text?: string;
  lang?: Locale;
}
const { lang = 'en', heading, text } = Astro.props;
const t = ui[lang];
const h = heading ?? t.ctaHeading;
const body = text ?? t.ctaText;
const callLabel = lang === 'es' ? `Llame al ${business.phone}` : `Call ${business.phone}`;
---
<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2>{h}</h2>
      <p>{body}</p>
    </div>
    <div class="cta-actions">
      <a href={`tel:${business.phoneHref}`} class="btn btn-accent btn-lg">📞 {callLabel}</a>
      <a href={t.contact} class="btn btn-ghost-light btn-lg">{t.requestQuote}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: linear-gradient(135deg, var(--c-primary-dark), var(--c-primary));
    color: #fff;
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding-block: clamp(2rem, 5vw, 3.2rem);
  }
  .cta-inner h2 { color: #fff; margin-bottom: 0.3rem; }
  .cta-inner p { margin: 0; color: #dbeafe; max-width: 46ch; }
  .cta-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }
</style>
