---
/**
 * Sticky call bar for campaign landing pages.
 *
 * The rest of the site runs StickyQuoteBar, which opens the popup's lead
 * form, because the business prefers form leads. Paid search is the other
 * way round: someone who typed "musty smell from ac" into Google at nine at
 * night wants to talk to a person, over 70% of the traffic is on a phone,
 * and a tap that opens the dialler converts better than anything that asks
 * them to type. So this one dials.
 *
 * It is a plain `tel:` anchor rather than a button with a handler, which
 * means BaseLayout's site-wide click listener reports `phone_call` for it
 * with no wiring here at all, and `placementOf` returns `sticky_call_bar`
 * so it can be counted separately from the header number.
 *
 * Visible from the first pixel rather than after 300px of scroll, unlike the
 * quote bar: on these pages it is the point, not an afterthought, and the
 * hero is built with room for it.
 */
import { business } from '../data/business';
import type { Locale } from '../data/ui';

interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';

const label = isEs ? 'Llame ahora' : 'Call now';
---
<a
  href={`tel:${business.phoneHref}`}
  class="call-bar"
  id="call-bar"
  aria-label={`${label} ${business.phone}`}
>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3A19.5 19.5 0 0 1 5.2 13 19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0 1 22 16.9Z"/>
  </svg>
  <span class="call-bar-text">
    <strong>{business.phone}</strong>
    <small>{isEs ? 'Toque para llamar' : 'Tap to call'}</small>
  </span>
</a>

<style>
  .call-bar {
    position: fixed;
    left: 0.7rem; right: 0.7rem;
    bottom: calc(0.7rem + env(safe-area-inset-bottom, 0px));
    z-index: 900;
    /* Hidden on desktop, where the hero buttons and the form are both in
       reach and a bar pinned across the viewport is just clutter. */
    display: none;
    align-items: center; justify-content: center; gap: 0.6rem;
    /* The brief asks for 56px. This lands at 60 and change, which clears
       Apple's 44pt and Google's 48dp minimum targets with room to spare on
       a thumb reaching from the bottom of a phone. */
    min-height: 60px;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    background: var(--grad-cta);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 10px 28px rgba(9, 41, 66, 0.34);
  }
  .call-bar-text {
    display: flex; flex-direction: column; line-height: 1.15;
  }
  .call-bar strong { font-size: 1.12rem; letter-spacing: 0.01em; }
  .call-bar small { font-size: 0.74rem; opacity: 0.86; font-weight: 600; }

  @media (max-width: 860px) {
    .call-bar { display: flex; }
    /* Nothing at the end of the page should sit under the bar. */
    :global(body) { padding-bottom: 5.2rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .call-bar { transition: transform 0.18s ease; }
    .call-bar:active { transform: scale(0.98); }
  }
</style>
